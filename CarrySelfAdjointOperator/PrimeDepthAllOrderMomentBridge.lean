/-!
# Prime-depth to all-order completed moments

This module keeps the arithmetic origin of the logarithmic clock visible all
the way to the completed moment sequence.

The prime-depth ledger is not declared to be spectral data.  Instead, it
reconstructs the ordinary logarithm inside each C3 log-jet atom.  The completed
native response is then obtained by retaining the independent archimedean
completion channel.  Consequently every canonical completed-native moment is
the corresponding odd Taylor coefficient of a response whose material
logarithmic channel is written entirely through prime-camera depths.

The arbitrary finite factors of `AllOrderLogJetLedger` remain arbitrary:
this file does not identify them with clock nodes or with zero heights, and it
does not discard the quotient remainder.
-/

open scoped BigOperators

namespace CarrySelfAdjointOperator

open CPFormal.Analytic.Cp
open Filter

noncomputable section

/-! ## The self-adjoint clock in prime-depth coordinates -/

/-- The eigenvalue of the fixed self-adjoint logarithmic clock on coordinate
`n` is exactly the sum of the prime-camera depth contributions of `n+1`.
Thus the clock generator reads the complete prime-wheel valuation ledger,
rather than an externally supplied table of spectral heights. -/
theorem nativeLogGenerator_basisVector_primeDepthLedger (n : ℕ) :
    nativeLogGenerator
        ⟨infiniteRealSpectralBasisVector n,
          nativeLogBasisVector_mem_domain n⟩ =
      (primeDepthLogLedger (n + 1) : ℂ) •
        infiniteRealSpectralBasisVector n := by
  rw [primeDepthLogLedger_eq_log (Nat.succ_ne_zero n)]
  exact nativeLogGenerator_basisVector_log n


/-- The same eigenvalue before scalar synthesis: each prime camera contributes
exactly `v_p(n+1) * log p`, and the self-adjoint clock sees their canonical
multibase synthesis. -/
theorem nativeLogGenerator_basisVector_cameraLogSynthesis (n : ℕ) :
    nativeLogGenerator
        ⟨infiniteRealSpectralBasisVector n,
          nativeLogBasisVector_mem_domain n⟩ =
      cameraComplexSynthesis (cameraLogContributionVectorComplex (n + 1)) •
        infiniteRealSpectralBasisVector n := by
  rw [cameraComplexSynthesis_cameraLogContributionVectorComplex]
  exact nativeLogGenerator_basisVector_primeDepthLedger n

/-- The unitary phase of the same clock is the exponential of the complete
prime-depth ledger. -/
theorem infiniteRealSpectralPhase_eq_primeDepthLedger
    (t : ℝ) (n : ℕ) :
    infiniteRealSpectralPhase t n =
      Complex.exp
        (-((((t * primeDepthLogLedger (n + 1) : ℝ) : ℂ) * Complex.I))) := by
  unfold infiniteRealSpectralPhase infiniteRealSpectralFrequency
  rw [primeDepthLogLedger_eq_log (Nat.succ_ne_zero n)]

/-- Consequently the native Dirichlet state evolves coordinatewise by the
phase generated by the prime-wheel depth ledger itself. -/
theorem nativeRealSpectralState_eq_primeDepthClockOrbit_zero
    (t : ℝ) (n : ℕ) :
    realSpectralState t n =
      Complex.exp
          (-((((t * primeDepthLogLedger (n + 1) : ℝ) : ℂ) * Complex.I))) *
        realSpectralState 0 n := by
  rw [nativeRealSpectralState_eq_logOrbit_zero,
    infiniteRealSpectralPhase_eq_primeDepthLedger]

/-- One C3 logarithmic bracket with every logarithm replaced by the exact
prime-camera depth ledger of the same integer. -/
def primeDepthCanonicalLogBracketBlock (m : ℕ) (s : ℂ) : ℂ :=
  (primeDepthLogLedger ((3 * m + 1) + 1) : ℂ) *
      positiveDirichletValue s (3 * m + 1) -
    2 * ((primeDepthLogLedger ((3 * m + 2) + 1) : ℂ) *
      positiveDirichletValue s (3 * m + 2)) +
    (primeDepthLogLedger ((3 * m + 3) + 1) : ℂ) *
      positiveDirichletValue s (3 * m + 3)

/-- The prime-depth spelling of one logarithmic bracket is exactly the
canonical logarithmic bracket. -/
theorem primeDepthCanonicalLogBracketBlock_eq_canonical
    (m : ℕ) (s : ℂ) :
    primeDepthCanonicalLogBracketBlock m s =
      canonicalLogBracketBlock m s := by
  unfold primeDepthCanonicalLogBracketBlock canonicalLogBracketBlock
  rw [positiveLogDirichletValue_eq_primeDepthLogLedger_mul,
    positiveLogDirichletValue_eq_primeDepthLogLedger_mul,
    positiveLogDirichletValue_eq_primeDepthLogLedger_mul]

/-- Finite C3 log-jet chart written only with prime-camera depth ledgers in
its logarithmic weights. -/
def primeDepthCanonicalLogBracketChart (M : ℕ) (s : ℂ) : ℂ :=
  ∑ m ∈ Finset.range M, primeDepthCanonicalLogBracketBlock m s

theorem primeDepthCanonicalLogBracketChart_eq_canonical
    (M : ℕ) (s : ℂ) :
    primeDepthCanonicalLogBracketChart M s =
      finiteCanonicalLogBracketChart M s := by
  unfold primeDepthCanonicalLogBracketChart finiteCanonicalLogBracketChart
  apply Finset.sum_congr rfl
  intro m hm
  exact primeDepthCanonicalLogBracketBlock_eq_canonical m s

/-- Omitted C3 log-jet tail with the same prime-depth spelling. -/
def primeDepthC3LogJetCutoffTail (M : ℕ) (s : ℂ) : ℂ :=
  ∑' k : ℕ, primeDepthCanonicalLogBracketBlock (k + M) s

theorem primeDepthC3LogJetCutoffTail_eq_canonical
    (M : ℕ) (s : ℂ) :
    primeDepthC3LogJetCutoffTail M s =
      canonicalC3LogJetCutoffTail M s := by
  unfold primeDepthC3LogJetCutoffTail canonicalC3LogJetCutoffTail
  apply tsum_congr
  intro k
  exact primeDepthCanonicalLogBracketBlock_eq_canonical (k + M) s

/-- The complete unnormalized C3 logarithmic readout, now reconstructed from
prime-depth data in both its finite head and exact tail. -/
def primeDepthCompletedC3EnrichedTfvdLogJetTailReadout (s : ℂ) : ℂ :=
  primeDepthCanonicalLogBracketChart 1 s +
    primeDepthC3LogJetCutoffTail 1 s

theorem primeDepthCompletedC3EnrichedTfvdLogJetTailReadout_eq_canonical
    (s : ℂ) :
    primeDepthCompletedC3EnrichedTfvdLogJetTailReadout s =
      canonicalCompletedC3EnrichedTfvdLogJetTailReadout s := by
  unfold primeDepthCompletedC3EnrichedTfvdLogJetTailReadout
    canonicalCompletedC3EnrichedTfvdLogJetTailReadout
  rw [primeDepthCanonicalLogBracketChart_eq_canonical,
    primeDepthC3LogJetCutoffTail_eq_canonical,
    (canonicalCompletedC3EnrichedTfvdTransport_components s).2.1]

/-- Normalized C3 logarithmic companion with its material logarithmic channel
spelled through prime depths.  The chart derivative term is retained exactly. -/
def primeDepthCompletedC3EnrichedTfvdNormalizedLogJetTailReadout
    (z : ℂ) : ℂ :=
  let s := operatorHeightParameter z
  Complex.I *
    ((primeDepthCompletedC3EnrichedTfvdLogJetTailReadout s *
          cpChartFactor 3 s +
        canonicalCompletedC3EnrichedTfvdValueTailReadout s *
          deriv (cpChartFactor 3) s) /
      cpChartFactor 3 s ^ 2)

theorem primeDepthCompletedC3EnrichedTfvdNormalizedLogJetTailReadout_eq_canonical
    (z : ℂ) :
    primeDepthCompletedC3EnrichedTfvdNormalizedLogJetTailReadout z =
      canonicalCompletedC3EnrichedTfvdNormalizedLogJetTailReadout z := by
  unfold primeDepthCompletedC3EnrichedTfvdNormalizedLogJetTailReadout
    canonicalCompletedC3EnrichedTfvdNormalizedLogJetTailReadout
  rw [primeDepthCompletedC3EnrichedTfvdLogJetTailReadout_eq_canonical]

/-- Native scalar normalized response whose logarithmic companion is generated
from the prime-depth reconstruction. -/
def primeDepthNativeHeightScalarNormalizedResponse (z : ℂ) : ℂ :=
  completedGreenNormalizedResponse
    canonicalCompletedC3EnrichedTfvdNormalizedValueTailReadout
    primeDepthCompletedC3EnrichedTfvdNormalizedLogJetTailReadout z

/-- Near the centered height, the prime-depth response is exactly the existing
native-scalar normalized response. -/
theorem primeDepthNativeHeightScalarNormalizedResponse_eventuallyEq_native :
    primeDepthNativeHeightScalarNormalizedResponse =ᶠ[nhds 0]
      nativeHeightScalarNormalizedResponse := by
  have hdomain :
      {z : ℂ | operatorHeightParameter z ∈ genuineCriticalStrip} ∈ nhds 0 :=
    (hasDerivAt_operatorHeightParameter 0).continuousAt.preimage_mem_nhds
      (isOpen_genuineCriticalStrip.mem_nhds
        zero_mem_completedNativeHeightDomain)
  filter_upwards [hdomain] with z hz
  unfold primeDepthNativeHeightScalarNormalizedResponse
    nativeHeightScalarNormalizedResponse completedGreenNormalizedResponse
  rw [primeDepthCompletedC3EnrichedTfvdNormalizedLogJetTailReadout_eq_canonical,
    canonicalCompletedC3EnrichedTfvdNormalizedValueTailReadout_eq_nativeHeightScalar
      hz,
    canonicalCompletedC3EnrichedTfvdNormalizedLogJetTailReadout_eq_nativeCompanion
      hz]

/-- Completed response with the archimedean completion kept independent and
the material logarithmic channel presented through prime-camera depths. -/
def primeDepthCompletedNativeNormalizedResponse (z : ℂ) : ℂ :=
  nativeXiCompletionNormalizedResponse z +
    primeDepthNativeHeightScalarNormalizedResponse z

/-- The prime-depth completed response is the canonical completed normalized
response as a germ at the Taylor center. -/
theorem primeDepthCompletedNativeNormalizedResponse_eventuallyEq_completed :
    primeDepthCompletedNativeNormalizedResponse =ᶠ[nhds 0]
      completedGreenNormalizedResponse
        completedNativeOperatorCharacteristic
        completedNativeOperatorBoundaryCompanion := by
  filter_upwards
    [primeDepthNativeHeightScalarNormalizedResponse_eventuallyEq_native,
      completedNativeGreenNormalizedResponse_eventuallyEq_factorResponses]
      with z hprime hcompleted
  unfold primeDepthCompletedNativeNormalizedResponse
  rw [hprime]
  exact hcompleted.symm

/-- Taylor coefficients of the prime-depth completed response. -/
def primeDepthCompletedNativeResponseTaylorCoefficient
    (order : ℕ) : ℂ :=
  iteratedDeriv order primeDepthCompletedNativeNormalizedResponse 0 /
    order.factorial

/-- At every order the prime-depth completed response has the same coefficient
as the canonical completed response. -/
theorem primeDepthCompletedNativeResponseTaylorCoefficient_eq_completed
    (order : ℕ) :
    primeDepthCompletedNativeResponseTaylorCoefficient order =
      completedNativeGreenResponseTaylorCoefficient order := by
  unfold primeDepthCompletedNativeResponseTaylorCoefficient
    completedNativeGreenResponseTaylorCoefficient
  rw [Filter.EventuallyEq.iteratedDeriv_eq order
    primeDepthCompletedNativeNormalizedResponse_eventuallyEq_completed]

/-- Main bridge: every canonical completed-native logarithmic moment is an odd
Taylor coefficient of the completed response whose material logarithmic
channel is generated by prime-camera depths. -/
theorem canonicalCompletedNativeLogDerivativeMoment_eq_primeDepthResponse
    (n : ℕ) :
    (canonicalCompletedNativeLogDerivativeMoment n : ℂ) =
      primeDepthCompletedNativeResponseTaylorCoefficient (2 * n + 1) := by
  rw [primeDepthCompletedNativeResponseTaylorCoefficient_eq_completed]
  exact (completedNativeGreenResponseTaylorCoefficient_odd_eq_canonical n).symm

/-- Composition with the existing all-order finite-factor ledger.  The factors
remain arbitrary and the quotient remainder remains explicit; the new content
is that the left side has an exact prime-depth material presentation before
completion. -/
theorem primeDepthResponseTaylorCoefficient_eq_finiteFactors_add_remainder
    {ι : Type*} (S : Finset ι) (a : ι → ℂ) (m : ℕ) :
    primeDepthCompletedNativeResponseTaylorCoefficient (2 * m + 1) =
      (∑ i ∈ S, a i ^ (m + 1)) -
        iteratedDeriv m
          (logDeriv (fun u => completedNativeEvenCharacteristic u /
            ∏ i ∈ S, (1 - a i * u))) 0 / m.factorial := by
  rw [primeDepthCompletedNativeResponseTaylorCoefficient_eq_completed,
    completedNativeGreenResponseTaylorCoefficient_odd_eq_canonical]
  exact AllOrderLogJet.nativeMoment_eq_finiteFactors_add_remainder S a m


/-- The corrected causal/chiral boundary target is, at every raw boundary
order, the next Taylor coefficient of the prime-depth completed response.
This identifies the target side of the material-clock gate without assuming
that a material clock realizes it. -/
theorem canonicalCompletedNativeCorrectedChiralBoundaryCoefficient_eq_primeDepthResponse
    (M p : ℕ) :
    canonicalCompletedNativeCorrectedChiralBoundaryCoefficient M p =
      primeDepthCompletedNativeResponseTaylorCoefficient (p + 1) := by
  rw [canonicalCompletedNativeCorrectedChiralBoundaryCoefficient_eq_response,
    canonicalCompletedC3FullWronskianChiralResponseTaylorCoefficient_eq_completed]
  exact
    (primeDepthCompletedNativeResponseTaylorCoefficient_eq_completed
      (p + 1)).symm


/-- The enriched material clock itself, read through the lossless six-source
TFVD observation, produces exactly the prime-depth completed response jet at
every order.  No raw seeded-clock Gram, Hankel matrix, Jacobi operator, or
spectral-height table occurs in this identification. -/
theorem nativeC3SeededClockTfvdSixSourceJetCoefficient_eq_primeDepthResponse
    (M p : ℕ) (q : ℝ) (hqpos : 0 < q) (hq1 : q < 1)
    (S : Finset NativeGpreBoundaryContext) :
    nativeC3SeededClockTfvdSixSourceJetCoefficient M p q hqpos.le hq1 S =
      primeDepthCompletedNativeResponseTaylorCoefficient (p + 1) := by
  calc
    nativeC3SeededClockTfvdSixSourceJetCoefficient M p q hqpos.le hq1 S =
        canonicalCompletedNativeCorrectedChiralBoundaryCoefficient M p :=
      (canonicalCompletedNativeCorrectedChiralBoundaryCoefficient_eq_seededClockTfvdSixSourceJet
        M p q hqpos hq1 S).symm
    _ = primeDepthCompletedNativeResponseTaylorCoefficient (p + 1) :=
      canonicalCompletedNativeCorrectedChiralBoundaryCoefficient_eq_primeDepthResponse
        M p

/-- All canonical completed-native moments are already present as the even
boundary indices of the enriched material clock jet.  This generalizes the
previous low-order audits at indices zero and two to every order. -/
theorem nativeC3SeededClockTfvdSixSourceJet_even_eq_canonicalMoment
    (M n : ℕ) (q : ℝ) (hqpos : 0 < q) (hq1 : q < 1)
    (S : Finset NativeGpreBoundaryContext) :
    nativeC3SeededClockTfvdSixSourceJetCoefficient
        M (2 * n) q hqpos.le hq1 S =
      (canonicalCompletedNativeLogDerivativeMoment n : ℂ) := by
  calc
    nativeC3SeededClockTfvdSixSourceJetCoefficient
        M (2 * n) q hqpos.le hq1 S =
        canonicalCompletedNativeCorrectedChiralBoundaryCoefficient M (2 * n) :=
      (canonicalCompletedNativeCorrectedChiralBoundaryCoefficient_eq_seededClockTfvdSixSourceJet
        M (2 * n) q hqpos hq1 S).symm
    _ = (canonicalCompletedNativeLogDerivativeMoment n : ℂ) :=
      canonicalCompletedNativeCorrectedChiralBoundaryCoefficient_odd_eq_canonicalMoment
        M n


/-! ## The full two-index material clock tower -/

/-- Promote the enriched six-source material jet from the first column to the
whole two-index clock tower by total degree.  This is the natural extension
forced by the Green diagonal shift: entry `(p,r)` is the material jet of
index `p+r`. -/
def nativeC3SeededClockTfvdSixSourceTowerCoefficient
    (M : ℕ) (q : ℝ) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (S : Finset NativeGpreBoundaryContext)
    (p r : ℕ) : ℂ :=
  nativeC3SeededClockTfvdSixSourceJetCoefficient M (p + r) q hq0 hq1 S

/-- Every entry of the enriched material six-source tower is exactly the
canonical corrected native clock tower entry on the same bidegree.  Thus the
material observation supplies not only the first column but the complete
division-free coefficient array. -/
theorem nativeC3SeededClockTfvdSixSourceTowerCoefficient_eq_correctedTower
    (M : ℕ) (q : ℝ) (hqpos : 0 < q) (hq1 : q < 1)
    (S : Finset NativeGpreBoundaryContext) (p r : ℕ) :
    nativeC3SeededClockTfvdSixSourceTowerCoefficient
        M q hqpos.le hq1 S p r =
      canonicalCompletedNativeCorrectedClockTowerCoefficient p r := by
  unfold nativeC3SeededClockTfvdSixSourceTowerCoefficient
  calc
    nativeC3SeededClockTfvdSixSourceJetCoefficient
        M (p + r) q hqpos.le hq1 S =
        canonicalCompletedNativeCorrectedChiralBoundaryCoefficient M (p + r) :=
      (canonicalCompletedNativeCorrectedChiralBoundaryCoefficient_eq_seededClockTfvdSixSourceJet
        M (p + r) q hqpos hq1 S).symm
    _ = canonicalCompletedNativeCorrectedClockTowerCoefficient p r :=
      (canonicalCompletedNativeCorrectedClockTowerCoefficient_eq_correctedChiralBoundaryCoefficient
        M p r).symm

/-- The enriched material six-source tower satisfies the complete polarized
Green coefficient equation in all two-index orders. -/
theorem nativeC3SeededClockTfvdSixSourceTower_coefficientEquation
    (M : ℕ) (q : ℝ) (hqpos : 0 < q) (hq1 : q < 1)
    (S : Finset NativeGpreBoundaryContext) :
    IsPolarizedGreenCoefficientEquation
      canonicalCompletedNativeLogDerivativeMoment
      (nativeC3SeededClockTfvdSixSourceTowerCoefficient
        M q hqpos.le hq1 S) := by
  have hfun :
      nativeC3SeededClockTfvdSixSourceTowerCoefficient
          M q hqpos.le hq1 S =
        canonicalCompletedNativeCorrectedClockTowerCoefficient := by
    funext p r
    exact nativeC3SeededClockTfvdSixSourceTowerCoefficient_eq_correctedTower
      M q hqpos hq1 S p r
  rw [hfun]
  exact canonicalCompletedNativeCorrectedClockTower_coefficientEquation

/-- The material six-source tower obeys the exact diagonal clock shift before
any Gram, Hankel, or Jacobi construction. -/
theorem nativeC3SeededClockTfvdSixSourceTower_shift
    (M : ℕ) (q : ℝ) (hqpos : 0 < q) (hq1 : q < 1)
    (S : Finset NativeGpreBoundaryContext) (p r : ℕ) :
    nativeC3SeededClockTfvdSixSourceTowerCoefficient
        M q hqpos.le hq1 S p (r + 1) =
      nativeC3SeededClockTfvdSixSourceTowerCoefficient
        M q hqpos.le hq1 S (p + 1) r := by
  exact polarizedGreenCoefficient_transport
    (nativeC3SeededClockTfvdSixSourceTower_coefficientEquation
      M q hqpos hq1 S) p r

/-- Package the lossless enriched material observation itself as the canonical
corrected native clock tower.  Uniqueness of corrected towers then applies
without passing through the raw positive seeded-clock Gram. -/
def nativeC3SeededClockTfvdSixSourceCorrectedClockTower
    (M : ℕ) (q : ℝ) (hqpos : 0 < q) (hq1 : q < 1)
    (S : Finset NativeGpreBoundaryContext) :
    CorrectedNativeClockTower M where
  coefficient :=
    nativeC3SeededClockTfvdSixSourceTowerCoefficient M q hqpos.le hq1 S
  coefficientEquation :=
    nativeC3SeededClockTfvdSixSourceTower_coefficientEquation
      M q hqpos hq1 S
  boundaryTransport := by
    intro p
    unfold nativeC3SeededClockTfvdSixSourceTowerCoefficient
    simpa using
      (canonicalCompletedNativeCorrectedChiralBoundaryCoefficient_eq_seededClockTfvdSixSourceJet
        M p q hqpos hq1 S).symm

/-- Full two-index wheel/prime-depth crosswalk: the material six-source clock
entry at `(p,r)` is the coefficient of total Taylor order `p+r+1` of the
completed response whose logarithmic material channel is reconstructed from
prime-camera depths. -/
theorem nativeC3SeededClockTfvdSixSourceTowerCoefficient_eq_primeDepthResponse
    (M : ℕ) (q : ℝ) (hqpos : 0 < q) (hq1 : q < 1)
    (S : Finset NativeGpreBoundaryContext) (p r : ℕ) :
    nativeC3SeededClockTfvdSixSourceTowerCoefficient
        M q hqpos.le hq1 S p r =
      primeDepthCompletedNativeResponseTaylorCoefficient (p + r + 1) := by
  unfold nativeC3SeededClockTfvdSixSourceTowerCoefficient
  exact nativeC3SeededClockTfvdSixSourceJetCoefficient_eq_primeDepthResponse
    M (p + r) q hqpos hq1 S

/-- Exact reformulation of the still-open finite material-clock calibration:
its first column must equal the all-order response generated by the prime-depth
ledger, after the independent completion channel has been retained. -/
theorem hasCorrectedNativeSeededClockBoundaryTransport_iff_primeDepthResponse
    {ι : Type*} [Fintype ι]
    (M : ℕ) (block : ι → C3TraceDynamics.SeededClockBlock) :
    HasCorrectedNativeSeededClockBoundaryTransport M block ↔
      ∀ p : ℕ,
        seededClockAtlasCoefficient block p 0 =
          primeDepthCompletedNativeResponseTaylorCoefficient (p + 1) := by
  constructor
  · intro htransport p
    calc
      seededClockAtlasCoefficient block p 0 =
          canonicalCompletedNativeCorrectedChiralBoundaryCoefficient M p :=
        htransport p
      _ = primeDepthCompletedNativeResponseTaylorCoefficient (p + 1) :=
        canonicalCompletedNativeCorrectedChiralBoundaryCoefficient_eq_primeDepthResponse
          M p
  · intro hprime p
    calc
      seededClockAtlasCoefficient block p 0 =
          primeDepthCompletedNativeResponseTaylorCoefficient (p + 1) :=
        hprime p
      _ = canonicalCompletedNativeCorrectedChiralBoundaryCoefficient M p :=
        (canonicalCompletedNativeCorrectedChiralBoundaryCoefficient_eq_primeDepthResponse
          M p).symm


/-- Same statement in the original same-edge Green vocabulary: the sole
Wronskian-to-clock calibration is exactly equality of the clock first column
with the all-order completed response generated from prime-camera depths. -/
theorem hasSameEdgeGreenToClockBoundaryTransport_iff_primeDepthResponse
    {ι : Type*} [Fintype ι]
    (M : ℕ) (block : ι → C3TraceDynamics.SeededClockBlock) :
    HasSameEdgeGreenToClockBoundaryTransport M block ↔
      ∀ p : ℕ,
        seededClockAtlasCoefficient block p 0 =
          primeDepthCompletedNativeResponseTaylorCoefficient (p + 1) := by
  exact
    (hasCorrectedNativeChiralBoundaryTransport_iff_sameEdgeGreenToClockBoundaryTransport
      M block).symm.trans
      (hasCorrectedNativeSeededClockBoundaryTransport_iff_primeDepthResponse
        M block)

/-- Under the canonical strict Stieltjes positivity certificate, a fixed
finite same-edge seeded-clock atlas cannot satisfy the all-order Green clock
boundary transport.  The obstruction is therefore to the finite material
carrier, not to the causal/Wronskian target. -/
theorem no_finite_sameEdgeGreenToClockBoundaryTransport_of_stieltjesPositivity
    {ι : Type*} [Fintype ι]
    (M cutoff : ℕ) (block : ι → C3TraceDynamics.SeededClockBlock)
    (hpos : CanonicalCompletedNativeStieltjesPositivity) :
    ¬ HasSameEdgeGreenToClockBoundaryTransport M block := by
  intro hsame
  have hcorrected :
      HasCorrectedNativeSeededClockBoundaryTransport M block :=
    (hasCorrectedNativeChiralBoundaryTransport_iff_sameEdgeGreenToClockBoundaryTransport
      M block).2 hsame
  exact canonicalC2Geometry_seededClockAtlas_noGo_of_stieltjesPositivity
    M cutoff block hcorrected hpos

/-- A fixed finite seeded-clock atlas cannot realize the prime-depth completed
response at all orders once the canonical Stieltjes positivity certificate is
available.  Thus any exact wheel-clock realization compatible with that
positive carrier must escape the fixed finite-atomic model (for example by an
infinite carrier or a growing-cutoff limit). -/
theorem no_finite_seededClock_primeDepthResponse_of_stieltjesPositivity
    {ι : Type*} [Fintype ι]
    (M cutoff : ℕ) (block : ι → C3TraceDynamics.SeededClockBlock)
    (hpos : CanonicalCompletedNativeStieltjesPositivity) :
    ¬ (∀ p : ℕ,
      seededClockAtlasCoefficient block p 0 =
        primeDepthCompletedNativeResponseTaylorCoefficient (p + 1)) := by
  intro hprime
  have htransport :
      HasCorrectedNativeSeededClockBoundaryTransport M block :=
    (hasCorrectedNativeSeededClockBoundaryTransport_iff_primeDepthResponse
      M block).2 hprime
  exact canonicalC2Geometry_seededClockAtlas_noGo_of_stieltjesPositivity
    M cutoff block htransport hpos

end

end CarrySelfAdjointOperator
