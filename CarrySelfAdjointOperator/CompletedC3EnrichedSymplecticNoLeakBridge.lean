/-- Scalar part of the enriched all-cutoff ledger.  The structural triple,
tail, xi weight, and archimedean channel remain orthogonal coordinates. -/
abbrev CanonicalCompletedC3AllCutoffScalarLedgerHilbert :=
  WithLp 2
    (CanonicalC3MixedStructuralChannelHilbert ×
      WithLp 2 (ℂ × WithLp 2 (ℂ × ℂ)))

/-- Fixed global carrier for the complete mixed C3 kernel ledger.  Every
finite C3 port is first promoted to the same Naimark space. -/
abbrev CanonicalCompletedC3AllCutoffKernelLedgerHilbert :=
  WithLp 2
    (RealifiedNaimarkComplexification ×
      WithLp 2
        (RealifiedNaimarkComplexification ×
          WithLp 2
            (RealifiedNaimarkComplexification ×
              CanonicalCompletedC3AllCutoffScalarLedgerHilbert)))

namespace CanonicalCompletedC3AllCutoffKernelLedgerHilbert

def direct
    (state : CanonicalCompletedC3AllCutoffKernelLedgerHilbert) :
    RealifiedNaimarkComplexification :=
  state.fst

def reflected
    (state : CanonicalCompletedC3AllCutoffKernelLedgerHilbert) :
    RealifiedNaimarkComplexification :=
  state.snd.fst

def quarterTurnReflected
    (state : CanonicalCompletedC3AllCutoffKernelLedgerHilbert) :
    RealifiedNaimarkComplexification :=
  state.snd.snd.fst

def structural
    (state : CanonicalCompletedC3AllCutoffKernelLedgerHilbert) :
    CanonicalC3MixedStructuralChannelHilbert :=
  state.snd.snd.snd.fst

def tail
    (state : CanonicalCompletedC3AllCutoffKernelLedgerHilbert) : ℂ :=
  state.snd.snd.snd.snd.fst

def xiWeight
    (state : CanonicalCompletedC3AllCutoffKernelLedgerHilbert) : ℂ :=
  state.snd.snd.snd.snd.snd.fst

def archimedeanChart
    (state : CanonicalCompletedC3AllCutoffKernelLedgerHilbert) : ℂ :=
  state.snd.snd.snd.snd.snd.snd

/-- Both real Naimark quadratures are combined only at this readout. -/
def radialComplexReadout
    (state : CanonicalCompletedC3AllCutoffKernelLedgerHilbert) : ℂ :=
  (realifiedGreenSkew state.direct state.reflected : ℂ) -
    Complex.I *
      (realifiedGreenSkew state.direct state.quarterTurnReflected : ℂ)

/-- Raw C3 readout with radial, structural, and exact tail channels retained
until the last addition. -/
def rawReadout
    (state : CanonicalCompletedC3AllCutoffKernelLedgerHilbert) : ℂ :=
  state.radialComplexReadout +
    canonicalC3MixedStructuralScalarReadout state.structural + state.tail

/-- Completed readout after the xi and archimedean channels are restored. -/
def finalReadout
    (state : CanonicalCompletedC3AllCutoffKernelLedgerHilbert) : ℂ :=
  state.xiWeight * state.rawReadout + state.archimedeanChart

/-- Forget only the ambient vectors after their lossless complex Green readout
has been taken.  The result has exactly the six fields of the existing mixed
ledger. -/
def mixedChannels
    (state : CanonicalCompletedC3AllCutoffKernelLedgerHilbert) :
    CanonicalCompletedC3FNegFPrimeMixedChannels where
  radialGreen := state.xiWeight * state.radialComplexReadout
  greenProvenance := state.xiWeight * state.structural.fst
  offDiagonal := state.xiWeight * state.structural.snd.fst
  readoutResidual := state.xiWeight * state.structural.snd.snd
  tailCompletion := state.xiWeight * state.tail
  archimedeanChart := state.archimedeanChart

/-- The enriched readout and the six-channel scalar readout agree, but only
after all orthogonal coordinates have been retained. -/
theorem finalReadout_eq_mixedChannels_finalReadout
    (state : CanonicalCompletedC3AllCutoffKernelLedgerHilbert) :
    state.finalReadout = state.mixedChannels.finalReadout := by
  unfold finalReadout rawReadout mixedChannels
    CanonicalCompletedC3FNegFPrimeMixedChannels.finalReadout
    canonicalC3MixedStructuralScalarReadout
  ring

/-- Pythagorean audit of the fixed ambient carrier.  In particular, no
coordinate can disappear by cancellation with another coordinate before the
final scalar readout. -/
theorem norm_sq_eq_channel_sum
    (state : CanonicalCompletedC3AllCutoffKernelLedgerHilbert) :
    ‖state‖ ^ 2 =
      ‖state.direct‖ ^ 2 +
      ‖state.reflected‖ ^ 2 +
      ‖state.quarterTurnReflected‖ ^ 2 +
      ‖state.structural‖ ^ 2 +
      ‖state.tail‖ ^ 2 +
      ‖state.xiWeight‖ ^ 2 +
      ‖state.archimedeanChart‖ ^ 2 := by
  rw [WithLp.prod_norm_sq_eq_of_L2 state,
    WithLp.prod_norm_sq_eq_of_L2 state.snd,
    WithLp.prod_norm_sq_eq_of_L2 state.snd.snd,
    WithLp.prod_norm_sq_eq_of_L2 state.snd.snd.snd,
    WithLp.prod_norm_sq_eq_of_L2 state.snd.snd.snd.snd,
    WithLp.prod_norm_sq_eq_of_L2 state.snd.snd.snd.snd.snd]
  unfold direct reflected quarterTurnReflected structural tail xiWeight
    archimedeanChart
  ring

end CanonicalCompletedC3AllCutoffKernelLedgerHilbert

/-- Canonical enriched state at cutoff `M`.  The state is a kernel ledger at
the pair `(z,w)`; no scalar channel has yet been discarded. -/
def canonicalCompletedC3AllCutoffKernelLedgerState
    (M : ℕ) (z w : ℂ) :
    CanonicalCompletedC3AllCutoffKernelLedgerHilbert :=
  let sZ := operatorHeightParameter z
  let sW := operatorHeightParameter w
  let directPort :=
    finiteC3GenuineBracketGreenBoundaryPair (3 * M) sW
  let reflectedPort :=
    finiteC3GenuineBracketGreenBoundaryPair (3 * M)
      (reflectedParameter sZ)
  WithLp.toLp 2
    (finiteC3SymplecticNaimarkRealization (3 * M) directPort,
      WithLp.toLp 2
        (finiteC3SymplecticNaimarkRealization (3 * M) reflectedPort,
          WithLp.toLp 2
            (finiteC3SymplecticNaimarkRealization (3 * M)
                (Complex.I • reflectedPort),
              WithLp.toLp 2
                (canonicalC3FiniteMixedHeightStructuralChannelState M sZ sW,
                  WithLp.toLp 2
                    (canonicalC3MixedHeightTailCompletionDefect M z w,
                      WithLp.toLp 2
                        (mixedHermitianWeight nativeXiCompletionFactor z w,
                          canonicalCompletedC3ArchimedeanChartMixedChannel
                            z w))))))

