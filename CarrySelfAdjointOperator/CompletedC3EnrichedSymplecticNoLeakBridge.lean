import CarrySelfAdjointOperator.CompletedC3BracketTfvdGreenFactorization
import CarrySelfAdjointOperator.CompletedC3MixedChannelNoCancellation
import Mathlib.Analysis.InnerProductSpace.ProdL2

/-!
# Enriched all-cutoff symplectic C3 ledger

The all-cutoff symplectic realization and the orthogonal structural ledger are
combined here in one fixed ambient carrier.  The carrier retains three global
Naimark vectors (direct, reflected, and quarter-turned reflected), the three
structural channels, the exact head--tail correction, the xi weight, and the
archimedean/chart channel.

Its type is independent of the cutoff.  The final scalar readout is applied
only after all coordinates have been retained.  At every cutoff it is exactly
the chart-weighted completed Wronskian of `(F,-F')`; no structural channel is
assumed to vanish.
-/

open scoped ComplexConjugate RealInnerProductSpace

namespace CarrySelfAdjointOperator

open CPFormal.Analytic.Cp
open NativeCarryC3Crosswalk
open NativeCarrySpectralWeyl.Boundary
open NativeCarrySpectralWeyl.Camera
open NativeCarrySpectralWeyl.Infinite
open Filter

noncomputable section

/-! ## One-point all-cutoff carrier -/

/-- Four scalar coordinates of one cutoff state: value head, log-jet head,
value tail, and log-jet tail. -/
abbrev CanonicalCompletedC3AllCutoffOnePointTraceHilbert :=
  WithLp 2 (ℂ × WithLp 2 (ℂ × WithLp 2 (ℂ × ℂ)))

/-- Fixed Hilbert carrier for one spectral point.  Besides the four separated
trace coordinates it stores the direct, reflected, and quarter-turned C3 ports
in the permanent Naimark space. -/
abbrev CanonicalCompletedC3AllCutoffOnePointHilbert :=
  WithLp 2
    (RealifiedNaimarkComplexification ×
      WithLp 2
        (RealifiedNaimarkComplexification ×
          WithLp 2
            (RealifiedNaimarkComplexification ×
              CanonicalCompletedC3AllCutoffOnePointTraceHilbert)))

namespace CanonicalCompletedC3AllCutoffOnePointHilbert

def direct (state : CanonicalCompletedC3AllCutoffOnePointHilbert) :
    RealifiedNaimarkComplexification :=
  state.fst

def reflected (state : CanonicalCompletedC3AllCutoffOnePointHilbert) :
    RealifiedNaimarkComplexification :=
  state.snd.fst

def quarterTurnReflected
    (state : CanonicalCompletedC3AllCutoffOnePointHilbert) :
    RealifiedNaimarkComplexification :=
  state.snd.snd.fst

def valueHead (state : CanonicalCompletedC3AllCutoffOnePointHilbert) : ℂ :=
  state.snd.snd.snd.fst

def logJetHead (state : CanonicalCompletedC3AllCutoffOnePointHilbert) : ℂ :=
  state.snd.snd.snd.snd.fst

def valueTail (state : CanonicalCompletedC3AllCutoffOnePointHilbert) : ℂ :=
  state.snd.snd.snd.snd.snd.fst

def logJetTail (state : CanonicalCompletedC3AllCutoffOnePointHilbert) : ℂ :=
  state.snd.snd.snd.snd.snd.snd

/-- Exact completed raw value, formed only after head and tail have both been
retained. -/
def completedValue
    (state : CanonicalCompletedC3AllCutoffOnePointHilbert) : ℂ :=
  state.valueHead + state.valueTail

/-- Height-rotated completed companion.  Rotation occurs after the head and
tail log-jet channels have been joined. -/
def completedCompanion
    (state : CanonicalCompletedC3AllCutoffOnePointHilbert) : ℂ :=
  Complex.I * (state.logJetHead + state.logJetTail)

/-- Complex Green readout of two one-point states.  The direct port is taken
from `w`; the reflected and quarter-turned ports are taken from `z`. -/
def pairRadialComplexReadout
    (stateZ stateW : CanonicalCompletedC3AllCutoffOnePointHilbert) : ℂ :=
  (realifiedGreenSkew stateW.direct stateZ.reflected : ℂ) -
    Complex.I *
      (realifiedGreenSkew stateW.direct stateZ.quarterTurnReflected : ℂ)

/-- Wronskian of the two finite heads before completion tails are added. -/
def pairHeadWronskianReadout
    (stateZ stateW : CanonicalCompletedC3AllCutoffOnePointHilbert) : ℂ :=
  mixedScalarBoundaryWedge
    stateZ.valueHead (Complex.I * stateZ.logJetHead)
    stateW.valueHead (Complex.I * stateW.logJetHead)

/-- Explicit bilinear correction generated by the four retained tails. -/
def pairTailCompletionReadout
    (stateZ stateW : CanonicalCompletedC3AllCutoffOnePointHilbert) : ℂ :=
  mixedBoundaryCompletionCorrection
    stateZ.valueHead (Complex.I * stateZ.logJetHead)
    stateW.valueHead (Complex.I * stateW.logJetHead)
    stateZ.valueTail (Complex.I * stateZ.logJetTail)
    stateW.valueTail (Complex.I * stateW.logJetTail)

/-- Wronskian formed from the completed projections of two one-point states. -/
def pairCompletedWronskianReadout
    (stateZ stateW : CanonicalCompletedC3AllCutoffOnePointHilbert) : ℂ :=
  mixedScalarBoundaryWedge
    stateZ.completedValue stateZ.completedCompanion
    stateW.completedValue stateW.completedCompanion

/-- Head plus tail is an exact state-level identity, before any canonical
specialization or limit. -/
theorem pairCompletedWronskianReadout_eq_head_add_tail
    (stateZ stateW : CanonicalCompletedC3AllCutoffOnePointHilbert) :
    pairCompletedWronskianReadout stateZ stateW =
      pairHeadWronskianReadout stateZ stateW +
        pairTailCompletionReadout stateZ stateW := by
  unfold pairCompletedWronskianReadout pairHeadWronskianReadout
    pairTailCompletionReadout completedValue completedCompanion
  rw [mul_add, mul_add]
  exact mixedScalarBoundaryWedge_add_tails _ _ _ _ _ _ _ _

end CanonicalCompletedC3AllCutoffOnePointHilbert

/-- Canonical one-point state at cutoff `M`, promoted to one permanent Hilbert
space. -/
def canonicalCompletedC3AllCutoffOnePointState
    (M : ℕ) (z : ℂ) : CanonicalCompletedC3AllCutoffOnePointHilbert :=
  let s := operatorHeightParameter z
  let directPort := finiteC3GenuineBracketGreenBoundaryPair (3 * M) s
  let reflectedPort :=
    finiteC3GenuineBracketGreenBoundaryPair (3 * M) (reflectedParameter s)
  WithLp.toLp 2
    (finiteC3SymplecticNaimarkRealization (3 * M) directPort,
      WithLp.toLp 2
        (finiteC3SymplecticNaimarkRealization (3 * M) reflectedPort,
          WithLp.toLp 2
            (finiteC3SymplecticNaimarkRealization (3 * M)
                (Complex.I • reflectedPort),
              WithLp.toLp 2
                (finiteBracketedDirichletChart 3 M s,
                  WithLp.toLp 2
                    (finiteCanonicalLogBracketChart M s,
                      WithLp.toLp 2
                        (realCpBracketCutoffTail 3 M s,
                          canonicalC3LogJetCutoffTail M s))))))

/-- The value projection of the one-point state is the exact completed raw
value for every cutoff. -/
theorem canonicalCompletedC3AllCutoffOnePointState_completedValue_eq
    (M : ℕ) {z : ℂ}
    (hz : operatorHeightParameter z ∈ genuineCriticalStrip) :
    (canonicalCompletedC3AllCutoffOnePointState M z).completedValue =
      canonicalCompletedC3RawHeightValue z := by
  unfold CanonicalCompletedC3AllCutoffOnePointHilbert.completedValue
    CanonicalCompletedC3AllCutoffOnePointHilbert.valueHead
    CanonicalCompletedC3AllCutoffOnePointHilbert.valueTail
    canonicalCompletedC3AllCutoffOnePointState
  dsimp only
  change
    finiteBracketedDirichletChart 3 M (operatorHeightParameter z) +
        realCpBracketCutoffTail 3 M (operatorHeightParameter z) =
      canonicalCompletedC3RawHeightValue z
  rw [canonicalCompletedC3RawHeightValue_eq_bracketedDirichletChart hz,
    bracketedDirichletChart_eq_finite_add_cutoffTail 3 M (by norm_num)
      (by linarith [hz.1])]

/-- The log-jet projection of the same state is the exact completed raw
companion for every cutoff. -/
theorem canonicalCompletedC3AllCutoffOnePointState_completedCompanion_eq
    (M : ℕ) {z : ℂ}
    (hz : operatorHeightParameter z ∈ genuineCriticalStrip) :
    (canonicalCompletedC3AllCutoffOnePointState M z).completedCompanion =
      canonicalCompletedC3RawHeightCompanion z := by
  unfold CanonicalCompletedC3AllCutoffOnePointHilbert.completedCompanion
    CanonicalCompletedC3AllCutoffOnePointHilbert.logJetHead
    CanonicalCompletedC3AllCutoffOnePointHilbert.logJetTail
    canonicalCompletedC3AllCutoffOnePointState
  dsimp only
  change
    Complex.I *
        (finiteCanonicalLogBracketChart M (operatorHeightParameter z) +
          canonicalC3LogJetCutoffTail M (operatorHeightParameter z)) =
      canonicalCompletedC3RawHeightCompanion z
  rw [canonicalCompletedC3RawHeightCompanion_eq_head_add_tail M hz]
  ring

/-- The Green projection of two canonical one-point states is the existing
lossless Naimark readout. -/
theorem canonicalCompletedC3AllCutoffOnePointState_pairRadialReadout
    (M : ℕ) (z w : ℂ) :
    CanonicalCompletedC3AllCutoffOnePointHilbert.pairRadialComplexReadout
        (canonicalCompletedC3AllCutoffOnePointState M z)
        (canonicalCompletedC3AllCutoffOnePointState M w) =
      canonicalC3FiniteMixedSymplecticNaimarkGreenReadout M
        (operatorHeightParameter z) (operatorHeightParameter w) := by
  unfold CanonicalCompletedC3AllCutoffOnePointHilbert.pairRadialComplexReadout
    CanonicalCompletedC3AllCutoffOnePointHilbert.direct
    CanonicalCompletedC3AllCutoffOnePointHilbert.reflected
    CanonicalCompletedC3AllCutoffOnePointHilbert.quarterTurnReflected
    canonicalCompletedC3AllCutoffOnePointState
    canonicalC3FiniteMixedSymplecticNaimarkGreenReadout
    canonicalC3FiniteMixedSymplecticNaimarkQuadratures
    FiniteC3SymplecticGreenQuadratures.complexReadout
  rfl

/-- Thus the same two one-point states read exactly as the finite complex Green
form in their Naimark coordinates. -/
theorem canonicalCompletedC3AllCutoffOnePointState_pairRadialReadout_eq_green
    (M : ℕ) (z w : ℂ) :
    CanonicalCompletedC3AllCutoffOnePointHilbert.pairRadialComplexReadout
        (canonicalCompletedC3AllCutoffOnePointState M z)
        (canonicalCompletedC3AllCutoffOnePointState M w) =
      greenForm (𝕜 := ℂ)
        (finiteC3GenuineBracketGreenBoundaryPair (3 * M)
          (operatorHeightParameter w))
        (finiteC3GenuineBracketGreenBoundaryPair (3 * M)
          (reflectedParameter (operatorHeightParameter z))) := by
  rw [canonicalCompletedC3AllCutoffOnePointState_pairRadialReadout,
    canonicalC3FiniteMixedSymplecticNaimarkGreenReadout_eq_greenForm]

/-- The head projection of the same states is the existing finite mixed height
Wronskian. -/
theorem canonicalCompletedC3AllCutoffOnePointState_pairHeadReadout_eq
    (M : ℕ) (z w : ℂ) :
    CanonicalCompletedC3AllCutoffOnePointHilbert.pairHeadWronskianReadout
        (canonicalCompletedC3AllCutoffOnePointState M z)
        (canonicalCompletedC3AllCutoffOnePointState M w) =
      canonicalC3FiniteMixedHeightHeadWronskian M z w := by
  rfl

/-- The tail projection of the same states is the independently defined exact
head--tail correction. -/
theorem canonicalCompletedC3AllCutoffOnePointState_pairTailReadout_eq
    (M : ℕ) (z w : ℂ) :
    CanonicalCompletedC3AllCutoffOnePointHilbert.pairTailCompletionReadout
        (canonicalCompletedC3AllCutoffOnePointState M z)
        (canonicalCompletedC3AllCutoffOnePointState M w) =
      canonicalC3MixedHeightTailCompletionDefect M z w := by
  rfl

/-- The completed trace projection of two one-point states is exactly the raw
completed Wronskian. -/
theorem canonicalCompletedC3AllCutoffOnePointState_pairCompletedReadout_eq
    (M : ℕ) {z w : ℂ}
    (hz : operatorHeightParameter z ∈ genuineCriticalStrip)
    (hw : operatorHeightParameter w ∈ genuineCriticalStrip) :
    CanonicalCompletedC3AllCutoffOnePointHilbert.pairCompletedWronskianReadout
        (canonicalCompletedC3AllCutoffOnePointState M z)
        (canonicalCompletedC3AllCutoffOnePointState M w) =
      canonicalCompletedC3RawHeightMixedWronskian z w := by
  unfold CanonicalCompletedC3AllCutoffOnePointHilbert.pairCompletedWronskianReadout
  rw [canonicalCompletedC3AllCutoffOnePointState_completedValue_eq M hz,
    canonicalCompletedC3AllCutoffOnePointState_completedCompanion_eq M hz,
    canonicalCompletedC3AllCutoffOnePointState_completedValue_eq M hw,
    canonicalCompletedC3AllCutoffOnePointState_completedCompanion_eq M hw]
  rfl

/-- Exact head--tail reconstruction makes the completed two-state Wronskian
readout independent of the chosen cutoff. -/
theorem canonicalCompletedC3AllCutoffOnePointState_pairCompletedReadout_cutoff_independent
    (M N : ℕ) {z w : ℂ}
    (hz : operatorHeightParameter z ∈ genuineCriticalStrip)
    (hw : operatorHeightParameter w ∈ genuineCriticalStrip) :
    CanonicalCompletedC3AllCutoffOnePointHilbert.pairCompletedWronskianReadout
        (canonicalCompletedC3AllCutoffOnePointState M z)
        (canonicalCompletedC3AllCutoffOnePointState M w) =
      CanonicalCompletedC3AllCutoffOnePointHilbert.pairCompletedWronskianReadout
        (canonicalCompletedC3AllCutoffOnePointState N z)
        (canonicalCompletedC3AllCutoffOnePointState N w) := by
  rw [canonicalCompletedC3AllCutoffOnePointState_pairCompletedReadout_eq M hz hw,
    canonicalCompletedC3AllCutoffOnePointState_pairCompletedReadout_eq N hz hw]

/-- Honest same-state sewing: the completed Wronskian projection equals the
Green projection plus the three explicit structural channels and the exact
tail projection. -/
theorem canonicalCompletedC3AllCutoffOnePointState_completed_eq_green_add_channels
    (M : ℕ) {z w : ℂ}
    (hz : operatorHeightParameter z ∈ genuineCriticalStrip)
    (hw : operatorHeightParameter w ∈ genuineCriticalStrip) :
    CanonicalCompletedC3AllCutoffOnePointHilbert.pairCompletedWronskianReadout
        (canonicalCompletedC3AllCutoffOnePointState M z)
        (canonicalCompletedC3AllCutoffOnePointState M w) =
      CanonicalCompletedC3AllCutoffOnePointHilbert.pairRadialComplexReadout
          (canonicalCompletedC3AllCutoffOnePointState M z)
          (canonicalCompletedC3AllCutoffOnePointState M w) +
        canonicalC3FiniteMixedHeightStructuralDefect M
          (operatorHeightParameter z) (operatorHeightParameter w) +
        CanonicalCompletedC3AllCutoffOnePointHilbert.pairTailCompletionReadout
          (canonicalCompletedC3AllCutoffOnePointState M z)
          (canonicalCompletedC3AllCutoffOnePointState M w) := by
  rw [canonicalCompletedC3AllCutoffOnePointState_pairCompletedReadout_eq M hz hw,
    canonicalCompletedC3AllCutoffOnePointState_pairRadialReadout_eq_green,
    canonicalCompletedC3AllCutoffOnePointState_pairTailReadout_eq]
  exact canonicalCompletedC3RawHeightMixedWronskian_eq_green_add_channels
    M hz hw

/-! ## Structural channels generated by the all-cutoff Hilbert prefixes -/

/-- Fixed source carrier for a mixed kernel.  It retains the ordinary/log-jet
prefixes at `z`, at `w`, and at the reflected parameter of `z`. -/
abbrev CanonicalC3AllCutoffMixedSourceHilbert :=
  WithLp 2
    (CanonicalCompletedC3HilbertState ×
      WithLp 2
        (CanonicalCompletedC3HilbertState ×
          CanonicalCompletedC3HilbertState))

namespace CanonicalC3AllCutoffMixedSourceHilbert

def zSource (state : CanonicalC3AllCutoffMixedSourceHilbert) :
    CanonicalCompletedC3HilbertState :=
  state.fst

def wSource (state : CanonicalC3AllCutoffMixedSourceHilbert) :
    CanonicalCompletedC3HilbertState :=
  state.snd.fst

def reflectedZSource (state : CanonicalC3AllCutoffMixedSourceHilbert) :
    CanonicalCompletedC3HilbertState :=
  state.snd.snd

/-- The two consecutive ordinary and log-jet legs in every retained C3 block,
read directly from the global Hilbert prefixes. -/
def mixedLegs
    (M : ℕ) (state : CanonicalC3AllCutoffMixedSourceHilbert) :
    ReflectedBoundarySynthesisData (Fin M × Fin 2) where
  left := fun mr =>
    Fin.cases (state.wSource.1 (3 * (mr.1 : ℕ)))
      (fun _ => state.wSource.1 (3 * (mr.1 : ℕ) + 1)) mr.2
  right := fun mr =>
    Fin.cases (state.wSource.1 (3 * (mr.1 : ℕ) + 1))
      (fun _ => state.wSource.1 (3 * (mr.1 : ℕ) + 2)) mr.2
  jetLeft := fun mr =>
    Fin.cases (state.zSource.2 (3 * (mr.1 : ℕ)))
      (fun _ => state.zSource.2 (3 * (mr.1 : ℕ) + 1)) mr.2
  jetRight := fun mr =>
    Fin.cases (state.zSource.2 (3 * (mr.1 : ℕ) + 1))
      (fun _ => state.zSource.2 (3 * (mr.1 : ℕ) + 2)) mr.2

/-- Finite value head as a readout of the ordinary Hilbert coordinate. -/
def valueHeadReadout
    (M : ℕ) (state : CanonicalCompletedC3HilbertState) : ℂ :=
  1 + ∑ m ∈ Finset.range M,
    (state.1 (3 * m + 2) - state.1 (3 * m + 1))

/-- Finite log-jet head as a readout of the log-jet Hilbert coordinate. -/
def logJetHeadReadout
    (M : ℕ) (state : CanonicalCompletedC3HilbertState) : ℂ :=
  ∑ m ∈ Finset.range M,
    (state.2 (3 * m + 2) - state.2 (3 * m + 1))

/-- Genuine Green port reconstructed from the ordinary coordinate of an
arbitrary state in the fixed all-cutoff carrier. -/
def greenPort
    (N : ℕ) (s : ℂ) (state : CanonicalCompletedC3HilbertState) :
    FiniteC3GreenPortCarrier N :=
  (WithLp.toLp 2 (fun n : Fin N =>
      (((3 : ℝ) ^ (-criticalDisplacement s.re) : ℝ) : ℂ) *
        state.1 (n : ℕ)),
    WithLp.toLp 2 (fun n : Fin N => state.1 (n : ℕ)))

/-- Local TFVD boundary minus the Green form, computed solely from the three
Hilbert source coordinates.  This is the uncollapsed Green provenance. -/
def greenProvenanceReadout
    (M : ℕ) (directParameter reflectedParameter : ℂ)
    (state : CanonicalC3AllCutoffMixedSourceHilbert) : ℂ :=
  let legs := state.mixedLegs M
  (∑ mr : Fin M × Fin 2,
      sameSEdgeBoundaryWedge
        (legs.left mr) (legs.right mr)
        (legs.jetLeft mr) (legs.jetRight mr)) -
    greenForm (𝕜 := ℂ)
      (greenPort (3 * M) directParameter state.wSource)
      (greenPort (3 * M) reflectedParameter state.reflectedZSource)

/-- Ordered cross-coordinate readout generated by the same local legs. -/
def offDiagonalReadout
    (M : ℕ) (state : CanonicalC3AllCutoffMixedSourceHilbert) : ℂ :=
  let legs := state.mixedLegs M
  twoLegBoundaryCrossProvenance
    legs.left legs.right legs.jetLeft legs.jetRight

/-- Height-rotated scalar synthesis residual.  Rotation is applied only at
this final readout, after the ordinary and log-jet channels remain separate. -/
def heightResidualReadout
    (M : ℕ) (state : CanonicalC3AllCutoffMixedSourceHilbert) : ℂ :=
  mixedBoundaryResidualCorrection
    (valueHeadReadout M state.zSource)
    (Complex.I * logJetHeadReadout M state.zSource)
    (valueHeadReadout M state.wSource)
    (Complex.I * logJetHeadReadout M state.wSource)
    (state.mixedLegs M)

/-- Orthogonal structural readout generated from the all-cutoff Hilbert
source, before the three scalar coordinates are added. -/
def structuralReadout
    (M : ℕ) (directParameter reflectedParameter : ℂ)
    (state : CanonicalC3AllCutoffMixedSourceHilbert) :
    CanonicalC3MixedStructuralChannelHilbert :=
  WithLp.toLp 2
    (greenProvenanceReadout M directParameter reflectedParameter state,
      WithLp.toLp 2
        (offDiagonalReadout M state, heightResidualReadout M state))

/-- Pythagorean audit of the three point sources before any mixed scalar
readout is applied. -/
theorem norm_sq_eq_source_sum
    (state : CanonicalC3AllCutoffMixedSourceHilbert) :
    ‖state‖ ^ 2 =
      ‖state.zSource‖ ^ 2 +
        ‖state.wSource‖ ^ 2 + ‖state.reflectedZSource‖ ^ 2 := by
  rw [WithLp.prod_norm_sq_eq_of_L2 state,
    WithLp.prod_norm_sq_eq_of_L2 state.snd]
  unfold zSource wSource reflectedZSource
  ring

end CanonicalC3AllCutoffMixedSourceHilbert

/-- The canonical mixed source consists only of three prefixes of the already
constructed all-cutoff ordinary/log-jet Hilbert state. -/
def canonicalC3AllCutoffMixedSourcePrefixState
    (M : ℕ) (z w : ℂ) : CanonicalC3AllCutoffMixedSourceHilbert :=
  WithLp.toLp 2
    (canonicalCompletedC3HilbertPrefixState z (3 * M),
      WithLp.toLp 2
        (canonicalCompletedC3HilbertPrefixState w (3 * M),
          canonicalCompletedC3HilbertPrefixState
            (reflectedParameter z) (3 * M)))

@[simp] theorem canonicalC3AllCutoffMixedSourcePrefixState_zSource
    (M : ℕ) (z w : ℂ) :
    (canonicalC3AllCutoffMixedSourcePrefixState M z w).zSource =
      canonicalCompletedC3HilbertPrefixState z (3 * M) := by
  rfl

@[simp] theorem canonicalC3AllCutoffMixedSourcePrefixState_wSource
    (M : ℕ) (z w : ℂ) :
    (canonicalC3AllCutoffMixedSourcePrefixState M z w).wSource =
      canonicalCompletedC3HilbertPrefixState w (3 * M) := by
  rfl

@[simp] theorem canonicalC3AllCutoffMixedSourcePrefixState_reflectedZSource
    (M : ℕ) (z w : ℂ) :
    (canonicalC3AllCutoffMixedSourcePrefixState M z w).reflectedZSource =
      canonicalCompletedC3HilbertPrefixState
        (reflectedParameter z) (3 * M) := by
  rfl

/-- Completed three-source state in the same fixed carrier. -/
def canonicalC3AllCutoffMixedSourceState
    (z w : ℂ) (hz : 0 < z.re) (hw : 0 < w.re)
    (hzReflected : 0 < (reflectedParameter z).re) :
    CanonicalC3AllCutoffMixedSourceHilbert :=
  WithLp.toLp 2
    (canonicalCompletedC3HilbertState z hz,
      WithLp.toLp 2
        (canonicalCompletedC3HilbertState w hw,
          canonicalCompletedC3HilbertState
            (reflectedParameter z) hzReflected))

/-- All three canonical source prefixes converge jointly in the fixed Hilbert
carrier.  This theorem concerns the carrier itself, not yet the cutoff-varying
structural readout. -/
theorem canonicalC3AllCutoffMixedSourcePrefixState_tendsto
    {z w : ℂ} (hz : 0 < z.re) (hw : 0 < w.re)
    (hzReflected : 0 < (reflectedParameter z).re) :
    Tendsto
        (fun M : ℕ => canonicalC3AllCutoffMixedSourcePrefixState M z w)
        atTop
        (nhds
          (canonicalC3AllCutoffMixedSourceState
            z w hz hw hzReflected)) := by
  have hzLimit :=
    (canonicalCompletedC3HilbertPrefixState_tendsto hz).comp
      tendsto_three_mul_atTop
  have hwLimit :=
    (canonicalCompletedC3HilbertPrefixState_tendsto hw).comp
      tendsto_three_mul_atTop
  have hreflectedLimit :=
    (canonicalCompletedC3HilbertPrefixState_tendsto hzReflected).comp
      tendsto_three_mul_atTop
  have hinner := hwLimit.prodMk_nhds hreflectedLimit
  have hinnerLp :=
    (WithLp.prod_continuous_toLp 2 _ _).continuousAt.tendsto.comp hinner
  have houter := hzLimit.prodMk_nhds hinnerLp
  have houterLp :=
    (WithLp.prod_continuous_toLp 2 _ _).continuousAt.tendsto.comp houter
  unfold canonicalC3AllCutoffMixedSourcePrefixState
    canonicalC3AllCutoffMixedSourceState
  convert houterLp using 1
  funext M
  rfl

theorem canonicalC3AllCutoffMixedValueEdges_eq
    (z w : ℂ) (m : ℕ) :
    enrichedAngularTfvdDecode tfvdHaarScale 1
        ((canonicalMixedBoundaryResidualPair tfvdHaarScale
          (fun _ : ℕ => (1 : ℂ)) z w).value.blocks m) =
      { first := positiveDirichletGradient w (3 * m)
        second := positiveDirichletGradient w (3 * m + 1)
        dormant := positiveDirichletGradient w (3 * m + 2) } := by
  simpa [canonicalMixedBoundaryResidualPair, canonicalBoundaryResidualPair,
    canonicalEnrichedTfvdValueLogJetPair,
    canonicalSeededEnrichedTfvdGenuinePort,
    canonicalEnrichedAngularTfvdCoordinate] using
    (enrichedAngularTfvdDecode_encode m tfvdHaarScale_ne_zero
      (by norm_num : (1 : ℂ) ≠ 0)
      (positiveDirichletGradient w (3 * m))
      (positiveDirichletGradient w (3 * m + 1))
      (positiveDirichletGradient w (3 * m + 2)))

theorem canonicalC3AllCutoffMixedLogJetEdges_eq
    (z w : ℂ) (m : ℕ) :
    enrichedAngularTfvdDecode tfvdHaarScale 1
        ((canonicalMixedBoundaryResidualPair tfvdHaarScale
          (fun _ : ℕ => (1 : ℂ)) z w).logJet.blocks m) =
      { first := positiveLogDirichletGradient z (3 * m)
        second := positiveLogDirichletGradient z (3 * m + 1)
        dormant := positiveLogDirichletGradient z (3 * m + 2) } := by
  simpa [canonicalMixedBoundaryResidualPair, canonicalBoundaryResidualPair,
    canonicalEnrichedTfvdValueLogJetPair,
    canonicalSeededEnrichedTfvdLogJetPort,
    canonicalEnrichedLogJetTfvdCoordinate] using
    (enrichedAngularTfvdDecode_encode m tfvdHaarScale_ne_zero
      (by norm_num : (1 : ℂ) ≠ 0)
      (positiveLogDirichletGradient z (3 * m))
      (positiveLogDirichletGradient z (3 * m + 1))
      (positiveLogDirichletGradient z (3 * m + 2)))

/-- The TFVD mixed legs are literally the evaluations of the three Hilbert
prefixes; no extra pair-dependent source data is introduced. -/
theorem canonicalC3AllCutoffMixedSourcePrefixState_mixedLegs_eq
    (M : ℕ) (z w : ℂ) :
    (canonicalC3AllCutoffMixedSourcePrefixState M z w).mixedLegs M =
      canonicalMixedBoundaryResidualLegs M tfvdHaarScale
        (fun _ : ℕ => (1 : ℂ)) z w := by
  unfold CanonicalC3AllCutoffMixedSourceHilbert.mixedLegs
    CanonicalC3AllCutoffMixedSourceHilbert.zSource
    CanonicalC3AllCutoffMixedSourceHilbert.wSource
    canonicalC3AllCutoffMixedSourcePrefixState
    canonicalMixedBoundaryResidualLegs
  dsimp only
  congr 1 <;> funext mr
  all_goals
    rcases mr with ⟨m, r⟩
    have hm : (m : ℕ) < M := m.isLt
    have hblock : 3 * ((m : ℕ) + 1) ≤ 3 * M :=
      Nat.mul_le_mul_left 3 (Nat.succ_le_iff.mpr hm)
    have h0 : 3 * (m : ℕ) < 3 * M := by omega
    have h1 : 3 * (m : ℕ) + 1 < 3 * M := by omega
    have h2 : 3 * (m : ℕ) + 2 < 3 * M := by omega
    simp [canonicalCompletedC3HilbertPrefixState,
      canonicalCompletedC3DirichletGradientPrefixState_apply,
      canonicalCompletedC3LogJetPrefixState_apply,
      enrichedTfvdBoundaryEdgeLeft, enrichedTfvdBoundaryEdgeRight,
      enrichedTfvdBoundaryEdgeJetLeft, enrichedTfvdBoundaryEdgeJetRight,
      canonicalC3AllCutoffMixedValueEdges_eq,
