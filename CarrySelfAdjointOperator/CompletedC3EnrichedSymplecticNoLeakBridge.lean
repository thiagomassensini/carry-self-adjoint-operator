/-- Final exact identification: the enriched all-cutoff Hilbert ledger reads
as the completed Wronskian of `(F,-F')` at every cutoff. -/
theorem canonicalCompletedC3AllCutoffKernelLedgerState_finalReadout_eq_completedWronskian
    (M : ℕ) {z w : ℂ}
    (hz : operatorHeightParameter z ∈ genuineCriticalStrip)
    (hw : operatorHeightParameter w ∈ genuineCriticalStrip) :
    (canonicalCompletedC3AllCutoffKernelLedgerState M z w).finalReadout =
      mixedHermitianWeight canonicalC3ChartFactorHeight z w *
        completedGreenWronskian
          completedNativeOperatorCharacteristic
          (fun u : ℂ => -deriv completedNativeOperatorCharacteristic u)
          z w := by
  rw [CanonicalCompletedC3AllCutoffKernelLedgerHilbert.finalReadout,
    canonicalCompletedC3AllCutoffKernelLedgerState_xiWeight,
    canonicalCompletedC3AllCutoffKernelLedgerState_rawReadout_eq_wronskian
      M hz hw,
    canonicalCompletedC3AllCutoffKernelLedgerState_archimedeanChart]
  exact (completedFNegFPrimeWronskian_crossedChartIdentity hz hw).symm

/-- Exact head--tail completion makes the final readout independent of the
cutoff, even though all unsynthesized coordinates remain cutoff-dependent. -/
theorem canonicalCompletedC3AllCutoffKernelLedgerState_finalReadout_cutoff_independent
    (M N : ℕ) {z w : ℂ}
    (hz : operatorHeightParameter z ∈ genuineCriticalStrip)
    (hw : operatorHeightParameter w ∈ genuineCriticalStrip) :
    (canonicalCompletedC3AllCutoffKernelLedgerState M z w).finalReadout =
      (canonicalCompletedC3AllCutoffKernelLedgerState N z w).finalReadout := by
  rw [canonicalCompletedC3AllCutoffKernelLedgerState_finalReadout_eq_completedWronskian
      M hz hw,
    canonicalCompletedC3AllCutoffKernelLedgerState_finalReadout_eq_completedWronskian
      N hz hw]

end

end CarrySelfAdjointOperator
