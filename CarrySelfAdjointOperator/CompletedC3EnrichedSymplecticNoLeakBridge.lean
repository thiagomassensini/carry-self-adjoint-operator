theorem canonicalC3AllCutoffMixedSourcePrefixState_greenProvenanceReadout_eq
    (M : ℕ) (z w : ℂ) :
    CanonicalC3AllCutoffMixedSourceHilbert.greenProvenanceReadout
        M w (reflectedParameter z)
        (canonicalC3AllCutoffMixedSourcePrefixState M z w) =
      canonicalC3FiniteMixedHeightGreenProvenanceChannel M z w := by
  unfold CanonicalC3AllCutoffMixedSourceHilbert.greenProvenanceReadout
    canonicalC3FiniteMixedHeightGreenProvenanceChannel
    canonicalMixedBoundaryGreenProvenance
  dsimp only
  rw [canonicalC3AllCutoffMixedSourcePrefixState_mixedLegs_eq,
    canonicalC3AllCutoffMixedSourcePrefixState_wSource,
    canonicalC3AllCutoffMixedSourcePrefixState_reflectedZSource,
    canonicalC3AllCutoffGreenPort_prefix_eq,
    canonicalC3AllCutoffGreenPort_prefix_eq]
  let pair := canonicalMixedBoundaryResidualPair
    tfvdHaarScale (fun _ : ℕ => (1 : ℂ)) z w
  let reflectedPair := canonicalBoundaryResidualPair
    tfvdHaarScale (fun _ : ℕ => (1 : ℂ)) (reflectedParameter z)
  let direct := finiteC3EnrichedTfvdPairTransport
    M tfvdHaarScale (fun _ : ℕ => (1 : ℂ)) w pair
  let reflected := finiteC3EnrichedTfvdPairTransport
    M tfvdHaarScale (fun _ : ℕ => (1 : ℂ))
      (reflectedParameter z) reflectedPair
  have hlocal :
      (∑ mr : Fin M × Fin 2,
        sameSEdgeBoundaryWedge
          ((canonicalMixedBoundaryResidualLegs M tfvdHaarScale
            (fun _ : ℕ => (1 : ℂ)) z w).left mr)
          ((canonicalMixedBoundaryResidualLegs M tfvdHaarScale
            (fun _ : ℕ => (1 : ℂ)) z w).right mr)
          ((canonicalMixedBoundaryResidualLegs M tfvdHaarScale
            (fun _ : ℕ => (1 : ℂ)) z w).jetLeft mr)
          ((canonicalMixedBoundaryResidualLegs M tfvdHaarScale
            (fun _ : ℕ => (1 : ℂ)) z w).jetRight mr)) =
        finiteC3EnrichedTfvdPairBoundaryForm M direct := by
    simpa [pair, direct, canonicalMixedBoundaryResidualLegs] using
      (sum_enrichedTfvdBoundaryEdges_eq_pairBoundaryForm
        M tfvdHaarScale (fun _ : ℕ => (1 : ℂ)) w pair)
  have htransport :=
    finiteC3EnrichedTfvdPairBoundary_eq_greenForm_add_provenance_twoParameter
      M tfvdHaarScale (fun _ : ℕ => (1 : ℂ))
      w (reflectedParameter z) pair reflectedPair
  dsimp only at htransport
  have hdirectPort :
      direct.greenPort = finiteC3GenuineBracketGreenBoundaryPair (M * 3) w := by
    simpa [direct, pair, canonicalMixedBoundaryResidualPair,
      canonicalBoundaryResidualPair, canonicalEnrichedTfvdValueLogJetPair,
      finiteC3EnrichedTfvdPairTransport] using
      (finiteC3EnrichedTfvdValueGreenPort_canonical
        M tfvdHaarScale_ne_zero (fun _ : ℕ => (1 : ℂ))
          (by intro m; norm_num) w)
  have hreflectedPort :
      reflected.greenPort =
        finiteC3GenuineBracketGreenBoundaryPair
          (M * 3) (reflectedParameter z) := by
    simpa [reflected, reflectedPair, canonicalBoundaryResidualPair,
      canonicalEnrichedTfvdValueLogJetPair,
      finiteC3EnrichedTfvdPairTransport] using
      (finiteC3EnrichedTfvdValueGreenPort_canonical
        M tfvdHaarScale_ne_zero (fun _ : ℕ => (1 : ℂ))
          (by intro m; norm_num) (reflectedParameter z))
  rw [hlocal, Nat.mul_comm 3 M]
  rw [← hdirectPort, ← hreflectedPort]
  change finiteC3EnrichedTfvdPairBoundaryForm M direct -
      greenForm direct.greenPort reflected.greenPort =
    finiteC3EnrichedTfvdPairGreenProvenance
      M tfvdHaarScale (fun _ : ℕ => (1 : ℂ)) pair direct reflected
  linear_combination htransport

