import CarrySelfAdjointOperator.CompletedC3AllCutoffHilbertState
import NativeCarryC3Crosswalk.C3TwoVariableGreenGamma

/-!
# Completion of the raw two-variable C3 Green--gamma identity

The finite raw C3 gamma kernel is the Hilbert inner product of the ordinary
gradient prefixes. Consequently it converges to the Gram kernel of the
all-cutoff completed states. The exact raw C3 Green factorization therefore
passes to the limit.

The spectral coefficient in this file remains the raw camera eigenvalue
`3^(-s)`. No identification with the centered completed spectral parameter
is asserted.
-/

open scoped Topology BigOperators lp ENNReal NNReal ComplexConjugate

namespace CarrySelfAdjointOperator

open CPFormal.Analytic.Cp
open Filter

noncomputable section

theorem c3RawGammaGram_eq_inner_completedPrefix
    (M : ℕ) (r s : ℂ) :
    NativeCarryC3Crosswalk.c3RawGammaGram M r s =
      inner ℂ
        (canonicalCompletedC3DirichletGradientPrefixState r M)
        (canonicalCompletedC3DirichletGradientPrefixState s M) := by
  rw [lp.inner_eq_tsum]
  rw [tsum_eq_sum (s := Finset.range M)]
  · unfold NativeCarryC3Crosswalk.c3RawGammaGram
    apply Finset.sum_congr rfl
    intro n hn
    simp only [canonicalCompletedC3DirichletGradientPrefixState_apply,
      Finset.mem_range.mp hn, ↓reduceIte]
    simp [RCLike.inner_apply, mul_comm]
  · intro n hn
    have hnlt : ¬n < M := by simpa using hn
    simp [canonicalCompletedC3DirichletGradientPrefixState_apply, hnlt]

/-- Positive completed Gram kernel generated by the all-cutoff ordinary
Dirichlet-gradient states. -/
def canonicalCompletedC3RawGammaGram
    (r s : ℂ) (hr : 0 < r.re) (hs : 0 < s.re) : ℂ :=
  inner ℂ
    (canonicalCompletedC3DirichletGradientState r hr)
    (canonicalCompletedC3DirichletGradientState s hs)

theorem canonicalCompletedC3RawGammaGram_self
    (s : ℂ) (hs : 0 < s.re) :
    canonicalCompletedC3RawGammaGram s s hs hs =
      ((‖canonicalCompletedC3DirichletGradientState s hs‖ : ℝ) : ℂ) ^ 2 := by
  simp [canonicalCompletedC3RawGammaGram, inner_self_eq_norm_sq_to_K]

theorem canonicalCompletedC3RawGammaGram_self_re_nonneg
    (s : ℂ) (hs : 0 < s.re) :
    0 ≤ (canonicalCompletedC3RawGammaGram s s hs hs).re := by
  rw [canonicalCompletedC3RawGammaGram_self]
  rw [← Complex.ofReal_pow]
  exact sq_nonneg ‖canonicalCompletedC3DirichletGradientState s hs‖

theorem c3RawGammaGram_tendsto_completed
    {r s : ℂ} (hr : 0 < r.re) (hs : 0 < s.re) :
    Tendsto
      (fun M : ℕ => NativeCarryC3Crosswalk.c3RawGammaGram M r s)
      atTop
      (nhds (canonicalCompletedC3RawGammaGram r s hr hs)) := by
  have hinner :=
    Filter.Tendsto.inner (𝕜 := ℂ)
      (canonicalCompletedC3DirichletGradientPrefixState_tendsto hr)
      (canonicalCompletedC3DirichletGradientPrefixState_tendsto hs)
  exact hinner.congr' (Eventually.of_forall fun M =>
    (c3RawGammaGram_eq_inner_completedPrefix M r s).symm)

/-- The finite raw C3 Green identity extends to the completed ordinary
gradient state. The coefficient is deliberately still the raw C3 camera
eigenvalue difference. -/
theorem c3RawGreenPairing_tendsto_completed
    {r s : ℂ} (hr : 0 < r.re) (hs : 0 < s.re) :
    Tendsto
      (fun M : ℕ => NativeCarryC3Crosswalk.c3RawGreenPairing M r s)
      atTop
      (nhds
        ((NativeCarryC3Crosswalk.c3RawCameraEigenvalue s -
            (starRingEnd ℂ)
              (NativeCarryC3Crosswalk.c3RawCameraEigenvalue r)) *
          canonicalCompletedC3RawGammaGram r s hr hs)) := by
  let coefficient :=
    NativeCarryC3Crosswalk.c3RawCameraEigenvalue s -
      (starRingEnd ℂ) (NativeCarryC3Crosswalk.c3RawCameraEigenvalue r)
  have hlimit := (c3RawGammaGram_tendsto_completed hr hs).const_mul coefficient
  exact hlimit.congr' (Eventually.of_forall fun M => by
    simpa [coefficient] using
      (NativeCarryC3Crosswalk.c3RawGreenPairing_eq_eigenvalueDifference_mul_gammaGram
        M r s).symm)

end

end CarrySelfAdjointOperator
