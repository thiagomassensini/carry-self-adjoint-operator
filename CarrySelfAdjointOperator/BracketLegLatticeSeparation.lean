import NativeCarryC3Crosswalk.GeometricCutoffCompleteness

/-!
# Exact separation of bracket centers and legs

Every aligned center is a multiple of the exact camera slope.  Every emitted
radius is positive and strictly smaller than that slope.  Consequently neither
leg of an emitted bracket belongs to the center lattice of the same camera.

For natural cameras the slope is the camera label itself.  The exceptional C2
chart has label two but aligned-center slope four; a separate theorem records
the stronger elementary fact that its two legs are odd.
-/

namespace CarrySelfAdjointOperator

open FiniteNativeCarryOperator.Camera
open NativeCarrySpectralWeyl.Camera
open NativeCarryC3Crosswalk

/-- Every aligned center lies on the exact lattice generated by the camera
slope. -/
theorem cameraSlope_dvd_alignedCenter (camera index : ℕ) :
    cameraSlope camera ∣ alignedCenter camera index := by
  rw [alignedCenter_eq_cameraSlope_mul]
  exact ⟨index + 1, rfl⟩

/-- A radius emitted by a supported camera is positive and strictly smaller
than the exact distance between consecutive aligned centers. -/
theorem emittedRadius_pos_and_lt_cameraSlope
    {camera radius : ℕ} (hcamera : 2 ≤ camera)
    (hradius : radius ∈ radiusSet camera) :
    0 < radius ∧ radius < cameraSlope camera := by
  rw [mem_radiusSet_iff] at hradius
  exact ⟨by omega,
    lt_of_le_of_lt hradius.2 (halfRange_lt_cameraSlope hcamera)⟩

/-- No emitted positive radius is itself a multiple of the camera slope. -/
theorem cameraSlope_not_dvd_emittedRadius
    {camera radius : ℕ} (hcamera : 2 ≤ camera)
    (hradius : radius ∈ radiusSet camera) :
    ¬cameraSlope camera ∣ radius := by
  exact Nat.not_dvd_of_pos_of_lt
    (emittedRadius_pos_and_lt_cameraSlope hcamera hradius).1
    (emittedRadius_pos_and_lt_cameraSlope hcamera hradius).2

/-- The left leg of every emitted bracket lies off the aligned-center lattice
of its camera. -/
theorem cameraSlope_not_dvd_leftBracketLeg
    {camera index radius : ℕ} (hcamera : 2 ≤ camera)
    (hradius : radius ∈ radiusSet camera) :
    ¬cameraSlope camera ∣ alignedCenter camera index - radius := by
  intro hleft
  apply cameraSlope_not_dvd_emittedRadius hcamera hradius
  have hradiusLt :=
    (emittedRadius_pos_and_lt_cameraSlope hcamera hradius).2
  have hslopeLeCenter :
      cameraSlope camera ≤ cameraSlope camera * (index + 1) :=
    Nat.le_mul_of_pos_right _ (by omega)
  have hradiusLeCenter : radius ≤ alignedCenter camera index := by
    rw [alignedCenter_eq_cameraSlope_mul]
    omega
  have hcenter := cameraSlope_dvd_alignedCenter camera index
  rw [← Nat.sub_add_cancel hradiusLeCenter] at hcenter
  have hsum :
      cameraSlope camera ∣
        radius + (alignedCenter camera index - radius) := by
    simpa [Nat.add_comm] using hcenter
  exact (Nat.dvd_add_iff_left hleft).mpr hsum

/-- The right leg of every emitted bracket lies off the aligned-center lattice
of its camera. -/
theorem cameraSlope_not_dvd_rightBracketLeg
    {camera index radius : ℕ} (hcamera : 2 ≤ camera)
    (hradius : radius ∈ radiusSet camera) :
    ¬cameraSlope camera ∣ alignedCenter camera index + radius := by
  intro hright
  apply cameraSlope_not_dvd_emittedRadius hcamera hradius
  have hcenter := cameraSlope_dvd_alignedCenter camera index
  have hsum :
      cameraSlope camera ∣ radius + alignedCenter camera index := by
    simpa [Nat.add_comm] using hright
  exact (Nat.dvd_add_iff_left hcenter).mpr hsum

/-- Uniform center/leg lattice separation for every supported camera and every
emitted radius. -/
theorem bracketLegs_off_centerLattice
    {camera index radius : ℕ} (hcamera : 2 ≤ camera)
    (hradius : radius ∈ radiusSet camera) :
    (¬cameraSlope camera ∣ alignedCenter camera index - radius) ∧
      (¬cameraSlope camera ∣ alignedCenter camera index + radius) := by
  exact ⟨cameraSlope_not_dvd_leftBracketLeg hcamera hradius,
    cameraSlope_not_dvd_rightBracketLeg hcamera hradius⟩

/-- The core separation statement: the bracket center is on the camera
lattice and both of its legs are off that same lattice. -/
theorem bracketCenter_on_lattice_and_legs_off_lattice
    {camera index radius : ℕ} (hcamera : 2 ≤ camera)
    (hradius : radius ∈ radiusSet camera) :
    cameraSlope camera ∣ alignedCenter camera index ∧
      (¬cameraSlope camera ∣ alignedCenter camera index - radius) ∧
        (¬cameraSlope camera ∣ alignedCenter camera index + radius) := by
  exact ⟨cameraSlope_dvd_alignedCenter camera index,
    bracketLegs_off_centerLattice hcamera hradius⟩

/-- Therefore neither leg can alias any aligned center of the same camera,
not merely the center of its own bracket. -/
theorem bracketLegs_ne_any_alignedCenter
    {camera index radius otherIndex : ℕ} (hcamera : 2 ≤ camera)
    (hradius : radius ∈ radiusSet camera) :
    alignedCenter camera index - radius ≠ alignedCenter camera otherIndex ∧
      alignedCenter camera index + radius ≠ alignedCenter camera otherIndex := by
  constructor
  · intro h
    apply cameraSlope_not_dvd_leftBracketLeg hcamera hradius
    rw [h]
    exact cameraSlope_dvd_alignedCenter camera otherIndex
  · intro h
    apply cameraSlope_not_dvd_rightBracketLeg hcamera hradius
    rw [h]
    exact cameraSlope_dvd_alignedCenter camera otherIndex

/-! ## Exact residue classes -/

/-- The left leg has the exact block-plus-residue decomposition
`d * index + (d - radius)`, where `d` is the camera slope. -/
theorem leftBracketLeg_eq_cameraBlock_add_residue
    {camera index radius : ℕ} (hcamera : 2 ≤ camera)
    (hradius : radius ∈ radiusSet camera) :
    alignedCenter camera index - radius =
      cameraSlope camera * index + (cameraSlope camera - radius) := by
  have hradiusLt :=
    (emittedRadius_pos_and_lt_cameraSlope hcamera hradius).2
  rw [alignedCenter_eq_cameraSlope_mul]
  rw [show index + 1 = Nat.succ index by omega, Nat.mul_succ]
  exact Nat.add_sub_assoc (by omega) _

/-- Every aligned center has residue zero modulo the camera slope. -/
theorem alignedCenter_mod_cameraSlope (camera index : ℕ) :
    alignedCenter camera index % cameraSlope camera = 0 := by
  rw [alignedCenter_eq_cameraSlope_mul]
  exact Nat.mul_mod_right _ _

/-- The right bracket leg has residue exactly `radius` modulo the camera
slope. -/
theorem rightBracketLeg_mod_cameraSlope_eq_radius
    {camera index radius : ℕ} (hcamera : 2 ≤ camera)
    (hradius : radius ∈ radiusSet camera) :
    (alignedCenter camera index + radius) % cameraSlope camera = radius := by
  have hradiusLt :=
    (emittedRadius_pos_and_lt_cameraSlope hcamera hradius).2
  rw [Nat.add_mod, alignedCenter_mod_cameraSlope]
  simp [Nat.mod_eq_of_lt hradiusLt]

/-- The left bracket leg has residue exactly `slope - radius` modulo the
camera slope. -/
theorem leftBracketLeg_mod_cameraSlope_eq_slope_sub_radius
    {camera index radius : ℕ} (hcamera : 2 ≤ camera)
    (hradius : radius ∈ radiusSet camera) :
    (alignedCenter camera index - radius) % cameraSlope camera =
      cameraSlope camera - radius := by
  have hradiusBounds :=
    emittedRadius_pos_and_lt_cameraSlope hcamera hradius
  have hresidueLt : cameraSlope camera - radius < cameraSlope camera := by
    omega
  rw [leftBracketLeg_eq_cameraBlock_add_residue hcamera hradius,
    Nat.add_mod]
  simp [Nat.mod_eq_of_lt hresidueLt]

/-- Exact three-position residue ledger of every supported bracket: the center
has residue zero, the left leg residue `d-r`, and the right leg residue `r`. -/
theorem bracketCenter_left_right_exactResidues
    {camera index radius : ℕ} (hcamera : 2 ≤ camera)
    (hradius : radius ∈ radiusSet camera) :
    alignedCenter camera index % cameraSlope camera = 0 ∧
      (alignedCenter camera index - radius) % cameraSlope camera =
        cameraSlope camera - radius ∧
      (alignedCenter camera index + radius) % cameraSlope camera = radius := by
  exact ⟨alignedCenter_mod_cameraSlope camera index,
    leftBracketLeg_mod_cameraSlope_eq_slope_sub_radius hcamera hradius,
    rightBracketLeg_mod_cameraSlope_eq_radius hcamera hradius⟩

/-- The two leg classes collide exactly in the antipodal case `2r = d`.
They never collide with the center class by the separation theorem above. -/
theorem leftLeg_residue_eq_rightLeg_residue_iff_antipodal
    {camera index radius : ℕ} (hcamera : 2 ≤ camera)
    (hradius : radius ∈ radiusSet camera) :
    (alignedCenter camera index - radius) % cameraSlope camera =
        (alignedCenter camera index + radius) % cameraSlope camera ↔
      2 * radius = cameraSlope camera := by
  rw [leftBracketLeg_mod_cameraSlope_eq_slope_sub_radius hcamera hradius,
    rightBracketLeg_mod_cameraSlope_eq_radius hcamera hradius]
  have hradiusLt :=
    (emittedRadius_pos_and_lt_cameraSlope hcamera hradius).2
  omega

/-- In every natural camera, whose slope is its label, neither bracket leg is
divisible by the camera base. -/
theorem naturalBracketLegs_not_dvd_camera
    {camera index radius : ℕ} (hcamera : 3 ≤ camera)
    (hradius : radius ∈ radiusSet camera) :
    (¬camera ∣ alignedCenter camera index - radius) ∧
      (¬camera ∣ alignedCenter camera index + radius) := by
  simpa [cameraSlope_of_ne_two (by omega : camera ≠ 2)] using
    bracketLegs_off_centerLattice (show 2 ≤ camera by omega) hradius

/-- The exceptional aligned C2 chart is stronger than slope separation: its
centers are multiples of four and its unique-radius legs are both odd. -/
theorem c2BracketLegs_not_even
    {index radius : ℕ} (hradius : radius ∈ radiusSet 2) :
    (¬2 ∣ alignedCenter 2 index - radius) ∧
      (¬2 ∣ alignedCenter 2 index + radius) := by
  change radius ∈ Finset.Icc 1 1 at hradius
  have hradiusBounds := Finset.mem_Icc.mp hradius
  have : radius = 1 := by omega
  subst radius
  change (¬2 ∣ 4 * (index + 1) - 1) ∧
    (¬2 ∣ 4 * (index + 1) + 1)
  constructor <;> omega

end CarrySelfAdjointOperator
