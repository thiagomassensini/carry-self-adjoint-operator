import CarrySelfAdjointOperator.CompletedNativeTfvdCameraParsevalLossChannel
import Mathlib.Tactic

/-!
# Camera Parseval transport restricted to BR2 incidences

The global camera-Parseval interface asks for an isometry on all of
`CarryVerticalL2`.  The HP handoff never uses that much data: it uses only
the real finite incidence ledger and the BR2 bracket states generated by it.

This file records the strictly weaker interface.  Its transport has the
incidence ledger as source and is required to preserve pairings only between
the bracket incidences of the selected `(base, radius)`.  The finite-camera
Parseval identity then gives the visible/blind splitting on precisely the
parity jet needed by the coefficient and HP constructions.

No Hankel positivity, moment factorization, global source isometry, or global
readout injectivity is assumed.
-/

open scoped InnerProductSpace Matrix lp

namespace CarrySelfAdjointOperator

open CPFormal.Analytic.Cp
open FiniteNativeCarryOperator.Camera
open NativeCarryC3Crosswalk

noncomputable section

/-- A finite-camera transport required only on the BR2 incidence ledger.

`incidenceTransport` is real-linear because the source ledger is real.  The
only metric condition is its pairing equation on the actual bracket family;
by real linearity this is the information used by every finite real
combination of the incidences. -/
structure CanonicalCompletedNativeTfvdCameraParsevalIncidenceTransport
    {camera state : Type*}
    [Fintype camera] [DecidableEq camera]
    [Fintype state] [DecidableEq state]
    (C : Matrix camera state ℝ) (base radius : ℕ) where
  incidenceTransport :
    (ℕ →₀ ℝ) →ₗ[ℝ]
      FiniteHilbertFamily state CanonicalCompletedTfvdGreenHilbertCarrier
  rowGramPosDef : (finiteCameraRowGram C).PosDef
  bracket_inner : ∀ i j : ℕ,
    inner ℂ
        (incidenceTransport (cameraBracketIncidence base radius i))
        (incidenceTransport (cameraBracketIncidence base radius j)) =
      inner ℂ (br2CameraBracketVerticalState base radius i)
        (br2CameraBracketVerticalState base radius j)

namespace CanonicalCompletedNativeTfvdCameraParsevalIncidenceTransport

variable {camera state : Type*}
variable [Fintype camera] [DecidableEq camera]
variable [Fintype state] [DecidableEq state]
variable {C : Matrix camera state ℝ} {base radius : ℕ}

/-- The transported BR2 parity source before the camera readout. -/
def sourceParityJet
    (candidate :
      CanonicalCompletedNativeTfvdCameraParsevalIncidenceTransport C base radius) :
    (ℕ ⊕ ℕ) →
      FiniteHilbertFamily state CanonicalCompletedTfvdGreenHilbertCarrier
  | Sum.inl n => candidate.incidenceTransport
      (cameraBracketIncidence base radius (2 * n))
  | Sum.inr n => candidate.incidenceTransport
      (cameraBracketIncidence base radius (2 * n + 1))

/-- The visible camera output on the BR2 parity source. -/
def visibleParityJet
    (candidate :
      CanonicalCompletedNativeTfvdCameraParsevalIncidenceTransport C base radius) :
    (ℕ ⊕ ℕ) →
      FiniteHilbertFamily camera CanonicalCompletedTfvdGreenHilbertCarrier :=
  fun i => finiteCanonicalCameraHilbertReadout C (candidate.sourceParityJet i)

/-- The blind camera output on the same BR2 parity source. -/
def blindParityJet
    (candidate :
      CanonicalCompletedNativeTfvdCameraParsevalIncidenceTransport C base radius) :
    (ℕ ⊕ ℕ) →
      FiniteHilbertFamily state CanonicalCompletedTfvdGreenHilbertCarrier :=
  fun i => finiteHilbertMatrixSynthesis
    (finiteCanonicalCameraBlindProjection C) (candidate.sourceParityJet i)

/-- The restricted metric premise identifies the transported source Gram with
the literal BR2 parity Gram. -/
theorem sourceParityJet_inner_eq_br2
    (candidate :
      CanonicalCompletedNativeTfvdCameraParsevalIncidenceTransport C base radius)
    (i j : ℕ ⊕ ℕ) :
    inner ℂ (candidate.sourceParityJet i) (candidate.sourceParityJet j) =
      inner ℂ (br2CameraBracketProjectiveHilbertParityJet base radius i)
        (br2CameraBracketProjectiveHilbertParityJet base radius j) := by
  cases i <;> cases j <;>
    simpa [sourceParityJet, br2CameraBracketProjectiveHilbertParityJet] using
      candidate.bracket_inner _ _

/-- Parseval on the transported incidence jet.  This is the only splitting
identity used by the BR2 coefficient comparison. -/
theorem gramSplit
    (candidate :
      CanonicalCompletedNativeTfvdCameraParsevalIncidenceTransport C base radius)
    (i j : ℕ ⊕ ℕ) :
    inner ℂ (candidate.visibleParityJet i) (candidate.visibleParityJet j) +
        inner ℂ (candidate.blindParityJet i) (candidate.blindParityJet j) =
      inner ℂ (br2CameraBracketProjectiveHilbertParityJet base radius i)
        (br2CameraBracketProjectiveHilbertParityJet base radius j) := by
  have h := finiteCanonicalEnrichedCameraHilbert_parseval C
    candidate.rowGramPosDef (candidate.sourceParityJet i)
      (candidate.sourceParityJet j)
  rw [candidate.sourceParityJet_inner_eq_br2 i j] at h
  exact h

/-- The six-source coefficient minus the visible pairing.  This is retained
as an identity-valued defect rather than an inequality or fitted correction. -/
def visibleCoefficientDefect
    (candidate :
      CanonicalCompletedNativeTfvdCameraParsevalIncidenceTransport C base radius)
    (M : ℕ) (q : ℝ) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (S : Finset NativeGpreBoundaryContext)
    (i j : ℕ ⊕ ℕ) : ℂ :=
  nativeC3SeededClockTfvdSixSourceCenterLegCoefficient
      M q hq0 hq1 S (parityJetNumber i) (parityJetNumber j) -
    inner ℂ (candidate.visibleParityJet i) (candidate.visibleParityJet j)

/-- The blind pairing is the pre-existing energy excess plus precisely the
visible coefficient defect. -/
theorem blind_inner_eq_energyExcess_add_visibleCoefficientDefect
    (candidate :
      CanonicalCompletedNativeTfvdCameraParsevalIncidenceTransport C base radius)
    (M : ℕ) (q : ℝ) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (S : Finset NativeGpreBoundaryContext)
    (i j : ℕ ⊕ ℕ) :
    inner ℂ (candidate.blindParityJet i) (candidate.blindParityJet j) =
      nativeC3SeededClockTfvdSixSourceBr2EnergyExcess
          M q hq0 hq1 S base radius i j +
        candidate.visibleCoefficientDefect M q hq0 hq1 S i j := by
  have hsplit := candidate.gramSplit i j
  unfold nativeC3SeededClockTfvdSixSourceBr2EnergyExcess
    visibleCoefficientDefect
  linear_combination hsplit

/-- Direct visible realization of the completed six-source coefficient. -/
def RealizesSixSourceVisibleCoefficient
    (candidate :
      CanonicalCompletedNativeTfvdCameraParsevalIncidenceTransport C base radius)
    (M : ℕ) (q : ℝ) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (S : Finset NativeGpreBoundaryContext) : Prop :=
  ∀ i j : ℕ ⊕ ℕ,
    nativeC3SeededClockTfvdSixSourceCenterLegCoefficient
        M q hq0 hq1 S (parityJetNumber i) (parityJetNumber j) =
      inner ℂ (candidate.visibleParityJet i) (candidate.visibleParityJet j)

/-- Direct blind realization of the already-defined BR2 energy excess. -/
def RealizesSixSourceEnergyExcess
    (candidate :
      CanonicalCompletedNativeTfvdCameraParsevalIncidenceTransport C base radius)
    (M : ℕ) (q : ℝ) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (S : Finset NativeGpreBoundaryContext) : Prop :=
  ∀ i j : ℕ ⊕ ℕ,
    inner ℂ (candidate.blindParityJet i) (candidate.blindParityJet j) =
      nativeC3SeededClockTfvdSixSourceBr2EnergyExcess
        M q hq0 hq1 S base radius i j

/-- On the incidence-restricted interface, the visible coefficient seam and
the blind energy-excess seam remain exactly equivalent. -/
theorem realizesSixSourceVisibleCoefficient_iff_energyExcess
    (candidate :
      CanonicalCompletedNativeTfvdCameraParsevalIncidenceTransport C base radius)
    (M : ℕ) (q : ℝ) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (S : Finset NativeGpreBoundaryContext) :
    candidate.RealizesSixSourceVisibleCoefficient M q hq0 hq1 S ↔
      candidate.RealizesSixSourceEnergyExcess M q hq0 hq1 S := by
  constructor
  · intro hvisible i j
    rw [candidate.blind_inner_eq_energyExcess_add_visibleCoefficientDefect
      M q hq0 hq1 S i j]
    unfold visibleCoefficientDefect
    rw [hvisible i j]
    ring
  · intro hblind i j
    have hdefect := candidate.blind_inner_eq_energyExcess_add_visibleCoefficientDefect
      M q hq0 hq1 S i j
    rw [hblind i j] at hdefect
    have hzero : candidate.visibleCoefficientDefect M q hq0 hq1 S i j = 0 := by
      exact add_eq_left.mp hdefect.symm
    exact sub_eq_zero.mp hzero

/-- The only injectivity datum required by the HP handoff: a real incidence
transport for the visible parity jet. -/
def HasVisibleIncidenceTransport
    (candidate :
      CanonicalCompletedNativeTfvdCameraParsevalIncidenceTransport C base radius) : Prop :=
  Nonempty (BR2BracketIncidenceJetTransport base radius candidate.visibleParityJet)

/-- The restricted camera data, visible coefficient identity, and visible
incidence faithfulness give the real HP carrier certificate. -/
theorem toRealHPCarrierCertificate
    (candidate :
      CanonicalCompletedNativeTfvdCameraParsevalIncidenceTransport C base radius)
    (M : ℕ) (q : ℝ) (hqpos : 0 < q) (hq1 : q < 1)
    (S : Finset NativeGpreBoundaryContext)
    (hbase : IsSupported base)
    (hradius : radius ∈ radiusSet base)
    (hvisible : candidate.RealizesSixSourceVisibleCoefficient
      M q hqpos.le hq1 S)
    (htransport : candidate.HasVisibleIncidenceTransport) :
    letI : InnerProductSpace ℝ
        (FiniteHilbertFamily camera CanonicalCompletedTfvdGreenHilbertCarrier) :=
      InnerProductSpace.rclikeToReal ℂ _
    CompletedNativeRealHPCarrierCertificate candidate.visibleParityJet := by
  letI : InnerProductSpace ℝ
      (FiniteHilbertFamily camera CanonicalCompletedTfvdGreenHilbertCarrier) :=
    InnerProductSpace.rclikeToReal ℂ _
  let incidence := canonicalParityCenterLegIncidence
    base radius hbase hradius CameraLegSide.left
  let certificate : BR2CenterLegCoefficientCertificate incidence
      canonicalCompletedNativeLogDerivativeMoment candidate.visibleParityJet :=
    { coeff := nativeC3SeededClockTfvdSixSourceCenterLegCoefficient
        M q hqpos.le hq1 S
      coefficientEquation :=
        nativeC3SeededClockTfvdSixSourceTower_coefficientEquation
          M q hqpos hq1 S
      greenOffDiagonalReadout := fun i j _ => hvisible i j }
  have hcomplex := certificate.toComplexMomentKernel
  rcases htransport with ⟨transport⟩
  refine
    { momentKernel := ?_
      evenIndependent := transport.even_linearIndependent hbase hradius
      oddIndependent := transport.odd_linearIndependent hbase hradius }
  intro i j
  change greenWronskianMomentKernel
      canonicalCompletedNativeLogDerivativeMoment i j =
    (inner ℂ (candidate.visibleParityJet i)
      (candidate.visibleParityJet j)).re
  have h := congrArg Complex.re (hcomplex i j)
  simpa using h

/-- The same restricted seams close the extensional Stieltjes handoff. -/
theorem toStieltjesPositivity
    (candidate :
      CanonicalCompletedNativeTfvdCameraParsevalIncidenceTransport C base radius)
    (M : ℕ) (q : ℝ) (hqpos : 0 < q) (hq1 : q < 1)
    (S : Finset NativeGpreBoundaryContext)
    (hbase : IsSupported base)
    (hradius : radius ∈ radiusSet base)
    (hvisible : candidate.RealizesSixSourceVisibleCoefficient
      M q hqpos.le hq1 S)
    (htransport : candidate.HasVisibleIncidenceTransport) :
    CanonicalCompletedNativeStieltjesPositivity := by
  letI : InnerProductSpace ℝ
      (FiniteHilbertFamily camera CanonicalCompletedTfvdGreenHilbertCarrier) :=
    InnerProductSpace.rclikeToReal ℂ _
  exact canonicalCompletedNativeStieltjesPositivity_of_certificate
    (candidate.toRealHPCarrierCertificate M q hqpos hq1 S
      hbase hradius hvisible htransport)

/-! ## The original global interface induces the restricted one -/

/-- Forgetting the metric behavior outside the incidence ledger turns every
global source isometry into an incidence-restricted camera transport. -/
def ofGlobal
    (candidate : CanonicalCompletedNativeTfvdCameraParsevalTransport C)
    (base radius : ℕ) :
    CanonicalCompletedNativeTfvdCameraParsevalIncidenceTransport C base radius where
  incidenceTransport :=
    (candidate.sourceTransport.restrictScalars ℝ).comp
      br2CameraBracketProjectiveHilbertMap
  rowGramPosDef := candidate.rowGramPosDef
  bracket_inner i j := by
    simp only [LinearMap.comp_apply,
      br2CameraBracketProjectiveHilbertMap_cameraBracketIncidence]
    exact candidate.sourceTransport_inner _ _

/-- On each BR2 parity component, the restricted transport induced from a
global one is its old source transport evaluated on the same completed
vertical bracket. -/
theorem ofGlobal_sourceParityJet_eq
    (candidate : CanonicalCompletedNativeTfvdCameraParsevalTransport C)
    (base radius : ℕ) (i : ℕ ⊕ ℕ) :
    (ofGlobal candidate base radius).sourceParityJet i =
      candidate.sourceTransport
        (br2CameraBracketProjectiveHilbertParityJet base radius i) := by
  cases i <;>
    simp [ofGlobal, sourceParityJet,
      br2CameraBracketProjectiveHilbertParityJet,
      br2CameraBracketProjectiveHilbertMap_cameraBracketIncidence]

/-- Consequently the induced restricted visible jet is exactly the old
visible jet on every BR2 parity component. -/
theorem ofGlobal_visibleParityJet_eq
    (candidate : CanonicalCompletedNativeTfvdCameraParsevalTransport C)
    (base radius : ℕ) (i : ℕ ⊕ ℕ) :
    (ofGlobal candidate base radius).visibleParityJet i =
      candidate.visibleParityJet base radius i := by
  unfold visibleParityJet
  rw [ofGlobal_sourceParityJet_eq]
  rfl

/-- And the blind parity jet is unchanged by forgetting the global metric
assumption. -/
theorem ofGlobal_blindParityJet_eq
    (candidate : CanonicalCompletedNativeTfvdCameraParsevalTransport C)
    (base radius : ℕ) (i : ℕ ⊕ ℕ) :
    (ofGlobal candidate base radius).blindParityJet i =
      candidate.blindParityJet base radius i := by
  unfold blindParityJet
  rw [ofGlobal_sourceParityJet_eq]
  rfl

/-- The old visible-incidence hypothesis transports unchanged to the
incidence-restricted interface.  Thus the weakening removes only unused
global metric data; it does not ask for any new HP faithfulness premise. -/
theorem ofGlobal_hasVisibleIncidenceTransport
    (candidate : CanonicalCompletedNativeTfvdCameraParsevalTransport C)
    (base radius : ℕ)
    (hvisible : candidate.HasVisibleIncidenceTransport base radius) :
    (ofGlobal candidate base radius).HasVisibleIncidenceTransport := by
  rcases hvisible with ⟨transport⟩
  refine ⟨{ toLinearMap := transport.toLinearMap
            injective := transport.injective
            even_eq := ?_
            odd_eq := ?_ }⟩
  · intro n
    rw [ofGlobal_visibleParityJet_eq]
    exact transport.even_eq n
  · intro n
    rw [ofGlobal_visibleParityJet_eq]
    exact transport.odd_eq n

end CanonicalCompletedNativeTfvdCameraParsevalIncidenceTransport

end

end CarrySelfAdjointOperator
