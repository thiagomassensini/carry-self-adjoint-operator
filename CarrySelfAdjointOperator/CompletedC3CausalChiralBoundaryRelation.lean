import CarrySelfAdjointOperator.CompletedC3CoisometricCameraChiralTransformation
import Mathlib.Tactic

/-!
# Causal chiral boundary relation

The positive completed-Wronskian chirality and the coisometric camera/chiral
block are linear readouts of one enriched completed C3 source.  They cannot be
related by a linear map on the unrestricted ambient direct sum: a coherent
camera-only direction is invisible to the scalar trace.

This module therefore keeps the two readouts as a boundary relation generated
by the canonical completed source family.  Its indefinite diagonal form is
exactly the previously isolated coisometric Wronskian energy balance.  Thus
isotropy of the canonical datum is precisely the remaining diagonal sewing
identity, while a hypothetical upper-half-plane characteristic zero produces
a strictly positive boundary defect.
-/

open scoped ComplexConjugate InnerProductSpace lp

namespace CarrySelfAdjointOperator

open CPFormal.Analytic.Cp

noncomputable section

/-! ## Common causal source and its two boundary readouts -/

/-- Boundary carrier retaining the positive Wronskian chirality and the full
coisometric camera/chiral block as separate coordinates. -/
abbrev CanonicalCompletedC3CausalChiralBoundaryCarrier :=
  WithLp 2
    (CanonicalCompletedC3FullWronskianOperatorCarrier ×
      CanonicalCompletedC3CoisometricCameraChiralEnergyCarrier)

/-- The two boundary coordinates read linearly from the same enriched source. -/
def canonicalCompletedC3EnrichedCausalChiralBoundaryReadout
    (z : ℂ) :
    CanonicalCompletedC3EnrichedChiralSourceCarrier →L[ℝ]
      CanonicalCompletedC3CausalChiralBoundaryCarrier :=
  (WithLp.prodContinuousLinearEquiv 2 ℝ
      CanonicalCompletedC3FullWronskianOperatorCarrier
      CanonicalCompletedC3CoisometricCameraChiralEnergyCarrier).symm
    |>.toContinuousLinearMap.comp
      ((canonicalCompletedC3EnrichedPositiveChiralReadout z).prod
        (canonicalCompletedC3EnrichedCoisometricCameraChiralReadout z))

/-- Concrete boundary datum produced by the completed C3 state. -/
def canonicalCompletedC3CausalChiralBoundaryState
    (M : ℕ) (z : ℂ)
    (hzHalf : 0 < (operatorHeightParameter z).re) :
    CanonicalCompletedC3CausalChiralBoundaryCarrier :=
  WithLp.toLp 2
    (canonicalCompletedC3FullWronskianPositivePolarization
        (canonicalCompletedC3NormalizedFullWronskianOperatorState M z),
      canonicalCompletedC3CoisometricCameraChiralEnergyState M z hzHalf)

/-- The common enriched source produces exactly the concrete two-sided
boundary datum. -/
theorem canonicalCompletedC3EnrichedCausalChiralBoundaryReadout_sourceState
    (M : ℕ) (z : ℂ)
    (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip) :
    canonicalCompletedC3EnrichedCausalChiralBoundaryReadout z
        (canonicalCompletedC3EnrichedChiralSourceState z hzStrip) =
      canonicalCompletedC3CausalChiralBoundaryState M z hzStrip.1 := by
  apply WithLp.ofLp_injective 2
  apply Prod.ext
  · exact canonicalCompletedC3EnrichedPositiveChiralReadout_sourceState
      M z hzStrip
  · exact canonicalCompletedC3EnrichedCoisometricCameraChiralReadout_sourceState
      M z hzStrip

/-- The concrete causal boundary datum is independent of the auxiliary
Wronskian cutoff index.  Both spellings are the same readout of the same
completed source. -/
theorem canonicalCompletedC3CausalChiralBoundaryState_cutoff_independent
    (M N : ℕ) (z : ℂ)
    (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip) :
    canonicalCompletedC3CausalChiralBoundaryState M z hzStrip.1 =
      canonicalCompletedC3CausalChiralBoundaryState N z hzStrip.1 := by
  rw [← canonicalCompletedC3EnrichedCausalChiralBoundaryReadout_sourceState
      M z hzStrip,
    ← canonicalCompletedC3EnrichedCausalChiralBoundaryReadout_sourceState
      N z hzStrip]

/-! ## The relation generated by canonical completed sources -/

/-- Canonical completed source states before applying either boundary readout. -/
def canonicalCompletedC3CausalChiralSourceSet :
    Set CanonicalCompletedC3EnrichedChiralSourceCarrier :=
  {state | ∃ (z : ℂ)
      (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip),
      state = canonicalCompletedC3EnrichedChiralSourceState z hzStrip}

/-- Real-linear span of the actual completed C3 source family. -/
def canonicalCompletedC3CausalChiralSourceSubmodule :
    Submodule ℝ CanonicalCompletedC3EnrichedChiralSourceCarrier :=
  Submodule.span ℝ canonicalCompletedC3CausalChiralSourceSet

theorem canonicalCompletedC3EnrichedChiralSourceState_mem_causalSubmodule
    (z : ℂ)
    (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip) :
    canonicalCompletedC3EnrichedChiralSourceState z hzStrip ∈
      canonicalCompletedC3CausalChiralSourceSubmodule := by
  apply Submodule.subset_span
  exact ⟨z, hzStrip, rfl⟩

/-- Boundary relation obtained from the canonical causal source span.  It is a
relation rather than a globally selected response-from-trace operator. -/
def canonicalCompletedC3CausalChiralBoundaryRelation
    (z : ℂ) :
    Submodule ℝ CanonicalCompletedC3CausalChiralBoundaryCarrier :=
  canonicalCompletedC3CausalChiralSourceSubmodule.map
    (canonicalCompletedC3EnrichedCausalChiralBoundaryReadout z).toLinearMap

/-- Every concrete completed datum belongs to the causal boundary relation. -/
theorem canonicalCompletedC3CausalChiralBoundaryState_mem_relation
    (M : ℕ) (z : ℂ)
    (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip) :
    canonicalCompletedC3CausalChiralBoundaryState M z hzStrip.1 ∈
      canonicalCompletedC3CausalChiralBoundaryRelation z := by
  refine ⟨canonicalCompletedC3EnrichedChiralSourceState z hzStrip,
    canonicalCompletedC3EnrichedChiralSourceState_mem_causalSubmodule
      z hzStrip, ?_⟩
  exact canonicalCompletedC3EnrichedCausalChiralBoundaryReadout_sourceState
    M z hzStrip

/-! ## Exact indefinite boundary balance -/

/-- Real indefinite Green-energy form: coisometric/camera energy minus
positive Wronskian chirality.  The scalar field is `ℝ` because the canonical
camera readout is the realification of the Naimark carrier. -/
def canonicalCompletedC3CausalChiralBoundaryForm
    (y x : CanonicalCompletedC3CausalChiralBoundaryCarrier) : ℝ :=
  inner ℝ y.snd x.snd - inner ℝ y.fst x.fst

/-- On the canonical datum, the indefinite Green square is exactly the real
energy balance already obtained from the center--leg/TFVD calculation. -/
theorem canonicalCompletedC3CausalChiralBoundaryForm_self_eq_energyBalance
    (M : ℕ) (z : ℂ) (hzIm : 0 ≤ z.im)
    (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip) :
    canonicalCompletedC3CausalChiralBoundaryForm
        (canonicalCompletedC3CausalChiralBoundaryState M z hzStrip.1)
        (canonicalCompletedC3CausalChiralBoundaryState M z hzStrip.1) =
      canonicalCompletedC3CoisometricDiagonalWronskianEnergyBalance
        M z hzStrip.1 := by
  have hcamera :=
    norm_sq_coisometricCameraChiral_eq_coisometricChiral
      M z hzStrip.1 hzIm
  have hbalance :=
    canonicalCompletedC3CoisometricDiagonalWronskianEnergyBalance_eq_chiralBlockDifference
      M z hzIm hzStrip
  have hreal :
      ‖canonicalCompletedC3CoisometricCameraChiralEnergyState
          M z hzStrip.1‖ ^ 2 -
        ‖canonicalCompletedC3FullWronskianPositivePolarization
          (canonicalCompletedC3NormalizedFullWronskianOperatorState M z)‖ ^ 2 =
      canonicalCompletedC3CoisometricDiagonalWronskianEnergyBalance
        M z hzStrip.1 := by
    rw [hcamera]
    exact hbalance.symm
  unfold canonicalCompletedC3CausalChiralBoundaryForm
    canonicalCompletedC3CausalChiralBoundaryState
  change
    inner ℝ
          (canonicalCompletedC3CoisometricCameraChiralEnergyState
            M z hzStrip.1)
          (canonicalCompletedC3CoisometricCameraChiralEnergyState
            M z hzStrip.1) -
        inner ℝ
          (canonicalCompletedC3FullWronskianPositivePolarization
            (canonicalCompletedC3NormalizedFullWronskianOperatorState M z))
          (canonicalCompletedC3FullWronskianPositivePolarization
            (canonicalCompletedC3NormalizedFullWronskianOperatorState M z)) = _
  rw [inner_self_eq_norm_sq_to_K, inner_self_eq_norm_sq_to_K]
  exact hreal

/-- The explicit real balance inherits the same exact cutoff independence. -/
theorem canonicalCompletedC3CoisometricDiagonalWronskianEnergyBalance_cutoff_independent
    (M N : ℕ) (z : ℂ) (hzIm : 0 ≤ z.im)
    (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip) :
    canonicalCompletedC3CoisometricDiagonalWronskianEnergyBalance
        M z hzStrip.1 =
      canonicalCompletedC3CoisometricDiagonalWronskianEnergyBalance
        N z hzStrip.1 := by
  calc
    canonicalCompletedC3CoisometricDiagonalWronskianEnergyBalance
          M z hzStrip.1 =
        canonicalCompletedC3CausalChiralBoundaryForm
          (canonicalCompletedC3CausalChiralBoundaryState M z hzStrip.1)
          (canonicalCompletedC3CausalChiralBoundaryState M z hzStrip.1) :=
      (canonicalCompletedC3CausalChiralBoundaryForm_self_eq_energyBalance
        M z hzIm hzStrip).symm
    _ = canonicalCompletedC3CausalChiralBoundaryForm
          (canonicalCompletedC3CausalChiralBoundaryState N z hzStrip.1)
          (canonicalCompletedC3CausalChiralBoundaryState N z hzStrip.1) := by
      rw [canonicalCompletedC3CausalChiralBoundaryState_cutoff_independent
        M N z hzStrip]
    _ = canonicalCompletedC3CoisometricDiagonalWronskianEnergyBalance
          N z hzStrip.1 :=
      canonicalCompletedC3CausalChiralBoundaryForm_self_eq_energyBalance
        N z hzIm hzStrip

/-- Isotropy of the actual two-sided boundary datum. -/
def CanonicalCompletedC3CausalChiralBoundaryStateIsotropic
    (M : ℕ) (z : ℂ)
    (hzHalf : 0 < (operatorHeightParameter z).re) : Prop :=
  canonicalCompletedC3CausalChiralBoundaryForm
      (canonicalCompletedC3CausalChiralBoundaryState M z hzHalf)
      (canonicalCompletedC3CausalChiralBoundaryState M z hzHalf) = 0

/-- Isotropy is exactly vanishing of the explicit energy balance. -/
theorem canonicalCompletedC3CausalChiralBoundaryStateIsotropic_iff_energyBalance
    (M : ℕ) (z : ℂ) (hzIm : 0 ≤ z.im)
    (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip) :
    CanonicalCompletedC3CausalChiralBoundaryStateIsotropic
        M z hzStrip.1 ↔
      canonicalCompletedC3CoisometricDiagonalWronskianEnergyBalance
        M z hzStrip.1 = 0 := by
  unfold CanonicalCompletedC3CausalChiralBoundaryStateIsotropic
  rw [canonicalCompletedC3CausalChiralBoundaryForm_self_eq_energyBalance
    M z hzIm hzStrip]

/-- The original coisometric/Wronskian sewing equation is precisely isotropy
of the canonical causal boundary datum. -/
theorem canonicalCompletedC3CoisometricBoundaryReadout_diagonal_eq_wronskian_iff_causalChiralIsotropic
    (M : ℕ) (z : ℂ) (hzIm : 0 < z.im)
    (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip) :
    canonicalCompletedC3CoisometricCompressedBoundaryReadout
          z z hzStrip.1 hzStrip.1 =
        completedGreenWronskian
          completedNativeOperatorCharacteristic
          completedNativeOperatorBoundaryCompanion z z ↔
      CanonicalCompletedC3CausalChiralBoundaryStateIsotropic
        M z hzStrip.1 := by
  calc
    _ ↔ canonicalCompletedC3CoisometricDiagonalWronskianEnergyBalance
          M z hzStrip.1 = 0 :=
      canonicalCompletedC3CoisometricBoundaryReadout_diagonal_eq_wronskian_iff_energyBalance
        M z (ne_of_gt hzIm) hzStrip
    _ ↔ _ :=
      (canonicalCompletedC3CausalChiralBoundaryStateIsotropic_iff_energyBalance
        M z hzIm.le hzStrip).symm

/-! ## Sign audit at a hypothetical off-axis zero -/

/-- At a hypothetical upper-half-plane characteristic zero, the causal
boundary datum has strictly positive indefinite energy. -/
theorem canonicalCompletedC3CausalChiralBoundaryForm_self_pos_of_characteristicZero
    (M : ℕ) (z : ℂ) (hzIm : 0 < z.im)
    (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip)
    (hzero : completedNativeOperatorCharacteristic z = 0) :
    0 < canonicalCompletedC3CausalChiralBoundaryForm
        (canonicalCompletedC3CausalChiralBoundaryState M z hzStrip.1)
        (canonicalCompletedC3CausalChiralBoundaryState M z hzStrip.1) := by
  rw [canonicalCompletedC3CausalChiralBoundaryForm_self_eq_energyBalance
    M z hzIm.le hzStrip]
  exact
    canonicalCompletedC3CoisometricDiagonalWronskianEnergyBalance_pos_of_characteristicZero
      M z hzIm hzStrip hzero

/-- Hence the actual causal boundary datum cannot be isotropic at a
hypothetical upper-half-plane characteristic zero. -/
theorem canonicalCompletedC3CausalChiralBoundaryState_not_isotropic_of_characteristicZero
    (M : ℕ) (z : ℂ) (hzIm : 0 < z.im)
    (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip)
    (hzero : completedNativeOperatorCharacteristic z = 0) :
    ¬ CanonicalCompletedC3CausalChiralBoundaryStateIsotropic
        M z hzStrip.1 := by
  intro hisotropic
  exact (ne_of_gt
    (canonicalCompletedC3CausalChiralBoundaryForm_self_pos_of_characteristicZero
      M z hzIm hzStrip hzero)) hisotropic

/-- Isotropy of an entire causal relation in the real Green-energy form. -/
def CanonicalCompletedC3CausalChiralBoundaryRelationIsotropic
    (z : ℂ) : Prop :=
  ∀ state ∈ canonicalCompletedC3CausalChiralBoundaryRelation z,
    canonicalCompletedC3CausalChiralBoundaryForm state state = 0

/-- A hypothetical upper-half-plane characteristic zero supplies a concrete
member witnessing that the corresponding causal relation is not isotropic. -/
theorem canonicalCompletedC3CausalChiralBoundaryRelation_not_isotropic_of_characteristicZero
    (M : ℕ) (z : ℂ) (hzIm : 0 < z.im)
    (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip)
    (hzero : completedNativeOperatorCharacteristic z = 0) :
    ¬ CanonicalCompletedC3CausalChiralBoundaryRelationIsotropic z := by
  intro hrelation
  exact
    (canonicalCompletedC3CausalChiralBoundaryState_not_isotropic_of_characteristicZero
      M z hzIm hzStrip hzero)
      (hrelation
        (canonicalCompletedC3CausalChiralBoundaryState M z hzStrip.1)
        (canonicalCompletedC3CausalChiralBoundaryState_mem_relation
          M z hzStrip))

end

end CarrySelfAdjointOperator
