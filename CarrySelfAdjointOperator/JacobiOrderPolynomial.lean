import Mathlib.Data.Polynomial.Eval.Defs
import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Tactic

/-!
# Exact algebra of Jacobi order increments

This module isolates the recurrence and telescoping identities that do not
depend on spectral analysis.  The polynomials below are defined by the Jacobi
three-term recurrence.  A later tridiagonality theorem must identify them
with the characteristic polynomials of the concrete finite Jacobi sections.

No interlacing, simplicity, convergence, or infinite-operator claim is made
here.
-/

open scoped BigOperators

namespace CarrySelfAdjointOperator

noncomputable section

/-- Polynomial sequence generated by diagonal coefficients `diag` and
off-diagonal coefficients `off` of a Jacobi recurrence. -/
def jacobiOrderPolynomial
    (diag off : ℕ → ℝ) : ℕ → Polynomial ℝ
  | 0 => 1
  | 1 => Polynomial.X - Polynomial.C (diag 0)
  | n + 2 =>
      (Polynomial.X - Polynomial.C (diag (n + 1))) *
          jacobiOrderPolynomial diag off (n + 1) -
        Polynomial.C (off n ^ 2) *
          jacobiOrderPolynomial diag off n

@[simp] theorem jacobiOrderPolynomial_zero
    (diag off : ℕ → ℝ) :
    jacobiOrderPolynomial diag off 0 = 1 :=
  rfl

@[simp] theorem jacobiOrderPolynomial_one
    (diag off : ℕ → ℝ) :
    jacobiOrderPolynomial diag off 1 =
      Polynomial.X - Polynomial.C (diag 0) :=
  rfl

/-- Exact three-term recurrence in order. -/
@[simp] theorem jacobiOrderPolynomial_succ_succ
    (diag off : ℕ → ℝ) (n : ℕ) :
    jacobiOrderPolynomial diag off (n + 2) =
      (Polynomial.X - Polynomial.C (diag (n + 1))) *
          jacobiOrderPolynomial diag off (n + 1) -
        Polynomial.C (off n ^ 2) *
          jacobiOrderPolynomial diag off n :=
  rfl

/-- Evaluated form of the exact order recurrence. -/
theorem jacobiOrderPolynomial_eval_succ_succ
    (diag off : ℕ → ℝ) (n : ℕ) (y : ℝ) :
    Polynomial.eval y (jacobiOrderPolynomial diag off (n + 2)) =
      (y - diag (n + 1)) *
          Polynomial.eval y (jacobiOrderPolynomial diag off (n + 1)) -
        off n ^ 2 *
          Polynomial.eval y (jacobiOrderPolynomial diag off n) := by
  rw [jacobiOrderPolynomial_succ_succ]
  simp [Polynomial.eval_sub, Polynomial.eval_mul]

/-- If `y` is a root at order `n + 1`, the next level rejects that old root
by the completely factored boundary term. -/
theorem jacobiOldRootDefectAtSucc
    (diag off : ℕ → ℝ) (n : ℕ) (y : ℝ)
    (hroot :
      Polynomial.eval y (jacobiOrderPolynomial diag off (n + 1)) = 0) :
    Polynomial.eval y (jacobiOrderPolynomial diag off (n + 2)) =
      -(off n ^ 2) *
        Polynomial.eval y (jacobiOrderPolynomial diag off n) := by
  rw [jacobiOrderPolynomial_eval_succ_succ, hroot]
  ring

/-- Increment between two consecutive values of an arbitrary order-indexed
quantity. -/
def orderIncrement (value : ℕ → ℝ) (n : ℕ) : ℝ :=
  value n - value (n + 1)

/-- Exact finite telescoping identity for an order tail. -/
theorem sum_orderIncrement_range
    (value : ℕ → ℝ) (N k : ℕ) :
    ∑ r ∈ Finset.range k, orderIncrement value (N + r) =
      value N - value (N + k) := by
  induction k with
  | zero =>
      simp [orderIncrement]
  | succ k ih =>
      rw [Finset.sum_range_succ, ih]
      unfold orderIncrement
      ring

/-- Interval spelling of the same exact finite order tail. -/
theorem value_eq_later_add_orderTail
    (value : ℕ → ℝ) (N k : ℕ) :
    value N = value (N + k) +
      ∑ r ∈ Finset.range k, orderIncrement value (N + r) := by
  rw [sum_orderIncrement_range]
  ring

end

end CarrySelfAdjointOperator
