/-!
# Mixed C3 Green--Wronskian defect

This file keeps two spectral parameters independent.  It first expands the
polarized scalar Wronskian into local four-leg cells, ordered cross-coordinate
provenance, and four explicit synthesis residuals.  It then isolates the
head--tail completion correction and proves that this correction tends to
zero.

The last section records the remaining obstruction honestly: completion of
the raw C3 Gram kernel does not turn its camera coefficient into the centered
spectral coefficient.  At `1/4` the corresponding mixed coefficient defect
has a nonzero limit.
-/

open scoped BigOperators ComplexConjugate Topology

namespace CarrySelfAdjointOperator

open CPFormal.Analytic.Cp
open NativeCarryC3Crosswalk
open NativeCarrySpectralWeyl.Boundary
open Filter

noncomputable section

/-! ## Universal mixed scalar ledger -/

/-- Polarized scalar boundary with independent left and right parameters. -/
def mixedScalarBoundaryWedge
    (valueZ companionZ valueW companionW : ℂ) : ℂ :=
  companionZ * (starRingEnd ℂ) valueW -
    valueZ * (starRingEnd ℂ) companionW

theorem mixedScalarBoundaryWedge_eq_completedGreenWronskian
    (F Psi : ℂ → ℂ) (z w : ℂ) :
    mixedScalarBoundaryWedge (F z) (Psi z) (F w) (Psi w) =
      completedGreenWronskian F Psi z w :=
  rfl

/-- Residual in the local leg that must synthesize `conj(companionW)`. -/
def mixedBoundaryLeftResidual
    {ι : Type*} [Fintype ι]
    (companionW : ℂ) (legs : ReflectedBoundarySynthesisData ι) : ℂ :=
  (starRingEnd ℂ) companionW - ∑ i : ι, legs.left i

/-- Residual in the local leg that must synthesize `conj(valueW)`. -/
def mixedBoundaryRightResidual
    {ι : Type*} [Fintype ι]
    (valueW : ℂ) (legs : ReflectedBoundarySynthesisData ι) : ℂ :=
  (starRingEnd ℂ) valueW - ∑ i : ι, legs.right i

/-- Residual in the local leg that must synthesize `companionZ`. -/
def mixedBoundaryJetLeftResidual
    {ι : Type*} [Fintype ι]
    (companionZ : ℂ) (legs : ReflectedBoundarySynthesisData ι) : ℂ :=
  companionZ - ∑ i : ι, legs.jetLeft i

/-- Residual in the local leg that must synthesize `valueZ`. -/
def mixedBoundaryJetRightResidual
    {ι : Type*} [Fintype ι]
    (valueZ : ℂ) (legs : ReflectedBoundarySynthesisData ι) : ℂ :=
  valueZ - ∑ i : ι, legs.jetRight i

/-- Bilinear correction generated by the four independent mixed synthesis
residuals.  It is defined from those residuals, not as a global difference. -/
def mixedBoundaryResidualCorrection
    {ι : Type*} [Fintype ι]
    (valueZ companionZ valueW companionW : ℂ)
    (legs : ReflectedBoundarySynthesisData ι) : ℂ :=
  let leftResidual := mixedBoundaryLeftResidual companionW legs
  let rightResidual := mixedBoundaryRightResidual valueW legs
  let jetLeftResidual := mixedBoundaryJetLeftResidual companionZ legs
  let jetRightResidual := mixedBoundaryJetRightResidual valueZ legs
  (∑ i : ι, legs.right i) * jetLeftResidual +
    rightResidual * (∑ i : ι, legs.jetLeft i) +
    rightResidual * jetLeftResidual -
    (∑ i : ι, legs.left i) * jetRightResidual -
    leftResidual * (∑ i : ι, legs.jetRight i) -
    leftResidual * jetRightResidual

/-- Exact mixed synthesis identity before local cells are summed. -/
theorem mixedScalarBoundaryWedge_eq_summedTwoLeg_add_residualCorrection
    {ι : Type*} [Fintype ι]
    (valueZ companionZ valueW companionW : ℂ)
    (legs : ReflectedBoundarySynthesisData ι) :
    mixedScalarBoundaryWedge valueZ companionZ valueW companionW =
      sameSEdgeBoundaryWedge
          (∑ i : ι, legs.left i)
          (∑ i : ι, legs.right i)
          (∑ i : ι, legs.jetLeft i)
          (∑ i : ι, legs.jetRight i) +
        mixedBoundaryResidualCorrection
          valueZ companionZ valueW companionW legs := by
  unfold mixedScalarBoundaryWedge sameSEdgeBoundaryWedge
    mixedBoundaryResidualCorrection mixedBoundaryLeftResidual
    mixedBoundaryRightResidual mixedBoundaryJetLeftResidual
    mixedBoundaryJetRightResidual
  dsimp only
  ring

/-- The mixed scalar Wronskian is the sum of local cells, ordered cross
provenance, and the explicit synthesis correction. -/
theorem mixedScalarBoundaryWedge_eq_localTwoLeg_add_cross_add_residualCorrection
    {ι : Type*} [Fintype ι]
    (valueZ companionZ valueW companionW : ℂ)
    (legs : ReflectedBoundarySynthesisData ι) :
    mixedScalarBoundaryWedge valueZ companionZ valueW companionW =
      (∑ i : ι,
        sameSEdgeBoundaryWedge
          (legs.left i) (legs.right i)
          (legs.jetLeft i) (legs.jetRight i)) +
        twoLegBoundaryCrossProvenance
          legs.left legs.right legs.jetLeft legs.jetRight +
        mixedBoundaryResidualCorrection
          valueZ companionZ valueW companionW legs := by
  rw [mixedScalarBoundaryWedge_eq_summedTwoLeg_add_residualCorrection
      (ι := ι),
    sameSEdgeBoundaryWedge_sum_eq_local_add_crossProvenance (ι := ι)]

/-! ## Two-parameter enriched TFVD transport -/

/-- The universal enriched transport ledger with independent direct and
reflected parameters.  The public one-parameter theorem is its specialization
at `reflectedParameter directParameter`. -/
theorem finiteC3EnrichedTfvdPairBoundary_eq_greenForm_add_provenance_twoParameter
    (M : ℕ) (kappa : ℂ) (omega : ℕ → ℂ)
    (directParameter reflectedParameter : ℂ)
    (pair reflectedPair : EnrichedTfvdValueLogJetPair) :
    let direct := finiteC3EnrichedTfvdPairTransport
      M kappa omega directParameter pair
    let reflected := finiteC3EnrichedTfvdPairTransport
      M kappa omega reflectedParameter reflectedPair
    finiteC3EnrichedTfvdPairBoundaryForm M direct =
      greenForm direct.greenPort reflected.greenPort +
        finiteC3EnrichedTfvdPairGreenProvenance
          M kappa omega pair direct reflected := by
  dsimp only
  unfold finiteC3EnrichedTfvdPairBoundaryForm
    finiteC3EnrichedTfvdPairGreenProvenance
  rw [greenForm_eq_sum_finiteC3GreenPortEdge,
    sum_finiteC3GreenPortEdge_eq_sum_blocks]
  calc
    (∑ m : Fin M,
        ((finiteC3EnrichedTfvdPairTransport
          M kappa omega directParameter pair).boundaryCells m).total) =
        ∑ m : Fin M,
          ((finiteC3GreenPortEdge
                (finiteC3EnrichedTfvdPairTransport
                  M kappa omega directParameter pair).greenPort
                (finiteC3EnrichedTfvdPairTransport
                  M kappa omega reflectedParameter reflectedPair).greenPort
                (finProdFinEquiv (m, 0)) +
              finiteC3GreenPortEdge
                (finiteC3EnrichedTfvdPairTransport
                  M kappa omega directParameter pair).greenPort
                (finiteC3EnrichedTfvdPairTransport
                  M kappa omega reflectedParameter reflectedPair).greenPort
                (finProdFinEquiv (m, 1)) +
              finiteC3GreenPortEdge
                (finiteC3EnrichedTfvdPairTransport
                  M kappa omega directParameter pair).greenPort
                (finiteC3EnrichedTfvdPairTransport
                  M kappa omega reflectedParameter reflectedPair).greenPort
                (finProdFinEquiv (m, 2))) +
            (finiteC3EnrichedTfvdBlockGreenProvenance
              M kappa omega pair
                (finiteC3EnrichedTfvdPairTransport
                  M kappa omega directParameter pair)
                (finiteC3EnrichedTfvdPairTransport
                  M kappa omega reflectedParameter reflectedPair) m).total) := by
      apply Finset.sum_congr rfl
      intro m _hm
      dsimp only [finiteC3EnrichedTfvdPairTransport]
      unfold enrichedTfvdSameSBoundaryCells TfvdSameSBoundaryCells.total
        finiteC3EnrichedTfvdBlockGreenProvenance
        TfvdSameSGreenProvenanceChannels.total
        sameSEdgeBoundaryWedge tfvdPairGreenLegChannels
        TfvdSameSGreenLegChannels.total finiteC3GreenPortEdge
      dsimp only
      ring
    _ =
        (∑ m : Fin M,
          (finiteC3GreenPortEdge
                (finiteC3EnrichedTfvdPairTransport
                  M kappa omega directParameter pair).greenPort
                (finiteC3EnrichedTfvdPairTransport
                  M kappa omega reflectedParameter reflectedPair).greenPort
                (finProdFinEquiv (m, 0)) +
            finiteC3GreenPortEdge
                (finiteC3EnrichedTfvdPairTransport
                  M kappa omega directParameter pair).greenPort
                (finiteC3EnrichedTfvdPairTransport
                  M kappa omega reflectedParameter reflectedPair).greenPort
                (finProdFinEquiv (m, 1)) +
            finiteC3GreenPortEdge
                (finiteC3EnrichedTfvdPairTransport
                  M kappa omega directParameter pair).greenPort
                (finiteC3EnrichedTfvdPairTransport
                  M kappa omega reflectedParameter reflectedPair).greenPort
                (finProdFinEquiv (m, 2)))) +
          ∑ m : Fin M,
            (finiteC3EnrichedTfvdBlockGreenProvenance
              M kappa omega pair
                (finiteC3EnrichedTfvdPairTransport
                  M kappa omega directParameter pair)
                (finiteC3EnrichedTfvdPairTransport
                  M kappa omega reflectedParameter reflectedPair) m).total := by
      rw [Finset.sum_add_distrib]

/-- Canonical mixed enriched pair: the value port comes from `w`, while the
log-jet port comes from `z`. -/
def canonicalMixedBoundaryResidualPair
    (kappa : ℂ) (omega : ℕ → ℂ) (z w : ℂ) :
    EnrichedTfvdValueLogJetPair :=
  {
    value := (canonicalBoundaryResidualPair kappa omega w).value
    logJet := (canonicalBoundaryResidualPair kappa omega z).logJet
  }

/-- Actual flattened local legs of the mixed canonical pair. -/
def canonicalMixedBoundaryResidualLegs
    (M : ℕ) (kappa : ℂ) (omega : ℕ → ℂ) (z w : ℂ) :
    ReflectedBoundarySynthesisData (Fin M × Fin 2) :=
  let pair := canonicalMixedBoundaryResidualPair kappa omega z w
  {
    left := enrichedTfvdBoundaryEdgeLeft M kappa omega pair
    right := enrichedTfvdBoundaryEdgeRight M kappa omega pair
    jetLeft := enrichedTfvdBoundaryEdgeJetLeft M kappa omega pair
    jetRight := enrichedTfvdBoundaryEdgeJetRight M kappa omega pair
  }

/-- Green-leg provenance of the mixed pair, retained block by block. -/
def canonicalMixedBoundaryGreenProvenance
    (M : ℕ) (kappa : ℂ) (omega : ℕ → ℂ) (z w : ℂ) : ℂ :=
  let pair := canonicalMixedBoundaryResidualPair kappa omega z w
  let direct := finiteC3EnrichedTfvdPairTransport M kappa omega w pair
  let reflectedPair := canonicalBoundaryResidualPair
    kappa omega (reflectedParameter z)
  let reflected := finiteC3EnrichedTfvdPairTransport
    M kappa omega (reflectedParameter z) reflectedPair
  finiteC3EnrichedTfvdPairGreenProvenance
    M kappa omega pair direct reflected

/-- Ordered cross-coordinate provenance of the mixed local legs. -/
def canonicalMixedBoundaryCrossProvenance
    (M : ℕ) (kappa : ℂ) (omega : ℕ → ℂ) (z w : ℂ) : ℂ :=
  let legs := canonicalMixedBoundaryResidualLegs M kappa omega z w
  twoLegBoundaryCrossProvenance
    legs.left legs.right legs.jetLeft legs.jetRight

/-- Four mixed scalar-readout residuals, kept as their exact bilinear
correction. -/
def canonicalMixedBoundaryReadoutResidualCorrection
    (M : ℕ) (kappa : ℂ) (omega : ℕ → ℂ) (z w : ℂ) : ℂ :=
  let dataZ := canonicalBoundaryResidualData M kappa omega z
  let dataW := canonicalBoundaryResidualData M kappa omega w
  let legs := canonicalMixedBoundaryResidualLegs M kappa omega z w
  mixedBoundaryResidualCorrection
    dataZ.valueReadout dataZ.logJetReadout
    dataW.valueReadout dataW.logJetReadout legs

/-- Sum of the three independently constructed mixed finite defect channels. -/
def canonicalMixedBoundaryStructuralDefect
    (M : ℕ) (kappa : ℂ) (omega : ℕ → ℂ) (z w : ℂ) : ℂ :=
  canonicalMixedBoundaryGreenProvenance M kappa omega z w +
    canonicalMixedBoundaryCrossProvenance M kappa omega z w +
    canonicalMixedBoundaryReadoutResidualCorrection M kappa omega z w

/-- Exact finite mixed Green--Wronskian decomposition.  The first Green port
is read at `w`; the second is read at `reflectedParameter z`, which recovers
the existing same-state ledger when `w = z`. -/
theorem canonicalMixedEnrichedScalarBoundary_eq_green_add_explicitDefects
    (M : ℕ) {kappa : ℂ} (hkappa : kappa ≠ 0)
    (omega : ℕ → ℂ) (homega : ∀ m, omega m ≠ 0) (z w : ℂ) :
    mixedScalarBoundaryWedge
        (canonicalBoundaryResidualData M kappa omega z).valueReadout
        (canonicalBoundaryResidualData M kappa omega z).logJetReadout
        (canonicalBoundaryResidualData M kappa omega w).valueReadout
        (canonicalBoundaryResidualData M kappa omega w).logJetReadout =
      greenForm (𝕜 := ℂ)
          (finiteC3GenuineBracketGreenBoundaryPair (3 * M) w)
          (finiteC3GenuineBracketGreenBoundaryPair
            (3 * M) (reflectedParameter z)) +
        canonicalMixedBoundaryStructuralDefect M kappa omega z w := by
  let pair := canonicalMixedBoundaryResidualPair kappa omega z w
  let direct := finiteC3EnrichedTfvdPairTransport M kappa omega w pair
  let reflectedPair := canonicalBoundaryResidualPair
    kappa omega (reflectedParameter z)
  let reflected := finiteC3EnrichedTfvdPairTransport
    M kappa omega (reflectedParameter z) reflectedPair
  let legs := canonicalMixedBoundaryResidualLegs M kappa omega z w
  have hlocal :
      (∑ mr : Fin M × Fin 2,
        sameSEdgeBoundaryWedge
          (legs.left mr) (legs.right mr)
          (legs.jetLeft mr) (legs.jetRight mr)) =
        finiteC3EnrichedTfvdPairBoundaryForm M direct := by
    simpa [pair, direct, legs, canonicalMixedBoundaryResidualPair,
      canonicalMixedBoundaryResidualLegs] using
      (sum_enrichedTfvdBoundaryEdges_eq_pairBoundaryForm
        M kappa omega w pair)
  have htrace :=
    mixedScalarBoundaryWedge_eq_localTwoLeg_add_cross_add_residualCorrection
      (canonicalBoundaryResidualData M kappa omega z).valueReadout
      (canonicalBoundaryResidualData M kappa omega z).logJetReadout
      (canonicalBoundaryResidualData M kappa omega w).valueReadout
      (canonicalBoundaryResidualData M kappa omega w).logJetReadout legs
  rw [hlocal] at htrace
  have hgreen :=
    finiteC3EnrichedTfvdPairBoundary_eq_greenForm_add_provenance_twoParameter
      M kappa omega w (reflectedParameter z) pair reflectedPair
  dsimp only at hgreen
  change finiteC3EnrichedTfvdPairBoundaryForm M direct =
      greenForm direct.greenPort reflected.greenPort +
        finiteC3EnrichedTfvdPairGreenProvenance
          M kappa omega pair direct reflected at hgreen
  have hdirectPort :
      direct.greenPort =
        finiteC3GenuineBracketGreenBoundaryPair (M * 3) w := by
    simpa [direct, pair, canonicalMixedBoundaryResidualPair,
      canonicalBoundaryResidualPair,
      canonicalEnrichedTfvdValueLogJetPair,
      finiteC3EnrichedTfvdPairTransport] using
      (finiteC3EnrichedTfvdValueGreenPort_canonical
        M hkappa omega homega w)
  have hreflectedPort :
      reflected.greenPort =
        finiteC3GenuineBracketGreenBoundaryPair
          (M * 3) (reflectedParameter z) := by
    simpa [reflected, reflectedPair, canonicalBoundaryResidualPair,
      canonicalEnrichedTfvdValueLogJetPair,
      finiteC3EnrichedTfvdPairTransport] using
      (finiteC3EnrichedTfvdValueGreenPort_canonical
        M hkappa omega homega (reflectedParameter z))
  rw [htrace, hgreen, hdirectPort, hreflectedPort]
  unfold canonicalMixedBoundaryStructuralDefect
    canonicalMixedBoundaryGreenProvenance
    canonicalMixedBoundaryCrossProvenance
    canonicalMixedBoundaryReadoutResidualCorrection
  dsimp only [pair, direct, reflectedPair, reflected, legs]
  rw [Nat.mul_comm M 3]
  ring

/-! ## Explicit head--tail completion correction -/

/-- All terms introduced when independent value/companion tails are added to
the four coordinates of a mixed Wronskian. -/
def mixedBoundaryCompletionCorrection
    (valueZ companionZ valueW companionW : ℂ)
    (valueTailZ companionTailZ valueTailW companionTailW : ℂ) : ℂ :=
  companionZ * (starRingEnd ℂ) valueTailW +
    companionTailZ * (starRingEnd ℂ) valueW +
    companionTailZ * (starRingEnd ℂ) valueTailW -
    valueZ * (starRingEnd ℂ) companionTailW -
    valueTailZ * (starRingEnd ℂ) companionW -
    valueTailZ * (starRingEnd ℂ) companionTailW

theorem mixedScalarBoundaryWedge_add_tails
    (valueZ companionZ valueW companionW : ℂ)
    (valueTailZ companionTailZ valueTailW companionTailW : ℂ) :
    mixedScalarBoundaryWedge
        (valueZ + valueTailZ) (companionZ + companionTailZ)
        (valueW + valueTailW) (companionW + companionTailW) =
      mixedScalarBoundaryWedge valueZ companionZ valueW companionW +
        mixedBoundaryCompletionCorrection
          valueZ companionZ valueW companionW
          valueTailZ companionTailZ valueTailW companionTailW := by
  simp only [mixedScalarBoundaryWedge, mixedBoundaryCompletionCorrection,
    map_add]
  ring

/-- The logarithmic bracket blocks form a summable series in the open
critical strip. -/
theorem summable_canonicalLogBracketBlock
    {s : ℂ} (hs : 0 < s.re) :
    Summable (fun m : ℕ => canonicalLogBracketBlock m s) := by
  have hgradient :
      Summable (fun n : ℕ => positiveLogDirichletGradient s n) :=
    (summable_norm_positiveLogDirichletGradient hs).of_norm
  have hleft := hgradient.comp_injective
    (show Function.Injective (fun m : ℕ => 3 * m + 1) by
      intro a b hab
      exact Nat.mul_left_cancel (by norm_num) (Nat.add_right_cancel hab))
  have hright := hgradient.comp_injective
    (show Function.Injective (fun m : ℕ => 3 * m + 2) by
      intro a b hab
      exact Nat.mul_left_cancel (by norm_num) (Nat.add_right_cancel hab))
  have hsub := hright.sub hleft
  apply hsub.congr
  intro m
  simp [canonicalLogBracketBlock, positiveLogDirichletGradient]
  ring

/-- The independently defined logarithmic tail vanishes with the cutoff. -/
theorem canonicalC3LogJetCutoffTail_tendsto_zero
    {s : ℂ} (hs : 0 < s.re) :
    Tendsto (fun M : ℕ => canonicalC3LogJetCutoffTail M s)
      atTop (nhds 0) := by
  let f : ℕ → ℂ := fun m => canonicalLogBracketBlock m s
  have hsum : Summable f := summable_canonicalLogBracketBlock hs
  have hpartial := hsum.tendsto_sum_tsum_nat
  have hconstant : Tendsto (fun _ : ℕ => ∑' m : ℕ, f m)
      atTop (nhds (∑' m : ℕ, f m)) := tendsto_const_nhds
  have htail := hconstant.sub hpartial
  have htailEq : ∀ M : ℕ,
      canonicalC3LogJetCutoffTail M s =
        (∑' m : ℕ, f m) - ∑ m ∈ Finset.range M, f m := by
    intro M
    have hsplit := hsum.sum_add_tsum_nat_add M
    unfold canonicalC3LogJetCutoffTail f
    linear_combination hsplit
  simpa only [htailEq, sub_self] using htail

/-- Explicit mixed correction between the finite bracket head and its two
independent completed tails. -/
def canonicalC3MixedTailCompletionDefect
    (M : ℕ) (z w : ℂ) : ℂ :=
  mixedBoundaryCompletionCorrection
    (finiteBracketedDirichletChart 3 M z)
    (finiteCanonicalLogBracketChart M z)
    (finiteBracketedDirichletChart 3 M w)
    (finiteCanonicalLogBracketChart M w)
    (realCpBracketCutoffTail 3 M z)
    (canonicalC3LogJetCutoffTail M z)
    (realCpBracketCutoffTail 3 M w)
    (canonicalC3LogJetCutoffTail M w)

/-- The mixed head--tail correction vanishes on the product of two open
critical strips.  No Green identity or zero hypothesis is used. -/
theorem canonicalC3MixedTailCompletionDefect_tendsto_zero
    {z w : ℂ} (hz : 0 < z.re) (hw : 0 < w.re) :
    Tendsto (fun M : ℕ => canonicalC3MixedTailCompletionDefect M z w)
      atTop (nhds 0) := by
  have hzValue := finiteBracketedDirichletChart_tendsto
    3 (by norm_num) (s := z) (by linarith)
  have hwValue := finiteBracketedDirichletChart_tendsto
    3 (by norm_num) (s := w) (by linarith)
  have hzValueTail := realCpBracketCutoffTail_tendsto_zero
    3 (by norm_num) (s := z) (by linarith)
  have hwValueTail := realCpBracketCutoffTail_tendsto_zero
    3 (by norm_num) (s := w) (by linarith)
  have hzCompanionTail := canonicalC3LogJetCutoffTail_tendsto_zero hz
  have hwCompanionTail := canonicalC3LogJetCutoffTail_tendsto_zero hw
  let companionZ : ℂ := canonicalCompletedC3EnrichedTfvdLogJetTailReadout z
  let companionW : ℂ := canonicalCompletedC3EnrichedTfvdLogJetTailReadout w
  have hzCompanion :
      Tendsto (fun M : ℕ => finiteCanonicalLogBracketChart M z)
        atTop (nhds companionZ) := by
    have hconstant : Tendsto (fun _ : ℕ => companionZ)
        atTop (nhds companionZ) := tendsto_const_nhds
    have hsub :
        Tendsto
          (fun M : ℕ => companionZ - canonicalC3LogJetCutoffTail M z)
          atTop (nhds companionZ) := by
      simpa using hconstant.sub hzCompanionTail
    refine hsub.congr' (Eventually.of_forall fun M => ?_)
    have hfull :=
      canonicalCompletedC3FiniteEnrichedTfvdLogJetTailReadout_eq_completed
        M (s := z) (by change -1 < z.re; linarith)
    change companionZ - canonicalC3LogJetCutoffTail M z =
      finiteCanonicalLogBracketChart M z
    unfold companionZ at hfull ⊢
    unfold canonicalCompletedC3FiniteEnrichedTfvdLogJetTailReadout at hfull
    exact (eq_sub_of_add_eq hfull).symm
  have hwCompanion :
      Tendsto (fun M : ℕ => finiteCanonicalLogBracketChart M w)
        atTop (nhds companionW) := by
    have hconstant : Tendsto (fun _ : ℕ => companionW)
        atTop (nhds companionW) := tendsto_const_nhds
    have hsub :
        Tendsto
          (fun M : ℕ => companionW - canonicalC3LogJetCutoffTail M w)
          atTop (nhds companionW) := by
      simpa using hconstant.sub hwCompanionTail
    refine hsub.congr' (Eventually.of_forall fun M => ?_)
    have hfull :=
      canonicalCompletedC3FiniteEnrichedTfvdLogJetTailReadout_eq_completed
        M (s := w) (by change -1 < w.re; linarith)
    change companionW - canonicalC3LogJetCutoffTail M w =
      finiteCanonicalLogBracketChart M w
    unfold companionW at hfull ⊢
    unfold canonicalCompletedC3FiniteEnrichedTfvdLogJetTailReadout at hfull
    exact (eq_sub_of_add_eq hfull).symm
  unfold canonicalC3MixedTailCompletionDefect
    mixedBoundaryCompletionCorrection
  have h1 : Tendsto
      (fun M : ℕ =>
        finiteCanonicalLogBracketChart M z *
          (starRingEnd ℂ) (realCpBracketCutoffTail 3 M w))
      atTop (nhds 0) := by
    simpa using hzCompanion.mul hwValueTail.star
  have h2 : Tendsto
      (fun M : ℕ =>
        canonicalC3LogJetCutoffTail M z *
          (starRingEnd ℂ) (finiteBracketedDirichletChart 3 M w))
      atTop (nhds 0) := by
    simpa using hzCompanionTail.mul hwValue.star
  have h3 : Tendsto
      (fun M : ℕ =>
        canonicalC3LogJetCutoffTail M z *
          (starRingEnd ℂ) (realCpBracketCutoffTail 3 M w))
      atTop (nhds 0) := by
    simpa using hzCompanionTail.mul hwValueTail.star
  have h4 : Tendsto
      (fun M : ℕ =>
        finiteBracketedDirichletChart 3 M z *
          (starRingEnd ℂ) (canonicalC3LogJetCutoffTail M w))
      atTop (nhds 0) := by
    simpa using hzValue.mul hwCompanionTail.star
  have h5 : Tendsto
      (fun M : ℕ =>
        realCpBracketCutoffTail 3 M z *
          (starRingEnd ℂ) (finiteCanonicalLogBracketChart M w))
      atTop (nhds 0) := by
    simpa using hzValueTail.mul hwCompanion.star
  have h6 : Tendsto
      (fun M : ℕ =>
        realCpBracketCutoffTail 3 M z *
          (starRingEnd ℂ) (canonicalC3LogJetCutoffTail M w))
      atTop (nhds 0) := by
    simpa using hzValueTail.mul hwCompanionTail.star
  simpa using (((h1.add h2).add h3).sub h4).sub h5 |>.sub h6

/-! ## Completed mixed ledger limit -/

/-- Canonical specialization of the finite mixed structural defect. -/
def canonicalC3FiniteMixedStructuralDefect
    (M : ℕ) (z w : ℂ) : ℂ :=
  canonicalMixedBoundaryStructuralDefect
    M tfvdHaarScale (fun _ : ℕ => (1 : ℂ)) z w

/-- Raw tail-completed bracket Wronskian.  This is prior to the xi and chart
factor product completion. -/
def canonicalCompletedC3RawMixedWronskian (z w : ℂ) : ℂ :=
  mixedScalarBoundaryWedge
    (bracketedDirichletChart 3 z)
    (canonicalCompletedC3EnrichedTfvdLogJetTailReadout z)
    (bracketedDirichletChart 3 w)
    (canonicalCompletedC3EnrichedTfvdLogJetTailReadout w)

/-- At every cutoff, the completed raw mixed Wronskian is its finite head plus
the independently expanded tail correction. -/
theorem canonicalCompletedC3RawMixedWronskian_eq_head_add_tailDefect
    (M : ℕ) {z w : ℂ} (hz : -1 < z.re) (hw : -1 < w.re) :
    canonicalCompletedC3RawMixedWronskian z w =
      mixedScalarBoundaryWedge
          (finiteBracketedDirichletChart 3 M z)
          (finiteCanonicalLogBracketChart M z)
          (finiteBracketedDirichletChart 3 M w)
          (finiteCanonicalLogBracketChart M w) +
        canonicalC3MixedTailCompletionDefect M z w := by
  have hzValue := bracketedDirichletChart_eq_finite_add_cutoffTail
    3 M (by norm_num) hz
  have hwValue := bracketedDirichletChart_eq_finite_add_cutoffTail
    3 M (by norm_num) hw
  have hzCompanion :=
    canonicalCompletedC3FiniteEnrichedTfvdLogJetTailReadout_eq_completed
      M (s := z) (by simpa [bracketHalfPlane] using hz)
  have hwCompanion :=
    canonicalCompletedC3FiniteEnrichedTfvdLogJetTailReadout_eq_completed
      M (s := w) (by simpa [bracketHalfPlane] using hw)
  unfold canonicalCompletedC3RawMixedWronskian
    canonicalC3MixedTailCompletionDefect
    canonicalCompletedC3FiniteEnrichedTfvdLogJetTailReadout at *
  rw [hzValue, hwValue, ← hzCompanion, ← hwCompanion]
  exact mixedScalarBoundaryWedge_add_tails _ _ _ _ _ _ _ _

/-- Canonical finite head decomposition in the two independent parameters. -/
theorem canonicalC3FiniteMixedHeadWronskian_eq_green_add_structuralDefect
    (M : ℕ) (z w : ℂ) :
    mixedScalarBoundaryWedge
        (finiteBracketedDirichletChart 3 M z)
        (finiteCanonicalLogBracketChart M z)
        (finiteBracketedDirichletChart 3 M w)
        (finiteCanonicalLogBracketChart M w) =
      greenForm (𝕜 := ℂ)
          (finiteC3GenuineBracketGreenBoundaryPair (3 * M) w)
          (finiteC3GenuineBracketGreenBoundaryPair
            (3 * M) (reflectedParameter z)) +
        canonicalC3FiniteMixedStructuralDefect M z w := by
  have hmixed :=
    canonicalMixedEnrichedScalarBoundary_eq_green_add_explicitDefects
      M tfvdHaarScale_ne_zero (fun _ : ℕ => (1 : ℂ))
      (by intro m; norm_num) z w
  have hzTransport := finiteC3EnrichedTfvdPairTransport_canonical
    M tfvdHaarScale_ne_zero (fun _ : ℕ => (1 : ℂ))
      (by intro m; norm_num) z
  have hwTransport := finiteC3EnrichedTfvdPairTransport_canonical
    M tfvdHaarScale_ne_zero (fun _ : ℕ => (1 : ℂ))
      (by intro m; norm_num) w
  dsimp only at hzTransport hwTransport
  change mixedScalarBoundaryWedge
      (canonicalBoundaryResidualData M tfvdHaarScale
        (fun _ : ℕ => (1 : ℂ)) z).valueReadout
      (canonicalBoundaryResidualData M tfvdHaarScale
        (fun _ : ℕ => (1 : ℂ)) z).logJetReadout
      (canonicalBoundaryResidualData M tfvdHaarScale
        (fun _ : ℕ => (1 : ℂ)) w).valueReadout
      (canonicalBoundaryResidualData M tfvdHaarScale
        (fun _ : ℕ => (1 : ℂ)) w).logJetReadout = _ at hmixed
  have hzValue :
      (canonicalBoundaryResidualData M tfvdHaarScale
        (fun _ : ℕ => (1 : ℂ)) z).valueReadout =
          finiteBracketedDirichletChart 3 M z := by
    simpa [canonicalBoundaryResidualData, canonicalBoundaryResidualPair]
      using hzTransport.1
  have hzLog :
      (canonicalBoundaryResidualData M tfvdHaarScale
        (fun _ : ℕ => (1 : ℂ)) z).logJetReadout =
          finiteCanonicalLogBracketChart M z := by
    simpa [canonicalBoundaryResidualData, canonicalBoundaryResidualPair]
      using hzTransport.2.1
  have hwValue :
      (canonicalBoundaryResidualData M tfvdHaarScale
        (fun _ : ℕ => (1 : ℂ)) w).valueReadout =
          finiteBracketedDirichletChart 3 M w := by
    simpa [canonicalBoundaryResidualData, canonicalBoundaryResidualPair]
      using hwTransport.1
  have hwLog :
      (canonicalBoundaryResidualData M tfvdHaarScale
        (fun _ : ℕ => (1 : ℂ)) w).logJetReadout =
          finiteCanonicalLogBracketChart M w := by
    simpa [canonicalBoundaryResidualData, canonicalBoundaryResidualPair]
      using hwTransport.2.1
  rw [hzValue, hzLog, hwValue, hwLog] at hmixed
  simpa [canonicalC3FiniteMixedStructuralDefect] using hmixed

/-- Radial coefficient of the mixed Genuine C3 Green ports. -/
def canonicalC3MixedRadialCoefficient (z w : ℂ) : ℂ :=
  (((3 : ℝ) ^
      (-criticalDisplacement (reflectedParameter z).re) : ℝ) : ℂ) -
    (((3 : ℝ) ^ (-criticalDisplacement w.re) : ℝ) : ℂ)

/-- The finite two-parameter Genuine Green form is a mixed radial coefficient
times the ordinary finite C3 Gram kernel. -/
theorem greenForm_finiteC3GenuineBracket_twoParameter_eq_coefficient_mul_gram
    (M : ℕ) (z w : ℂ) :
    greenForm (𝕜 := ℂ)
        (finiteC3GenuineBracketGreenBoundaryPair M w)
        (finiteC3GenuineBracketGreenBoundaryPair M (reflectedParameter z)) =
      canonicalC3MixedRadialCoefficient z w *
        c3RawGammaGram M w (reflectedParameter z) := by
  rw [greenForm_eq_sum_finiteC3GreenPortEdge,
    Finset.sum_fin_eq_sum_range]
  unfold c3RawGammaGram
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro n hn
  have hnlt : n < M := Finset.mem_range.mp hn
  simp only [hnlt, ↓reduceDIte]
  let i : Fin M := ⟨n, hnlt⟩
  change finiteC3GreenPortEdge
      (finiteC3GenuineBracketGreenBoundaryPair M w)
      (finiteC3GenuineBracketGreenBoundaryPair M (reflectedParameter z)) i = _
  unfold finiteC3GreenPortEdge
  rw [finiteC3GenuineBracketGreenBoundaryPair_snd_eq_completedPrefix,
    finiteC3GenuineBracketGreenBoundaryPair_fst_eq_radial_mul_completedPrefix,
    finiteC3GenuineBracketGreenBoundaryPair_snd_eq_completedPrefix,
    finiteC3GenuineBracketGreenBoundaryPair_fst_eq_radial_mul_completedPrefix]
  simp only [canonicalCompletedC3DirichletGradientPrefixState_apply,
    i.isLt, ↓reduceIte]
  unfold canonicalC3MixedRadialCoefficient
  simp only [map_mul]
  simp
  ring

/-- Completed mixed radial Green kernel generated by the all-cutoff ordinary
states. -/
def canonicalCompletedC3MixedRadialGreenKernel
    (z w : ℂ) (hw : 0 < w.re)
    (hzReflected : 0 < (reflectedParameter z).re) : ℂ :=
  canonicalC3MixedRadialCoefficient z w *
    canonicalCompletedC3RawGammaGram
      w (reflectedParameter z) hw hzReflected

theorem finiteC3MixedRadialGreen_tendsto_completed
    {z w : ℂ} (hw : 0 < w.re)
    (hzReflected : 0 < (reflectedParameter z).re) :
    Tendsto
      (fun M : ℕ =>
        greenForm (𝕜 := ℂ)
          (finiteC3GenuineBracketGreenBoundaryPair (3 * M) w)
          (finiteC3GenuineBracketGreenBoundaryPair
            (3 * M) (reflectedParameter z)))
      atTop
      (nhds
        (canonicalCompletedC3MixedRadialGreenKernel
          z w hw hzReflected)) := by
  have hgram :=
    (c3RawGammaGram_tendsto_completed hw hzReflected).comp
      tendsto_three_mul_atTop
  have hscaled := hgram.const_mul (canonicalC3MixedRadialCoefficient z w)
  exact hscaled.congr' (Eventually.of_forall fun M =>
    (greenForm_finiteC3GenuineBracket_twoParameter_eq_coefficient_mul_gram
      (3 * M) z w).symm)

/-- Complete mixed defect ledger: local Green provenance, ordered cross
provenance, scalar synthesis residuals, and the independent tail correction. -/
def canonicalC3FiniteMixedTotalDefect
    (M : ℕ) (z w : ℂ) : ℂ :=
  canonicalC3FiniteMixedStructuralDefect M z w +
    canonicalC3MixedTailCompletionDefect M z w

/-- Exact finite sewing formula for the completed raw mixed Wronskian. -/
theorem canonicalCompletedC3RawMixedWronskian_eq_green_add_totalDefect
    (M : ℕ) {z w : ℂ} (hz : -1 < z.re) (hw : -1 < w.re) :
    canonicalCompletedC3RawMixedWronskian z w =
      greenForm (𝕜 := ℂ)
          (finiteC3GenuineBracketGreenBoundaryPair (3 * M) w)
          (finiteC3GenuineBracketGreenBoundaryPair
            (3 * M) (reflectedParameter z)) +
        canonicalC3FiniteMixedTotalDefect M z w := by
  rw [canonicalCompletedC3RawMixedWronskian_eq_head_add_tailDefect
      M hz hw,
    canonicalC3FiniteMixedHeadWronskian_eq_green_add_structuralDefect]
  unfold canonicalC3FiniteMixedTotalDefect
  ring

theorem canonicalC3FiniteMixedTotalDefect_eq_wronskian_sub_green
    (M : ℕ) {z w : ℂ} (hz : -1 < z.re) (hw : -1 < w.re) :
    canonicalC3FiniteMixedTotalDefect M z w =
      canonicalCompletedC3RawMixedWronskian z w -
        greenForm (𝕜 := ℂ)
          (finiteC3GenuineBracketGreenBoundaryPair (3 * M) w)
          (finiteC3GenuineBracketGreenBoundaryPair
            (3 * M) (reflectedParameter z)) := by
  have hsewing :=
    canonicalCompletedC3RawMixedWronskian_eq_green_add_totalDefect
      M hz hw
  rw [hsewing]
  ring

/-- Completion computes the exact limit of the mixed total defect.  Its
vanishing is not inserted: the limit remains `Wronskian - Green`. -/
theorem canonicalC3FiniteMixedTotalDefect_tendsto
    {z w : ℂ} (hz : 0 < z.re) (hzUpper : z.re < 1)
    (hw : 0 < w.re) :
    Tendsto (fun M : ℕ => canonicalC3FiniteMixedTotalDefect M z w)
      atTop
      (nhds
        (canonicalCompletedC3RawMixedWronskian z w -
          canonicalCompletedC3MixedRadialGreenKernel z w hw
            (by simpa [reflectedParameter] using sub_pos.mpr hzUpper))) := by
  have hzReflected : 0 < (reflectedParameter z).re := by
    simpa [reflectedParameter] using sub_pos.mpr hzUpper
  have hgreen := finiteC3MixedRadialGreen_tendsto_completed hw hzReflected
  have hconstant : Tendsto
      (fun _ : ℕ => canonicalCompletedC3RawMixedWronskian z w)
      atTop (nhds (canonicalCompletedC3RawMixedWronskian z w)) :=
    tendsto_const_nhds
  have hsub := hconstant.sub hgreen
  exact hsub.congr' (Eventually.of_forall fun M => by
    exact (canonicalC3FiniteMixedTotalDefect_eq_wronskian_sub_green
      M (by linarith) (by linarith)).symm)

/-- The mixed defect disappears in completion exactly when the missing raw
Green--Wronskian kernel identity is proved. -/
theorem canonicalC3FiniteMixedTotalDefect_tendsto_zero_iff
    {z w : ℂ} (hz : 0 < z.re) (hzUpper : z.re < 1)
    (hw : 0 < w.re) :
    Tendsto (fun M : ℕ => canonicalC3FiniteMixedTotalDefect M z w)
        atTop (nhds 0) ↔
      canonicalCompletedC3RawMixedWronskian z w =
        canonicalCompletedC3MixedRadialGreenKernel z w hw
          (by simpa [reflectedParameter] using sub_pos.mpr hzUpper) := by
  let hzReflected : 0 < (reflectedParameter z).re := by
    simpa [reflectedParameter] using sub_pos.mpr hzUpper
  have hlimit := canonicalC3FiniteMixedTotalDefect_tendsto
    hz hzUpper hw
  constructor
  · intro hzero
    exact sub_eq_zero.mp (tendsto_nhds_unique hlimit hzero)
  · intro hidentity
    rw [hidentity] at hlimit
    simpa using hlimit

/-! ## The raw coefficient obstruction survives completion -/

/-- Difference between centered spectral and raw camera coefficients, acting
on the independently constructed finite C3 Gram kernel. -/
def c3RawToCenteredMixedCoefficientDefect
    (M : ℕ) (r s : ℂ) : ℂ :=
  ((centeredHeightParameter s -
        (starRingEnd ℂ) (centeredHeightParameter r)) -
      (c3RawCameraEigenvalue s -
        (starRingEnd ℂ) (c3RawCameraEigenvalue r))) *
    c3RawGammaGram M r s

theorem c3RawToCenteredMixedCoefficientDefect_tendsto
    {r s : ℂ} (hr : 0 < r.re) (hs : 0 < s.re) :
    Tendsto
      (fun M : ℕ => c3RawToCenteredMixedCoefficientDefect M r s)
      atTop
      (nhds
        (((centeredHeightParameter s -
              (starRingEnd ℂ) (centeredHeightParameter r)) -
            (c3RawCameraEigenvalue s -
              (starRingEnd ℂ) (c3RawCameraEigenvalue r))) *
          canonicalCompletedC3RawGammaGram r s hr hs)) := by
  exact (c3RawGammaGram_tendsto_completed hr hs).const_mul _

/-- At `1/4` the raw-to-centered mixed coefficient defect has a nonzero
completed limit. -/
theorem c3RawToCenteredMixedCoefficientDefect_quarter_limit_ne_zero :
    (((centeredHeightParameter (1 / 4 : ℂ) -
            (starRingEnd ℂ) (centeredHeightParameter (1 / 4 : ℂ))) -
          (c3RawCameraEigenvalue (1 / 4 : ℂ) -
            (starRingEnd ℂ) (c3RawCameraEigenvalue (1 / 4 : ℂ)))) *
        canonicalCompletedC3RawGammaGram
          (1 / 4 : ℂ) (1 / 4 : ℂ) (by norm_num) (by norm_num)) ≠ 0 := by
  rw [c3RawCameraCoefficient_quarter_eq_zero, sub_zero]
  exact centeredHeightCoefficient_mul_rawGammaGram_quarter_ne_zero

/-- Consequently the naive mixed coefficient defect does not disappear in
the Hilbert completion. -/
theorem c3RawToCenteredMixedCoefficientDefect_quarter_not_tendsto_zero :
    ¬ Tendsto
      (fun M : ℕ =>
        c3RawToCenteredMixedCoefficientDefect
          M (1 / 4 : ℂ) (1 / 4 : ℂ))
      atTop (nhds 0) := by
  intro hzero
  have hlimit := c3RawToCenteredMixedCoefficientDefect_tendsto
    (r := (1 / 4 : ℂ)) (s := (1 / 4 : ℂ)) (by norm_num) (by norm_num)
  have heq := tendsto_nhds_unique hlimit hzero
  exact c3RawToCenteredMixedCoefficientDefect_quarter_limit_ne_zero heq

end

