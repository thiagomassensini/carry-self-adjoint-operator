import CarrySelfAdjointOperator.BR2BracketTfvdIndependence
import CarrySelfAdjointOperator.BR2IncidenceStrictPositivity
import Mathlib.Tactic

/-!
# Global bracket-incidence transport into the exact TFVD carrier

This file constructs the all-order transport already justified before the
completed Green Taylor readout.  Real bracket incidences are complexified,
inserted faithfully into vertical `ell^2`, and passed through the enriched
TFVD analysis, whose exact reconstruction makes the composite injective.
-/

namespace CarrySelfAdjointOperator

open CPFormal.Analytic.Cp
open FiniteNativeCarryOperator.Camera
open NativeCarrySpectralWeyl.Camera
open scoped lp

noncomputable section

/-- Coordinatewise inclusion of a real finite incidence ledger into the
complex native edge core. -/
def br2RealIncidenceComplexification :
    (ℕ →₀ ℝ) →ₗ[ℝ] NativeGpreComplexEdgeCore :=
  Finsupp.mapRange.linearMap Complex.ofRealCLM.toLinearMap

@[simp] theorem br2RealIncidenceComplexification_apply
    (x : ℕ →₀ ℝ) (n : ℕ) :
    br2RealIncidenceComplexification x n = (x n : ℂ) := by
  rfl

/-- Complexification preserves every coordinate of the real incidence
ledger. -/
theorem br2RealIncidenceComplexification_injective :
    Function.Injective br2RealIncidenceComplexification := by
  intro x y hxy
  apply Finsupp.ext
  intro n
  have hcoord := congrArg (fun z : NativeGpreComplexEdgeCore ↦ z n) hxy
  exact Complex.ofReal_injective hcoord

@[simp] theorem nativeGpreCanonicalVerticalRealization_complexified_single
    (index : ℕ) (value : ℝ) :
    nativeGpreCanonicalVerticalRealization
        (br2RealIncidenceComplexification (Finsupp.single index value)) =
      lp.single 2 index (value : ℂ) := by
  classical
  ext n
  by_cases h : n = index
  · subst n
    simp
  · simp [h]

/-- The canonical finite-support realization sends the all-base incidence
ledger to the literal three-cell bracket state in vertical `ell^2`. -/
theorem nativeGpreCanonicalVerticalRealization_cameraBracketIncidence
    (base radius index : ℕ) :
    nativeGpreCanonicalVerticalRealization
        (br2RealIncidenceComplexification
          (cameraBracketIncidence base radius index)) =
      br2CameraBracketVerticalState base radius index := by
  simp [br2CameraBracketVerticalState, cameraBracketIncidence,
    cameraLeftLeg, cameraRightLeg]

/-- One real-linear map carrying the complete incidence ledger through the
canonical `ell^2` inclusion and the exact enriched TFVD analysis. -/
def br2CameraBracketTfvdAnalysisMap
    (q : ℝ) (S : Finset NativeGpreBoundaryContext) :
    (ℕ →₀ ℝ) →ₗ[ℝ] NativeGpreFiniteTfvdAnalysisCarrier S :=
  ((nativeGpreFiniteTfvdAnalysis q S).toLinearMap.restrictScalars ℝ).comp
    ((nativeGpreCanonicalVerticalRealization.restrictScalars ℝ).comp
      br2RealIncidenceComplexification)

@[simp] theorem br2CameraBracketTfvdAnalysisMap_cameraBracketIncidence
    (base radius index : ℕ)
    (q : ℝ) (S : Finset NativeGpreBoundaryContext) :
    br2CameraBracketTfvdAnalysisMap q S
        (cameraBracketIncidence base radius index) =
      nativeGpreFiniteTfvdAnalysis q S
        (br2CameraBracketVerticalState base radius index) := by
  simp [br2CameraBracketTfvdAnalysisMap,
    nativeGpreCanonicalVerticalRealization_cameraBracketIncidence]

/-- The global incidence-to-TFVD map is injective: complexification, the
canonical vertical realization, and TFVD analysis are all faithful. -/
theorem br2CameraBracketTfvdAnalysisMap_injective
    (q : ℝ) (hqpos : 0 < q) (hq1 : q < 1)
    (S : Finset NativeGpreBoundaryContext) :
    Function.Injective (br2CameraBracketTfvdAnalysisMap q S) := by
  exact (nativeGpreFiniteTfvdAnalysis_injective q hqpos hq1 S).comp
    (nativeGpreCanonicalVerticalRealization_injective.comp
      br2RealIncidenceComplexification_injective)

/-- Parity-interleaved all-order TFVD jet generated by the native bracket
incidences. -/
def br2CameraBracketTfvdParityJet
    (base radius : ℕ) (q : ℝ)
    (S : Finset NativeGpreBoundaryContext) :
    (ℕ ⊕ ℕ) → NativeGpreFiniteTfvdAnalysisCarrier S
  | Sum.inl n =>
      nativeGpreFiniteTfvdAnalysis q S
        (br2CameraBracketVerticalState base radius (2 * n))
  | Sum.inr n =>
      nativeGpreFiniteTfvdAnalysis q S
        (br2CameraBracketVerticalState base radius (2 * n + 1))

/-- The exact TFVD analysis supplies a genuine all-order incidence transport.
Its target is the faithful TFVD carrier, before identification with completed
normalized Green Taylor jets. -/
def br2CameraBracketTfvdIncidenceJetTransport
    (base radius : ℕ) (q : ℝ) (hqpos : 0 < q) (hq1 : q < 1)
    (S : Finset NativeGpreBoundaryContext) :
    BR2BracketIncidenceJetTransport base radius
      (br2CameraBracketTfvdParityJet base radius q S) where
  toLinearMap := br2CameraBracketTfvdAnalysisMap q S
  injective := br2CameraBracketTfvdAnalysisMap_injective q hqpos hq1 S
  even_eq n := by
    exact (br2CameraBracketTfvdAnalysisMap_cameraBracketIncidence
      base radius (2 * n) q S).symm
  odd_eq n := by
    exact (br2CameraBracketTfvdAnalysisMap_cameraBracketIncidence
      base radius (2 * n + 1) q S).symm

/-- The complete even TFVD jet family is independent, with no finite cutoff. -/
theorem br2CameraBracketTfvdParityJet_even_linearIndependent
    {base radius : ℕ}
    (hbase : IsSupported base)
    (hradius : radius ∈ radiusSet base)
    (q : ℝ) (hqpos : 0 < q) (hq1 : q < 1)
    (S : Finset NativeGpreBoundaryContext) :
    LinearIndependent ℝ
      (fun n : ℕ ↦
        br2CameraBracketTfvdParityJet base radius q S (Sum.inl n)) :=
  (br2CameraBracketTfvdIncidenceJetTransport
    base radius q hqpos hq1 S).even_linearIndependent hbase hradius

/-- The complete odd TFVD jet family is independent, with no finite cutoff. -/
theorem br2CameraBracketTfvdParityJet_odd_linearIndependent
    {base radius : ℕ}
    (hbase : IsSupported base)
    (hradius : radius ∈ radiusSet base)
    (q : ℝ) (hqpos : 0 < q) (hq1 : q < 1)
    (S : Finset NativeGpreBoundaryContext) :
    LinearIndependent ℝ
      (fun n : ℕ ↦
        br2CameraBracketTfvdParityJet base radius q S (Sum.inr n)) :=
  (br2CameraBracketTfvdIncidenceJetTransport
    base radius q hqpos hq1 S).odd_linearIndependent hbase hradius

end

end CarrySelfAdjointOperator
