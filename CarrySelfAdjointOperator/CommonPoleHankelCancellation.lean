import Mathlib.Data.Real.Basic
import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Data.Matrix.Basic
import Mathlib.Tactic.Ring

/-!
# Rank-one Hankel channel of a common linear pole

A geometric coefficient sequence contributes a rank-one Hankel form.  The
special coefficient `-2 * (-4)^j` is the odd response of the shared factor
`s - 1` in the centered C2 height coordinate.  This file is purely
algebraic: it asserts no positivity for the remaining source.
-/

namespace CarrySelfAdjointOperator

open scoped BigOperators

noncomputable section

/-- A geometric coefficient sequence with amplitude `α` and ratio `ρ`. -/
def geometricPoleCoefficient (α ρ : ℝ) (j : ℕ) : ℝ := α * ρ ^ j

/-- The size-`n` Hankel matrix from a shifted geometric coefficient sequence. -/
def geometricPoleHankel (α ρ : ℝ) (s n : ℕ) : Matrix (Fin n) (Fin n) ℝ :=
  fun i j => geometricPoleCoefficient α ρ (s + i.val + j.val)

/-- The rank-one outer product generated by the geometric vector `ρ^i`. -/
def geometricPoleOuterProduct (ρ : ℝ) (n : ℕ) : Matrix (Fin n) (Fin n) ℝ :=
  fun i j => ρ ^ i.val * ρ ^ j.val

/-- The geometric Hankel matrix is an exact scalar multiple of one outer
product, at every size and shift. -/
theorem geometricPoleHankel_eq_smul_outerProduct
    (α ρ : ℝ) (s n : ℕ) :
    geometricPoleHankel α ρ s n =
      (α * ρ ^ s) • geometricPoleOuterProduct ρ n := by
  ext i j
  change α * ρ ^ (s + i.val + j.val) =
    (α * ρ ^ s) * (ρ ^ i.val * ρ ^ j.val)
  rw [pow_add, pow_add]
  ring

/-- The quadratic form of a geometric outer product factors as a square. -/
theorem geometricOuterProduct_quadratic
    (ρ : ℝ) (n : ℕ) (x : Fin n → ℝ) :
    (∑ i : Fin n, ∑ j : Fin n,
      x i * x j * (ρ ^ i.val * ρ ^ j.val)) =
      (∑ i : Fin n, x i * ρ ^ i.val) ^ 2 := by
  calc
    (∑ i : Fin n, ∑ j : Fin n,
      x i * x j * (ρ ^ i.val * ρ ^ j.val)) =
        (∑ i : Fin n, x i * ρ ^ i.val) *
          (∑ j : Fin n, x j * ρ ^ j.val) := by
            rw [Fintype.sum_mul_sum]
            apply Finset.sum_congr rfl
            intro i hi
            apply Finset.sum_congr rfl
            intro j hj
            ring
    _ = (∑ i : Fin n, x i * ρ ^ i.val) ^ 2 := by rw [pow_two]

/-- The quadratic form of the geometric Hankel sequence factors as a square.
No invertibility or sign assumption is involved. -/
theorem geometricPoleHankel_quadratic
    (α ρ : ℝ) (s n : ℕ) (x : Fin n → ℝ) :
    (∑ i : Fin n, ∑ j : Fin n,
      x i * x j * geometricPoleCoefficient α ρ (s + i.val + j.val)) =
      α * ρ ^ s * (∑ i : Fin n, x i * ρ ^ i.val) ^ 2 := by
  let f : Fin n → ℝ := fun i => x i * ρ ^ i.val
  have hsum :
      (∑ i : Fin n, ∑ j : Fin n, (α * ρ ^ s) * (f i * f j)) =
        (α * ρ ^ s) * (∑ i : Fin n, ∑ j : Fin n, f i * f j) := by
    calc
      (∑ i : Fin n, ∑ j : Fin n, (α * ρ ^ s) * (f i * f j)) =
          (∑ i : Fin n, (α * ρ ^ s) * (∑ j : Fin n, f i * f j)) := by
            apply Finset.sum_congr rfl
            intro i hi
            simpa using
              (Finset.mul_sum (Finset.univ) (fun j : Fin n => f i * f j)
                (α * ρ ^ s)).symm
      _ = (α * ρ ^ s) * (∑ i : Fin n, ∑ j : Fin n, f i * f j) := by
            simpa using
              (Finset.mul_sum (Finset.univ)
                (fun i : Fin n => ∑ j : Fin n, f i * f j)
                (α * ρ ^ s)).symm
  calc
    (∑ i : Fin n, ∑ j : Fin n,
      x i * x j * geometricPoleCoefficient α ρ (s + i.val + j.val)) =
        ∑ i : Fin n, ∑ j : Fin n, (α * ρ ^ s) * (f i * f j) := by
          apply Finset.sum_congr rfl
          intro i hi
          apply Finset.sum_congr rfl
          intro j hj
          simp only [geometricPoleCoefficient, f]
          rw [pow_add, pow_add]
          ring
    _ = (α * ρ ^ s) * (∑ i : Fin n, ∑ j : Fin n, f i * f j) := hsum
    _ = α * ρ ^ s * (∑ i : Fin n, x i * ρ ^ i.val) ^ 2 := by
          have hquad := geometricOuterProduct_quadratic ρ n x
          have hquad' :
              (∑ i : Fin n, ∑ j : Fin n, f i * f j) =
                (∑ i : Fin n, x i * ρ ^ i.val) ^ 2 := by
            calc
              (∑ i : Fin n, ∑ j : Fin n, f i * f j) =
                  ∑ i : Fin n, ∑ j : Fin n,
                    x i * x j * (ρ ^ i.val * ρ ^ j.val) := by
                      apply Finset.sum_congr rfl
                      intro i hi
                      apply Finset.sum_congr rfl
                      intro j hj
                      simp only [f]
                      ring
              _ = (∑ i : Fin n, x i * ρ ^ i.val) ^ 2 := hquad
          rw [hquad']

/-- The common-pole odd coefficient sequence from the C2 shared factor. -/
def commonPoleOddCoefficient (j : ℕ) : ℝ := -2 * (-4 : ℝ) ^ j

/-- Its all-order Hankel quadratic form is exactly one rank-one channel. -/
theorem commonPoleOddCoefficient_quadratic
    (s n : ℕ) (x : Fin n → ℝ) :
    (∑ i : Fin n, ∑ j : Fin n,
      x i * x j * commonPoleOddCoefficient (s + i.val + j.val)) =
      -2 * (-4 : ℝ) ^ s * (∑ i : Fin n, x i * (-4 : ℝ) ^ i.val) ^ 2 := by
  simpa [commonPoleOddCoefficient, geometricPoleCoefficient] using
    (geometricPoleHankel_quadratic (-2 : ℝ) (-4 : ℝ) s n x)

/-- Matrix form of the exact common-pole rank-one channel. -/
theorem commonPoleOddHankel_eq_smul_outerProduct
    (s n : ℕ) :
    (fun i j : Fin n => commonPoleOddCoefficient (s + i.val + j.val)) =
      (-2 * (-4 : ℝ) ^ s) •
        (fun i j : Fin n => (-4 : ℝ) ^ i.val * (-4 : ℝ) ^ j.val) := by
  ext i j
  have h := geometricPoleHankel_eq_smul_outerProduct
    (-2 : ℝ) (-4 : ℝ) s n
  simpa [commonPoleOddCoefficient, geometricPoleCoefficient,
    geometricPoleHankel, geometricPoleOuterProduct] using
      congrFun (congrFun h i) j

/-- The two opposite channels cancel in every finite Hankel form and for every
coefficient vector, including a vector selected by a separate Schur problem. -/
theorem commonPoleOddCoefficient_channels_cancel
    (s n : ℕ) (x : Fin n → ℝ) :
    (∑ i : Fin n, ∑ j : Fin n,
      x i * x j * commonPoleOddCoefficient (s + i.val + j.val)) +
      (∑ i : Fin n, ∑ j : Fin n,
        x i * x j * (-commonPoleOddCoefficient (s + i.val + j.val))) = 0 := by
  simp_rw [← Finset.sum_add_distrib]
  apply Finset.sum_eq_zero
  intro i hi
  apply Finset.sum_eq_zero
  intro j hj
  ring

end

end CarrySelfAdjointOperator
