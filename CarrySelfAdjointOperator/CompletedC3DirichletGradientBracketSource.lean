import CarrySelfAdjointOperator.BR2CausalGreenResponseTransport
import Mathlib.Tactic

/-!
# The actual bracket source of a completed C3 TFVD prefix

The bracket incidence is a probe.  The source generated by a finite TFVD
prefix is instead the weighted centered bracket of the whole truncated slope
field.  This module keeps that source as a vector, expands it through the
causal bracket ledger, records the two cutoff terms, and reconstructs the
original prefix by the exact weighted Green/return identity.

No source is identified with a single camera cell.  The interior formula
retains the initial-slope channel and the complete lower-triangular sum of
causal unit brackets.
-/

open scoped BigOperators lp ENNReal NNReal

namespace CarrySelfAdjointOperator

open CPFormal.Analytic.Cp

noncomputable section

/-- Actual source obtained by applying the carry-weighted centered bracket to
the geometrically complete ordinary TFVD prefix. -/
def canonicalCompletedC3DirichletGradientBracketSource
    (base cutoff : ℕ) (s : ℂ) : CarryVerticalL2 :=
  carryWeightedVerticalCenteredBracket
    (canonicalBR2CarryAmplitudeRatio base)
    (canonicalCompletedC3DirichletGradientPrefixState s
      (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1))

@[simp] theorem canonicalCompletedC3DirichletGradientBracketSource_zero
    (base cutoff : ℕ) (s : ℂ) :
    canonicalCompletedC3DirichletGradientBracketSource base cutoff s 0 = 0 := by
  simp [canonicalCompletedC3DirichletGradientBracketSource]

/-- Literal coordinate formula, including all cutoff tests. -/
theorem canonicalCompletedC3DirichletGradientBracketSource_succ
    (base cutoff : ℕ) (s : ℂ) (n : ℕ) :
    let q : ℝ := canonicalBR2CarryAmplitudeRatio base
    let horizon :=
      NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1
    canonicalCompletedC3DirichletGradientBracketSource
        base cutoff s (n + 1) =
      (q : ℂ)⁻¹ *
          (if n + 2 < horizon then positiveDirichletGradient s (n + 2) else 0) -
        2 * (if n + 1 < horizon then
          positiveDirichletGradient s (n + 1) else 0) +
        (q : ℂ) *
          (if n < horizon then positiveDirichletGradient s n else 0) := by
  dsimp only
  rw [canonicalCompletedC3DirichletGradientBracketSource,
    carryWeightedVerticalCenteredBracket_succ]
  simp only [canonicalCompletedC3DirichletGradientPrefixState_apply]

/-- Before the last two cutoff coordinates, the source is the weighted second
difference of three consecutive slopes of the same causal value state. -/
theorem canonicalCompletedC3DirichletGradientBracketSource_interior
    (base cutoff : ℕ) (s : ℂ) (n : ℕ)
    (hn : n + 2 <
      NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1) :
    let q : ℝ := canonicalBR2CarryAmplitudeRatio base
    canonicalCompletedC3DirichletGradientBracketSource
        base cutoff s (n + 1) =
      (q : ℂ)⁻¹ * causalSlope (canonicalC3CausalValueState s) (n + 2) -
        2 * causalSlope (canonicalC3CausalValueState s) (n + 1) +
        (q : ℂ) * causalSlope (canonicalC3CausalValueState s) n := by
  dsimp only
  rw [canonicalCompletedC3DirichletGradientBracketSource_succ]
  have hn1 : n + 1 <
      NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1 := by
    omega
  have hn0 : n <
      NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1 := by
    omega
  simp only [hn, hn1, hn0, if_true]
  simp_rw [canonicalC3CausalSlope_eq_positiveDirichletGradient]

/-- Exact lower-triangular causal-ledger expansion of every interior source
coordinate.  The initial slope is retained as its own boundary channel. -/
theorem canonicalCompletedC3DirichletGradientBracketSource_interior_eq_causalLedger
    (base cutoff : ℕ) (s : ℂ) (n : ℕ)
    (hn : n + 2 <
      NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1) :
    let q : ℝ := canonicalBR2CarryAmplitudeRatio base
    let value := canonicalC3CausalValueState s
    canonicalCompletedC3DirichletGradientBracketSource
        base cutoff s (n + 1) =
      ((q : ℂ)⁻¹ - 2 + (q : ℂ)) * causalSlope value 0 +
        ((q : ℂ)⁻¹ - 2 + (q : ℂ)) *
          (∑ j ∈ Finset.range (n + 1), causalUnitBracket value j) +
        (q : ℂ)⁻¹ * causalUnitBracket value (n + 1) -
        (q : ℂ) * causalUnitBracket value n := by
  dsimp only
  rw [canonicalCompletedC3DirichletGradientBracketSource_interior
    base cutoff s n hn]
  let value := canonicalC3CausalValueState s
  have hnext :
      causalSlope value (n + 2) =
        causalSlope value (n + 1) + causalUnitBracket value (n + 1) := by
    rw [causalUnitBracket_eq_slope_sub_slope]
    abel
  have hprev :
      causalSlope value n =
        causalSlope value (n + 1) - causalUnitBracket value n := by
    rw [causalUnitBracket_eq_slope_sub_slope]
    abel
  have htelescope := causalSlope_eq_initial_add_sum_brackets value (n + 1)
  rw [hnext, hprev, htelescope]
  ring

/-- The outermost source coordinate is the retained last slope multiplied by
the carry amplitude.  It is a genuine cutoff/boundary term. -/
theorem canonicalCompletedC3DirichletGradientBracketSource_outerBoundary
    (base cutoff : ℕ) (s : ℂ) :
    let q : ℝ := canonicalBR2CarryAmplitudeRatio base
    let window := NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff
    canonicalCompletedC3DirichletGradientBracketSource
        base cutoff s (window + 1) =
      (q : ℂ) * positiveDirichletGradient s window := by
  dsimp only
  rw [canonicalCompletedC3DirichletGradientBracketSource_succ]
  simp

/-- The penultimate coordinate is the second explicit cutoff term. -/
theorem canonicalCompletedC3DirichletGradientBracketSource_innerBoundary
    (base cutoff : ℕ) (s : ℂ)
    (hwindow : 1 ≤
      NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff) :
    let q : ℝ := canonicalBR2CarryAmplitudeRatio base
    let window := NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff
    canonicalCompletedC3DirichletGradientBracketSource
        base cutoff s window =
      -2 * positiveDirichletGradient s window +
        (q : ℂ) * positiveDirichletGradient s (window - 1) := by
  dsimp only
  have hwindow0 :
      NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff ≠ 0 :=
    Nat.ne_of_gt hwindow
  obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero hwindow0
  rw [hn]
  rw [canonicalCompletedC3DirichletGradientBracketSource_succ]
  simp [hn]

/-- The source has no coordinates beyond the outer cutoff return. -/
theorem canonicalCompletedC3DirichletGradientBracketSource_eq_zero_of_boundary_lt
    (base cutoff : ℕ) (s : ℂ) {position : ℕ}
    (hposition :
      NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1 <
        position) :
    canonicalCompletedC3DirichletGradientBracketSource
        base cutoff s position = 0 := by
  cases position with
  | zero => omega
  | succ n =>
      rw [canonicalCompletedC3DirichletGradientBracketSource_succ]
      have h2 : ¬n + 2 <
          NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1 := by
        omega
      have h1 : ¬n + 1 <
          NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1 := by
        omega
      have h0 : ¬n <
          NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1 := by
        omega
      simp [h2, h1, h0]

/-- Causal Green response of the actual full prefix source. -/
def canonicalCompletedC3DirichletGradientBracketGreenResponse
    (base cutoff : ℕ) (s : ℂ) : CarryVerticalL2 :=
  carryVerticalL2WeightedGreen
    (canonicalBR2CarryAmplitudeRatio base)
    (canonicalCompletedC3DirichletGradientBracketSource base cutoff s)

/-- Applying the weighted bracket to the causal response recovers the whole
prefix source. -/
theorem canonicalCompletedC3DirichletGradientBracket_greenResponse_eq_source
    {base cutoff : ℕ}
    (hbase : FiniteNativeCarryOperator.Camera.IsSupported base) (s : ℂ) :
    carryWeightedVerticalCenteredBracket
        (canonicalBR2CarryAmplitudeRatio base)
        (canonicalCompletedC3DirichletGradientBracketGreenResponse
          base cutoff s) =
      canonicalCompletedC3DirichletGradientBracketSource base cutoff s := by
  rw [canonicalCompletedC3DirichletGradientBracketGreenResponse,
    carryWeightedVerticalCenteredBracket_weightedGreen
      (canonicalBR2CarryAmplitudeRatio base)
      (canonicalBR2CarryAmplitudeRatio_pos hbase)
      (canonicalBR2CarryAmplitudeRatio_lt_one hbase)]
  ext n
  by_cases hn : n = 0
  · subst n
    simp
  · simp [carryVerticalL2ZeroHeadProjection_apply, hn]

/-- Exact source/Green/boundary factorization of the TFVD slope prefix. -/
theorem canonicalCompletedC3DirichletGradient_greenResponse_add_boundary_eq_prefix
    {base cutoff : ℕ}
    (hbase : FiniteNativeCarryOperator.Camera.IsSupported base) (s : ℂ) :
    let q : ℝ := canonicalBR2CarryAmplitudeRatio base
    let prefixState := canonicalCompletedC3DirichletGradientPrefixState s
      (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1)
    canonicalCompletedC3DirichletGradientBracketGreenResponse base cutoff s +
        carryWeightedVerticalReturn q
          (canonicalBR2CarryAmplitudeRatio_pos hbase).le
          (canonicalBR2CarryAmplitudeRatio_lt_one hbase)
          (carryWeightedVerticalTrace q prefixState) =
      prefixState := by
  dsimp only
  ext n
  exact carryWeightedVerticalTfvd_apply
    (canonicalBR2CarryAmplitudeRatio base)
    (canonicalBR2CarryAmplitudeRatio_pos hbase)
    (canonicalBR2CarryAmplitudeRatio_lt_one hbase)
    (canonicalCompletedC3DirichletGradientPrefixState s
      (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1)) n

/-! ## Finite local-cell synthesis -/

/-- Source column generated by one slope coordinate.  These are weighted
three-coordinate cells; they are not silently replaced by unweighted BR2
incidences. -/
def canonicalBR2WeightedSlopeCellSource
    (base index : ℕ) : CarryVerticalL2 :=
  carryWeightedVerticalCenteredBracket
    (canonicalBR2CarryAmplitudeRatio base) (lp.single 2 index (1 : ℂ))

@[simp] theorem canonicalBR2WeightedSlopeCellSource_zero
    (base index : ℕ) :
    canonicalBR2WeightedSlopeCellSource base index 0 = 0 := by
  simp [canonicalBR2WeightedSlopeCellSource]

/-- Exact tridiagonal column of the source-coefficient transform. -/
theorem canonicalBR2WeightedSlopeCellSource_succ
    (base index n : ℕ) :
    let q : ℝ := canonicalBR2CarryAmplitudeRatio base
    canonicalBR2WeightedSlopeCellSource base index (n + 1) =
      (q : ℂ)⁻¹ * (if n + 2 = index then 1 else 0) -
        2 * (if n + 1 = index then 1 else 0) +
        (q : ℂ) * (if n = index then 1 else 0) := by
  dsimp only
  rw [canonicalBR2WeightedSlopeCellSource,
    carryWeightedVerticalCenteredBracket_succ]
  simp [lp.single_apply, Pi.single_apply, eq_comm]

/-- The complete source is the finite synthesis of all weighted local cells,
with the actual Dirichlet slopes as coefficients. -/
theorem canonicalCompletedC3DirichletGradientBracketSource_eq_sum_weightedCells
    (base cutoff : ℕ) (s : ℂ) :
    let horizon :=
      NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1
    canonicalCompletedC3DirichletGradientBracketSource base cutoff s =
      ∑ n ∈ Finset.range horizon,
        positiveDirichletGradient s n •
          canonicalBR2WeightedSlopeCellSource base n := by
  dsimp only
  rw [canonicalCompletedC3DirichletGradientBracketSource,
    canonicalCompletedC3DirichletGradientPrefixState_eq_sum_single, map_sum]
  apply Finset.sum_congr rfl
  intro n hn
  have hsingle :
      lp.single 2 n (positiveDirichletGradient s n) =
        positiveDirichletGradient s n •
          (lp.single 2 n (1 : ℂ) : CarryVerticalL2) := by
    ext k
    by_cases hk : k = n
    · subst k
      simp [lp.single_apply]
    · simp [lp.single_apply, hk]
  rw [hsingle, map_smul]
  rfl

/-! ## Identification of interior columns with all-bases camera cells -/

/-- Carry dressing of one geometric bracket incidence.  The support is the
same left/center/right camera cell; only the two leg weights are transported
by the carry amplitude. -/
def br2CarryDressedCameraBracketVerticalState
    (q : ℝ) (camera radius index : ℕ) : CarryVerticalL2 :=
  (((q : ℂ) ^ radius)⁻¹) •
      (lp.single 2 (cameraLeftLeg camera index radius) (1 : ℂ) :
        CarryVerticalL2) +
    lp.single 2 (FiniteNativeCarryOperator.Camera.alignedCenter camera index)
      (-2 : ℂ) +
    ((q : ℂ) ^ radius) •
      (lp.single 2 (cameraRightLeg camera index radius) (1 : ℂ) :
        CarryVerticalL2)

/-- At unit carry dressing this is literally the ordinary BR2 incidence
state. -/
theorem br2CarryDressedCameraBracketVerticalState_one
    (camera radius index : ℕ) :
    br2CarryDressedCameraBracketVerticalState 1 camera radius index =
      br2CameraBracketVerticalState camera radius index := by
  simp [br2CarryDressedCameraBracketVerticalState,
    br2CameraBracketVerticalState, cameraLeftLeg, cameraRightLeg]

/-- Every non-boundary weighted slope column is exactly the carry-dressed
unit incidence in the first cell of the natural camera centered there. -/
theorem canonicalBR2WeightedSlopeCellSource_eq_allBasesDressedUnitIncidence
    (sourceBase center : ℕ) (hcenter : 3 ≤ center) :
    canonicalBR2WeightedSlopeCellSource sourceBase center =
      br2CarryDressedCameraBracketVerticalState
        (canonicalBR2CarryAmplitudeRatio sourceBase) center 1 0 := by
  ext position
  cases position with
  | zero =>
      have hcenter2 : center ≠ 2 := by omega
      have hleft0 : center - 1 ≠ 0 := by omega
      have hcenter0 : center ≠ 0 := by omega
      have hright0 : center + 1 ≠ 0 := by omega
      simp [canonicalBR2WeightedSlopeCellSource,
        br2CarryDressedCameraBracketVerticalState,
        cameraLeftLeg, cameraRightLeg,
        FiniteNativeCarryOperator.Camera.alignedCenter_of_ne_two hcenter2,
        lp.single_apply, hleft0, hcenter0]
      change 0 = (canonicalBR2CarryAmplitudeRatio sourceBase : ℂ) *
        (lp.single 2 (center + 1) (1 : ℂ) : CarryVerticalL2) 0
      rw [lp.single_apply_ne 2 _ _ hright0.symm]
      simp
  | succ n =>
      rw [canonicalBR2WeightedSlopeCellSource_succ]
      simp only [br2CarryDressedCameraBracketVerticalState,
        lp.coeFn_add, Pi.add_apply, lp.coeFn_smul, Pi.smul_apply]
      have hcenter2 : center ≠ 2 := by omega
      rw [FiniteNativeCarryOperator.Camera.alignedCenter_of_ne_two hcenter2]
      simp only [cameraLeftLeg, cameraRightLeg,
        FiniteNativeCarryOperator.Camera.alignedCenter_of_ne_two hcenter2,
        pow_one]
      simp only [lp.single_apply, Pi.single_apply, smul_eq_mul]
      have heq : n + 1 = center - 1 ↔ center = n + 2 := by omega
      simp [heq, eq_comm]
      by_cases hc : center = 1 + n
      · have hc' : center = n + 1 := by omega
        simp [hc']
      · have hc' : ¬center = n + 1 := by omega
        simp [hc']

/-- Exact geometric source decomposition.  The first three weighted columns
are retained as boundary/seed channels.  Every later column is a carry-dressed
unit incidence from the all-bases atlas. -/
theorem canonicalCompletedC3DirichletGradientBracketSource_eq_allBasesCells
    (base cutoff : ℕ) (s : ℂ) :
    let horizon :=
      NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1
    canonicalCompletedC3DirichletGradientBracketSource base cutoff s =
      ∑ n ∈ Finset.range horizon,
        positiveDirichletGradient s n •
          (if 3 ≤ n then
            br2CarryDressedCameraBracketVerticalState
              (canonicalBR2CarryAmplitudeRatio base) n 1 0
          else canonicalBR2WeightedSlopeCellSource base n) := by
  dsimp only
  rw [canonicalCompletedC3DirichletGradientBracketSource_eq_sum_weightedCells]
  apply Finset.sum_congr rfl
  intro n hn
  by_cases hthree : 3 ≤ n
  · simp only [hthree, if_true]
    rw [canonicalBR2WeightedSlopeCellSource_eq_allBasesDressedUnitIncidence
      base n hthree]
  · simp [hthree]

/-- On the native line, every causal bracket coefficient beyond the initial
boundary cell is exactly the complex packaging of the unit-cell readout in
the corresponding natural camera of the all-bases atlas. -/
theorem allBases_cameraReadout_eq_canonicalC3CausalUnitBracket
    (time : ℝ) (left : ℕ) (hleft : 1 ≤ left) :
    CPFormal.Analytic.Cp.nativeCarryRealPlaneComplexPackaging
        (FiniteNativeCarryOperator.Operator.centeredBracket time
          (FiniteNativeCarryOperator.Camera.alignedCenter (left + 2) 0) 1) =
      causalUnitBracket
        (canonicalC3CausalValueState
          (NativeCarrySpectralWeyl.Camera.nativeLine time)) left := by
  have hcell := (allBases_contains_causal_unit_cell
    time (left := left + 1) (by omega)).2.2
  have hpack := congrArg
    CPFormal.Analytic.Cp.nativeCarryRealPlaneComplexPackaging hcell
  have hdouble (u : FiniteNativeCarryOperator.Operator.RealPlane) :
      CPFormal.Analytic.Cp.nativeCarryRealPlaneComplexPackaging
          ((2 : ℕ) • u) =
        2 * CPFormal.Analytic.Cp.nativeCarryRealPlaneComplexPackaging u := by
    apply Complex.ext <;>
      simp [CPFormal.Analytic.Cp.nativeCarryRealPlaneComplexPackaging]
  unfold causalUnitBracket at hpack
  simp only [map_add, map_sub] at hpack
  rw [hdouble] at hpack
  simpa [causalUnitBracket, canonicalC3CausalValueState,
    CPFormal.Analytic.Cp.positiveDirichletValue,
    NativeCarrySpectralWeyl.Camera.dirichletValue,
    NativeCarryC3Crosswalk.packaged_nativeState_eq_dirichletValue_nativeLine,
    Nat.add_assoc] using hpack

/-! ## Reverse-triangular injectivity -/

/-- A finitely supported slope state is determined by its weighted bracket.
The proof starts at the first zero coordinate beyond the support and walks
backward; the pivot at every step is the nonzero factor `q`. -/
theorem eq_zero_of_weightedBracket_eq_zero_of_tail
    (q : ℝ) (hq : q ≠ 0) (x : CarryVerticalL2) (N : ℕ)
    (htail : ∀ n, N ≤ n → x n = 0)
    (hbracket : carryWeightedVerticalCenteredBracket q x = 0) :
    x = 0 := by
  let P : ℕ → Prop := fun k ↦ ∀ j, k ≤ j → x j = 0
  have hbase : P N := by
    intro j hj
    exact htail j hj
  have hstep : ∀ k, k < N → P (k + 1) → P k := by
    intro k hk ih j hj
    by_cases hjk : j = k
    · subst j
      have hx1 : x (k + 1) = 0 := ih (k + 1) (by omega)
      have hx2 : x (k + 2) = 0 := ih (k + 2) (by omega)
      have hb := congrArg (fun y : CarryVerticalL2 ↦ y (k + 1)) hbracket
      rw [carryWeightedVerticalCenteredBracket_succ] at hb
      simp only [lp.coeFn_zero, Pi.zero_apply, hx1, hx2, mul_zero,
        sub_zero, zero_add] at hb
      have hqC : (q : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hq
      exact (mul_eq_zero.mp hb).resolve_left hqC
    · exact ih j (by omega)
  have hall : P 0 :=
    Nat.decreasingInduction hstep hbase (Nat.zero_le N)
  ext n
  simp [hall n (Nat.zero_le n)]

/-- Equality version of reverse-triangular injectivity on a common finite
support window. -/
theorem carryWeightedVerticalCenteredBracket_injective_on_tail
    (q : ℝ) (hq : q ≠ 0) (N : ℕ) {x y : CarryVerticalL2}
    (hx : ∀ n, N ≤ n → x n = 0)
    (hy : ∀ n, N ≤ n → y n = 0)
    (hbracket : carryWeightedVerticalCenteredBracket q x =
      carryWeightedVerticalCenteredBracket q y) :
    x = y := by
  have hzero : carryWeightedVerticalCenteredBracket q (x - y) = 0 := by
    rw [map_sub, hbracket, sub_self]
  have htail : ∀ n, N ≤ n → (x - y) n = 0 := by
    intro n hn
    simp [hx n hn, hy n hn]
  exact sub_eq_zero.mp
    (eq_zero_of_weightedBracket_eq_zero_of_tail q hq (x - y) N htail hzero)

/-- Finite coefficient vector realized as a slope prefix in vertical
`ell^2`. -/
def finiteSlopeCoefficientState {N : ℕ}
    (coeff : Fin N → ℂ) : CarryVerticalL2 :=
  ∑ i : Fin N, coeff i • (lp.single 2 i.val (1 : ℂ) : CarryVerticalL2)

theorem finiteSlopeCoefficientState_apply_of_lt
    {N n : ℕ} (coeff : Fin N → ℂ) (hn : n < N) :
    finiteSlopeCoefficientState coeff n = coeff ⟨n, hn⟩ := by
  classical
  simp only [finiteSlopeCoefficientState, lp.coeFn_sum, Finset.sum_apply,
    lp.coeFn_smul, Pi.smul_apply]
  rw [Fintype.sum_eq_single ⟨n, hn⟩]
  · rw [lp.single_apply_self]
    simp
  · intro i hi
    have hne : n ≠ i.val := by
      intro h
      apply hi
      apply Fin.ext
      exact h.symm
    rw [lp.single_apply_ne 2 _ _ hne]
    simp

theorem finiteSlopeCoefficientState_apply_of_le
    {N n : ℕ} (coeff : Fin N → ℂ) (hn : N ≤ n) :
    finiteSlopeCoefficientState coeff n = 0 := by
  classical
  simp only [finiteSlopeCoefficientState, lp.coeFn_sum, Finset.sum_apply,
    lp.coeFn_smul, Pi.smul_apply]
  apply Finset.sum_eq_zero
  intro i hi
  have hne : n ≠ i.val := by omega
  rw [lp.single_apply_ne 2 _ _ hne]
  simp

/-- The finite source-coefficient transform. -/
def finiteWeightedSlopeSourceTransform
    (q : ℝ) {N : ℕ} (coeff : Fin N → ℂ) : CarryVerticalL2 :=
  carryWeightedVerticalCenteredBracket q (finiteSlopeCoefficientState coeff)

/-- Linear realization of finite slope coefficients. -/
def finiteSlopeCoefficientSynthesisLinearMap (N : ℕ) :
    (Fin N → ℂ) →ₗ[ℂ] CarryVerticalL2 where
  toFun := finiteSlopeCoefficientState
  map_add' a b := by
    simp [finiteSlopeCoefficientState, add_smul, Finset.sum_add_distrib]
  map_smul' c a := by
    simp [finiteSlopeCoefficientState, Finset.smul_sum, smul_smul]

@[simp] theorem finiteSlopeCoefficientSynthesisLinearMap_apply
    {N : ℕ} (coeff : Fin N → ℂ) :
    finiteSlopeCoefficientSynthesisLinearMap N coeff =
      finiteSlopeCoefficientState coeff := rfl

/-- The fixed tridiagonal source matrix as a complex-linear map. -/
def finiteWeightedSlopeSourceLinearMap (q : ℝ) (N : ℕ) :
    (Fin N → ℂ) →ₗ[ℂ] CarryVerticalL2 :=
  (carryWeightedVerticalCenteredBracket q).toLinearMap.comp
    (finiteSlopeCoefficientSynthesisLinearMap N)

@[simp] theorem finiteWeightedSlopeSourceLinearMap_apply
    (q : ℝ) {N : ℕ} (coeff : Fin N → ℂ) :
    finiteWeightedSlopeSourceLinearMap q N coeff =
      finiteWeightedSlopeSourceTransform q coeff := rfl

/-- The finite transform is injective by its reverse-triangular nonzero
diagonal, independently of every Gram or moment statement. -/
theorem finiteWeightedSlopeSourceTransform_injective
    (q : ℝ) (hq : q ≠ 0) (N : ℕ) :
    Function.Injective
      (finiteWeightedSlopeSourceTransform q : (Fin N → ℂ) → CarryVerticalL2) := by
  intro a b hab
  have hstate : finiteSlopeCoefficientState a = finiteSlopeCoefficientState b :=
    carryWeightedVerticalCenteredBracket_injective_on_tail q hq N
      (fun n hn ↦ finiteSlopeCoefficientState_apply_of_le a hn)
      (fun n hn ↦ finiteSlopeCoefficientState_apply_of_le b hn)
      hab
  funext i
  have hi := congrArg (fun x : CarryVerticalL2 ↦ x i.val) hstate
  simpa [finiteSlopeCoefficientState_apply_of_lt a i.isLt,
    finiteSlopeCoefficientState_apply_of_lt b i.isLt] using hi

/-- Canonical carry specialization of the injective finite source transform. -/
theorem canonicalFiniteWeightedSlopeSourceTransform_injective
    {base : ℕ} (hbase : FiniteNativeCarryOperator.Camera.IsSupported base)
    (N : ℕ) :
    Function.Injective
      (finiteWeightedSlopeSourceTransform
        (canonicalBR2CarryAmplitudeRatio base) :
          (Fin N → ℂ) → CarryVerticalL2) := by
  exact finiteWeightedSlopeSourceTransform_injective
    (canonicalBR2CarryAmplitudeRatio base)
    (canonicalBR2CarryAmplitudeRatio_pos hbase).ne' N

/-- Causal Green response of the finite source-coefficient transform. -/
def finiteWeightedSlopeGreenResponseLinearMap
    (q : ℝ) (N : ℕ) : (Fin N → ℂ) →ₗ[ℂ] CarryVerticalL2 :=
  (carryVerticalL2WeightedGreen q).toLinearMap.comp
    (finiteWeightedSlopeSourceLinearMap q N)

@[simp] theorem finiteWeightedSlopeGreenResponseLinearMap_apply
    (q : ℝ) {N : ℕ} (coeff : Fin N → ℂ) :
    finiteWeightedSlopeGreenResponseLinearMap q N coeff =
      carryVerticalL2WeightedGreen q
        (finiteWeightedSlopeSourceLinearMap q N coeff) := rfl

/-- The bracket is a left inverse of the finite response transport. -/
theorem carryWeightedVerticalCenteredBracket_finiteSlopeGreenResponse
    (q : ℝ) (hqpos : 0 < q) (hq1 : q < 1)
    (N : ℕ) (coeff : Fin N → ℂ) :
    carryWeightedVerticalCenteredBracket q
        (finiteWeightedSlopeGreenResponseLinearMap q N coeff) =
      finiteWeightedSlopeSourceLinearMap q N coeff := by
  rw [finiteWeightedSlopeGreenResponseLinearMap_apply,
    carryWeightedVerticalCenteredBracket_weightedGreen q hqpos hq1]
  ext n
  by_cases hn : n = 0
  · subst n
    simp [finiteWeightedSlopeSourceLinearMap]
  · simp [carryVerticalL2ZeroHeadProjection_apply, hn]

/-- The complete finite causal transport is injective.  Its left inverse is
the bracket followed by the already proved reverse-triangular source inverse;
no norm or Gram argument enters. -/
theorem finiteWeightedSlopeGreenResponseLinearMap_injective
    (q : ℝ) (hqpos : 0 < q) (hq1 : q < 1) (N : ℕ) :
    Function.Injective (finiteWeightedSlopeGreenResponseLinearMap q N) := by
  intro a b hab
  have hsource : finiteWeightedSlopeSourceLinearMap q N a =
      finiteWeightedSlopeSourceLinearMap q N b := by
    have h := congrArg
      (fun x : CarryVerticalL2 ↦ carryWeightedVerticalCenteredBracket q x) hab
    change carryWeightedVerticalCenteredBracket q
        (finiteWeightedSlopeGreenResponseLinearMap q N a) =
      carryWeightedVerticalCenteredBracket q
        (finiteWeightedSlopeGreenResponseLinearMap q N b) at h
    rw [carryWeightedVerticalCenteredBracket_finiteSlopeGreenResponse
        q hqpos hq1 N a,
      carryWeightedVerticalCenteredBracket_finiteSlopeGreenResponse
        q hqpos hq1 N b] at h
    exact h
  exact finiteWeightedSlopeSourceTransform_injective q hqpos.ne' N hsource

/-- Canonical carry specialization of the complete injective causal
transport. -/
theorem canonicalFiniteWeightedSlopeGreenResponseLinearMap_injective
    {base : ℕ} (hbase : FiniteNativeCarryOperator.Camera.IsSupported base)
    (N : ℕ) :
    Function.Injective
      (finiteWeightedSlopeGreenResponseLinearMap
        (canonicalBR2CarryAmplitudeRatio base) N) := by
  exact finiteWeightedSlopeGreenResponseLinearMap_injective
    (canonicalBR2CarryAmplitudeRatio base)
    (canonicalBR2CarryAmplitudeRatio_pos hbase)
    (canonicalBR2CarryAmplitudeRatio_lt_one hbase) N

/-! ## All-order transport of the source identity -/

/-- Iterated forward differences commute with every complex-linear map. -/
theorem completedGreenForwardDifference_iter_linearMap
    {E F : Type*} [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    (T : E →ₗ[ℂ] F) (h : ℂ) (state : ℂ → E) (order : ℕ) :
    (completedGreenForwardDifference h)^[order] (fun z ↦ T (state z)) =
      fun z ↦ T ((completedGreenForwardDifference h)^[order] state z) := by
  induction order with
  | zero => rfl
  | succ order ih =>
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih]
      funext z
      simp [completedGreenForwardDifference]

/-- The source matrix remains fixed at every forward-difference order.  Thus
the jet source coefficients are obtained by differencing the coefficient
family, not by a new scalar identification. -/
theorem completedGreenForwardDifference_iter_finiteWeightedSlopeSourceLinearMap
    (q : ℝ) (N : ℕ) (coeff : ℂ → (Fin N → ℂ))
    (h : ℂ) (order : ℕ) :
    (completedGreenForwardDifference h)^[order]
        (fun z ↦ finiteWeightedSlopeSourceLinearMap q N (coeff z)) =
      fun z ↦ finiteWeightedSlopeSourceLinearMap q N
        ((completedGreenForwardDifference h)^[order] coeff z) := by
  exact completedGreenForwardDifference_iter_linearMap
    (finiteWeightedSlopeSourceLinearMap q N) h coeff order

/-- Coefficients of the actual TFVD prefix in its finite slope basis. -/
def canonicalCompletedC3DirichletGradientSlopeCoefficients
    (base cutoff : ℕ) (s : ℂ) :
    Fin (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1) → ℂ :=
  fun i ↦ positiveDirichletGradient s i.val

/-- The coefficient realization is exactly the existing completed prefix. -/
theorem finiteSlopeCoefficientState_canonicalDirichletGradientCoefficients
    (base cutoff : ℕ) (s : ℂ) :
    finiteSlopeCoefficientState
        (canonicalCompletedC3DirichletGradientSlopeCoefficients base cutoff s) =
      canonicalCompletedC3DirichletGradientPrefixState s
        (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1) := by
  ext n
  by_cases hn : n <
      NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1
  · rw [finiteSlopeCoefficientState_apply_of_lt _ hn,
      canonicalCompletedC3DirichletGradientPrefixState_apply]
    simp [canonicalCompletedC3DirichletGradientSlopeCoefficients, hn]
  · have hnle :
        NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1 ≤ n :=
      Nat.le_of_not_gt hn
    rw [finiteSlopeCoefficientState_apply_of_le _ hnle,
      canonicalCompletedC3DirichletGradientPrefixState_apply]
    simp [hn]

/-- The actual source is the fixed injective finite source matrix applied to
the genuine TFVD slope coefficients. -/
theorem canonicalCompletedC3DirichletGradientBracketSource_eq_sourceLinearMap
    (base cutoff : ℕ) (s : ℂ) :
    canonicalCompletedC3DirichletGradientBracketSource base cutoff s =
      finiteWeightedSlopeSourceLinearMap
        (canonicalBR2CarryAmplitudeRatio base)
        (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1)
        (canonicalCompletedC3DirichletGradientSlopeCoefficients
          base cutoff s) := by
  rw [canonicalCompletedC3DirichletGradientBracketSource,
    finiteWeightedSlopeSourceLinearMap_apply,
    finiteWeightedSlopeSourceTransform,
    finiteSlopeCoefficientState_canonicalDirichletGradientCoefficients]

/-- All forward-difference orders of the actual source are carried by the
same reverse-triangular coefficient transform. -/
theorem canonicalCompletedC3DirichletGradientBracketSource_forwardDifference
    (base cutoff : ℕ) (parameter : ℂ → ℂ) (h : ℂ) (order : ℕ) :
    (completedGreenForwardDifference h)^[order]
        (fun z ↦ canonicalCompletedC3DirichletGradientBracketSource
          base cutoff (parameter z)) =
      fun z ↦
        finiteWeightedSlopeSourceLinearMap
          (canonicalBR2CarryAmplitudeRatio base)
          (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1)
          ((completedGreenForwardDifference h)^[order]
            (fun w ↦ canonicalCompletedC3DirichletGradientSlopeCoefficients
              base cutoff (parameter w)) z) := by
  have hsource :
      (fun z ↦ canonicalCompletedC3DirichletGradientBracketSource
        base cutoff (parameter z)) =
      fun z ↦ finiteWeightedSlopeSourceLinearMap
        (canonicalBR2CarryAmplitudeRatio base)
        (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1)
        (canonicalCompletedC3DirichletGradientSlopeCoefficients
          base cutoff (parameter z)) := by
    funext z
    exact canonicalCompletedC3DirichletGradientBracketSource_eq_sourceLinearMap
      base cutoff (parameter z)
  rw [hsource]
  exact completedGreenForwardDifference_iter_finiteWeightedSlopeSourceLinearMap
    (canonicalBR2CarryAmplitudeRatio base)
    (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1)
    (fun z ↦ canonicalCompletedC3DirichletGradientSlopeCoefficients
      base cutoff (parameter z)) h order

/-- The actual causal response is the injective finite response transform of
the actual TFVD slope coefficients. -/
theorem canonicalCompletedC3DirichletGradientBracketGreenResponse_eq_responseLinearMap
    (base cutoff : ℕ) (s : ℂ) :
    canonicalCompletedC3DirichletGradientBracketGreenResponse base cutoff s =
      finiteWeightedSlopeGreenResponseLinearMap
        (canonicalBR2CarryAmplitudeRatio base)
        (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1)
        (canonicalCompletedC3DirichletGradientSlopeCoefficients
          base cutoff s) := by
  rw [canonicalCompletedC3DirichletGradientBracketGreenResponse,
    finiteWeightedSlopeGreenResponseLinearMap_apply,
    canonicalCompletedC3DirichletGradientBracketSource_eq_sourceLinearMap]

/-- Every all-order forward difference of the causal response uses the same
injective Green-response transport. -/
theorem canonicalCompletedC3DirichletGradientBracketGreenResponse_forwardDifference
    (base cutoff : ℕ) (parameter : ℂ → ℂ) (h : ℂ) (order : ℕ) :
    (completedGreenForwardDifference h)^[order]
        (fun z ↦ canonicalCompletedC3DirichletGradientBracketGreenResponse
          base cutoff (parameter z)) =
      fun z ↦
        finiteWeightedSlopeGreenResponseLinearMap
          (canonicalBR2CarryAmplitudeRatio base)
          (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1)
          ((completedGreenForwardDifference h)^[order]
            (fun w ↦ canonicalCompletedC3DirichletGradientSlopeCoefficients
              base cutoff (parameter w)) z) := by
  have hresponse :
      (fun z ↦ canonicalCompletedC3DirichletGradientBracketGreenResponse
        base cutoff (parameter z)) =
      fun z ↦ finiteWeightedSlopeGreenResponseLinearMap
        (canonicalBR2CarryAmplitudeRatio base)
        (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1)
        (canonicalCompletedC3DirichletGradientSlopeCoefficients
          base cutoff (parameter z)) := by
    funext z
    exact
      canonicalCompletedC3DirichletGradientBracketGreenResponse_eq_responseLinearMap
        base cutoff (parameter z)
  rw [hresponse]
  exact completedGreenForwardDifference_iter_linearMap
    (finiteWeightedSlopeGreenResponseLinearMap
      (canonicalBR2CarryAmplitudeRatio base)
      (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1))
    h
    (fun z ↦ canonicalCompletedC3DirichletGradientSlopeCoefficients
      base cutoff (parameter z)) order

/-! ## Geometric cutoff completion -/

/-- Geometrically complete camera horizons tend to infinity. -/
theorem finiteCameraWindow_add_one_tendsto_atTop
    {base : ℕ} (hbase : FiniteNativeCarryOperator.Camera.IsSupported base) :
    Filter.Tendsto
      (fun cutoff : ℕ ↦
        NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1)
      Filter.atTop Filter.atTop := by
  rw [Filter.tendsto_atTop]
  intro bound
  filter_upwards [Filter.eventually_ge_atTop bound] with cutoff hcutoff
  have hslope : 0 < NativeCarrySpectralWeyl.Camera.cameraSlope base :=
    NativeCarryC3Crosswalk.cameraSlope_pos_of_supported hbase
  rw [NativeCarrySpectralWeyl.Limits.finiteCameraWindow]
  have hmul : cutoff ≤
      NativeCarrySpectralWeyl.Camera.cameraSlope base * cutoff := by
    nlinarith
  omega

/-- Completion of the honest causal factorization.  The Green response and
the boundary return converge together to the completed TFVD slope state; no
claim that the boundary vanishes is inserted. -/
theorem canonicalCompletedC3DirichletGradient_greenResponse_add_boundary_tendsto
    {base : ℕ} (hbase : FiniteNativeCarryOperator.Camera.IsSupported base)
    {s : ℂ} (hs : 0 < s.re) :
    Filter.Tendsto
      (fun cutoff : ℕ ↦
        let q : ℝ := canonicalBR2CarryAmplitudeRatio base
        let prefixState := canonicalCompletedC3DirichletGradientPrefixState s
          (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1)
        canonicalCompletedC3DirichletGradientBracketGreenResponse base cutoff s +
          carryWeightedVerticalReturn q
            (canonicalBR2CarryAmplitudeRatio_pos hbase).le
            (canonicalBR2CarryAmplitudeRatio_lt_one hbase)
            (carryWeightedVerticalTrace q prefixState))
      Filter.atTop
      (nhds (canonicalCompletedC3DirichletGradientState s hs)) := by
  have hprefix := (canonicalCompletedC3DirichletGradientPrefixState_tendsto hs).comp
    (finiteCameraWindow_add_one_tendsto_atTop hbase)
  apply hprefix.congr'
  filter_upwards with cutoff
  exact (canonicalCompletedC3DirichletGradient_greenResponse_add_boundary_eq_prefix
    (base := base) (cutoff := cutoff) hbase s).symm

end

