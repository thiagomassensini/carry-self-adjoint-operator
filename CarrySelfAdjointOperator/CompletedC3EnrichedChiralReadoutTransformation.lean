import CarrySelfAdjointOperator.CompletedC3CoisometricChiralEnergyBlock
import CarrySelfAdjointOperator.CompletedC3TfvdResolventTraceBridge
import Mathlib.Tactic

/-!
# Enriched C3 chiral readout transformation

The permanent one-point C3 carrier contains both pieces which were separated
by the later scalar construction: its direct coordinate is the completed
ambient Naimark response, while its four trace coordinates generate the full
completed Wronskian state.  This module adjoins the archimedean/chart state and
bundles both extractions as continuous real-linear maps from one common
carrier.

The construction also audits whether the enlarged chiral readout can factor
through the positive Wronskian polarization on the whole ambient carrier.  It
cannot: a pure direct-Naimark coordinate is invisible to the trace projection.
Thus any final intertwiner must be defined on the causal subspace generated by
the canonical completed states, where response and trace are linked, rather
than on the unrestricted direct sum.
-/

open scoped ComplexConjugate InnerProductSpace lp

namespace CarrySelfAdjointOperator

open CPFormal.Analytic.Cp
open NativeCarrySpectralWeyl.Infinite

noncomputable section

/-- Common source carrier retaining the typed ambient response, the completed
all-cutoff state, and the independent archimedean/chart state.  On canonical
states the first coordinate is exactly the Gamma view of the direct coordinate
stored in the one-point state; keeping both types explicit avoids conflating
their distinct scalar-space instances. -/
abbrev CanonicalCompletedC3EnrichedChiralSourceCarrier :=
  WithLp 2
    (CarryGammaComplexNaimark ×
      WithLp 2
        (CanonicalCompletedC3AllCutoffOnePointHilbert ×
          CanonicalCompletedC3ArchimedeanChartOperatorCarrier))

/-- Canonical completed source in the common carrier. -/
def canonicalCompletedC3EnrichedChiralSourceState
    (z : ℂ)
    (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip) :
    CanonicalCompletedC3EnrichedChiralSourceCarrier :=
  WithLp.toLp 2
    (canonicalCompletedC3AmbientResponseState z hzStrip.1,
      WithLp.toLp 2
        (canonicalCompletedC3CompletedOnePointState z hzStrip,
          canonicalCompletedC3ArchimedeanChartOperatorState z))

/-- Direct Naimark coordinate of the enriched source. -/
def canonicalCompletedC3EnrichedDirectNaimarkReadout :
    CanonicalCompletedC3EnrichedChiralSourceCarrier →L[ℝ]
      CarryGammaComplexNaimark :=
  WithLp.fstL 2 ℝ
    CarryGammaComplexNaimark
    (WithLp 2
      (CanonicalCompletedC3AllCutoffOnePointHilbert ×
        CanonicalCompletedC3ArchimedeanChartOperatorCarrier))

/-- Completed scalar `(F,-F')` trace extracted from the same enriched source. -/
def canonicalCompletedC3EnrichedTraceReadout :
    CanonicalCompletedC3EnrichedChiralSourceCarrier →L[ℝ]
      CompletedScalarBoundaryTraceCarrier :=
  canonicalCompletedC3OnePointCompletedTraceProjection.comp
    ((WithLp.fstL 2 ℝ
        CanonicalCompletedC3AllCutoffOnePointHilbert
        CanonicalCompletedC3ArchimedeanChartOperatorCarrier).comp
      (WithLp.sndL 2 ℝ
        CarryGammaComplexNaimark
        (WithLp 2
          (CanonicalCompletedC3AllCutoffOnePointHilbert ×
            CanonicalCompletedC3ArchimedeanChartOperatorCarrier))))

/-- Independent archimedean/chart coordinate. -/
def canonicalCompletedC3EnrichedArchimedeanReadout :
    CanonicalCompletedC3EnrichedChiralSourceCarrier →L[ℝ]
      CanonicalCompletedC3ArchimedeanChartOperatorCarrier :=
  (WithLp.sndL 2 ℝ
      CanonicalCompletedC3AllCutoffOnePointHilbert
      CanonicalCompletedC3ArchimedeanChartOperatorCarrier).comp
    (WithLp.sndL 2 ℝ
      CarryGammaComplexNaimark
      (WithLp 2
        (CanonicalCompletedC3AllCutoffOnePointHilbert ×
          CanonicalCompletedC3ArchimedeanChartOperatorCarrier)))

/-- Complex scalar multiplication bundled as a real-linear continuous map. -/
def canonicalCompletedC3RealifiedComplexScale
    {H : Type*} [NormedAddCommGroup H] [NormedSpace ℂ H]
    (a : ℂ) : H →L[ℝ] H :=
  (a • ContinuousLinearMap.id ℂ H).restrictScalars ℝ

@[simp] theorem canonicalCompletedC3RealifiedComplexScale_apply
    {H : Type*} [NormedAddCommGroup H] [NormedSpace ℂ H]
    (a : ℂ) (x : H) :
    canonicalCompletedC3RealifiedComplexScale a x = a • x :=
  rfl

/-- Chart-normalized full Wronskian state reconstructed linearly from the
trace and chart coordinates of the common source. -/
def canonicalCompletedC3EnrichedNormalizedFullWronskianReadout
    (z : ℂ) :
    CanonicalCompletedC3EnrichedChiralSourceCarrier →L[ℝ]
      CanonicalCompletedC3FullWronskianOperatorCarrier :=
  (WithLp.prodContinuousLinearEquiv 2 ℝ
      CompletedScalarBoundaryTraceCarrier
      CanonicalCompletedC3ArchimedeanChartOperatorCarrier).symm
    |>.toContinuousLinearMap.comp
      (((canonicalCompletedC3RealifiedComplexScale
          ((canonicalC3ChartFactorHeight z)⁻¹ *
            nativeXiCompletionFactor z)).comp
          canonicalCompletedC3EnrichedTraceReadout).prod
        ((canonicalCompletedC3RealifiedComplexScale
          (canonicalC3ChartFactorHeight z)⁻¹).comp
          canonicalCompletedC3EnrichedArchimedeanReadout))

/-- Hermitian involution associated with the full Wronskian complex
structure, bundled as a continuous complex-linear map. -/
def canonicalCompletedC3FullWronskianHermitianInvolutionMap :
    CanonicalCompletedC3FullWronskianOperatorCarrier →L[ℂ]
      CanonicalCompletedC3FullWronskianOperatorCarrier :=
  (-Complex.I) • canonicalCompletedC3FullWronskianOperator

/-- Positive spectral projection of the full Wronskian involution. -/
def canonicalCompletedC3FullWronskianPositiveProjectionMap :
    CanonicalCompletedC3FullWronskianOperatorCarrier →L[ℂ]
      CanonicalCompletedC3FullWronskianOperatorCarrier :=
  (2 : ℂ)⁻¹ •
    ((1 : CanonicalCompletedC3FullWronskianOperatorCarrier →L[ℂ]
      CanonicalCompletedC3FullWronskianOperatorCarrier) +
      canonicalCompletedC3FullWronskianHermitianInvolutionMap)

/-- Negative spectral projection of the full Wronskian involution. -/
def canonicalCompletedC3FullWronskianNegativeProjectionMap :
    CanonicalCompletedC3FullWronskianOperatorCarrier →L[ℂ]
      CanonicalCompletedC3FullWronskianOperatorCarrier :=
  (2 : ℂ)⁻¹ •
    ((1 : CanonicalCompletedC3FullWronskianOperatorCarrier →L[ℂ]
      CanonicalCompletedC3FullWronskianOperatorCarrier) -
      canonicalCompletedC3FullWronskianHermitianInvolutionMap)

@[simp] theorem canonicalCompletedC3FullWronskianPositiveProjectionMap_apply
    (x : CanonicalCompletedC3FullWronskianOperatorCarrier) :
    canonicalCompletedC3FullWronskianPositiveProjectionMap x =
      canonicalCompletedC3FullWronskianPositivePolarization x :=
  rfl

@[simp] theorem canonicalCompletedC3FullWronskianNegativeProjectionMap_apply
    (x : CanonicalCompletedC3FullWronskianOperatorCarrier) :
    canonicalCompletedC3FullWronskianNegativeProjectionMap x =
      canonicalCompletedC3FullWronskianNegativePolarization x :=
  rfl

/-- Positive-chirality readout from the common enriched source. -/
def canonicalCompletedC3EnrichedPositiveChiralReadout
    (z : ℂ) :
    CanonicalCompletedC3EnrichedChiralSourceCarrier →L[ℝ]
      CanonicalCompletedC3FullWronskianOperatorCarrier :=
  canonicalCompletedC3FullWronskianPositiveProjectionMap.restrictScalars ℝ
    |>.comp (canonicalCompletedC3EnrichedNormalizedFullWronskianReadout z)

/-- Negative-chirality readout from the common enriched source. -/
def canonicalCompletedC3EnrichedNegativeChiralReadout
    (z : ℂ) :
    CanonicalCompletedC3EnrichedChiralSourceCarrier →L[ℝ]
      CanonicalCompletedC3FullWronskianOperatorCarrier :=
  canonicalCompletedC3FullWronskianNegativeProjectionMap.restrictScalars ℝ
    |>.comp (canonicalCompletedC3EnrichedNormalizedFullWronskianReadout z)

/-- Scaled ambient Naimark readout carrying the exact diagonal Green
separation in the upper half-plane. -/
def canonicalCompletedC3EnrichedScaledAmbientReadout
    (z : ℂ) :
    CanonicalCompletedC3EnrichedChiralSourceCarrier →L[ℝ]
      CarryGammaComplexNaimark :=
  (canonicalCompletedC3RealifiedComplexScale
      (((Real.sqrt (2 * z.im) : ℝ) : ℂ))).comp
    canonicalCompletedC3EnrichedDirectNaimarkReadout

/-- Enlarged readout retaining the scaled ambient response and the negative
Wronskian chirality as orthogonal coordinates. -/
def canonicalCompletedC3EnrichedCoisometricChiralReadout
    (z : ℂ) :
    CanonicalCompletedC3EnrichedChiralSourceCarrier →L[ℝ]
      CanonicalCompletedC3CoisometricChiralEnergyCarrier :=
  (WithLp.prodContinuousLinearEquiv 2 ℝ
      CarryGammaComplexNaimark
      CanonicalCompletedC3FullWronskianOperatorCarrier).symm
    |>.toContinuousLinearMap.comp
      ((canonicalCompletedC3EnrichedScaledAmbientReadout z).prod
        (canonicalCompletedC3EnrichedNegativeChiralReadout z))

/-! ## Exact action on the canonical completed source -/

theorem canonicalCompletedC3EnrichedDirectNaimarkReadout_sourceState
    (z : ℂ)
    (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip) :
    canonicalCompletedC3EnrichedDirectNaimarkReadout
        (canonicalCompletedC3EnrichedChiralSourceState z hzStrip) =
      canonicalCompletedC3AmbientResponseState z hzStrip.1 :=
  rfl

/-- The explicitly typed ambient coordinate is coherent with the direct
coordinate retained inside the completed one-point state. -/
theorem canonicalCompletedC3EnrichedDirectNaimarkReadout_sourceState_eq_view
    (z : ℂ)
    (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip) :
    canonicalCompletedC3EnrichedDirectNaimarkReadout
        (canonicalCompletedC3EnrichedChiralSourceState z hzStrip) =
      canonicalCompletedC3GammaNaimarkView
        (canonicalCompletedC3CompletedOnePointState z hzStrip).direct :=
  rfl

theorem canonicalCompletedC3EnrichedNormalizedFullWronskianReadout_sourceState
    (z : ℂ)
    (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip) :
    canonicalCompletedC3EnrichedNormalizedFullWronskianReadout z
        (canonicalCompletedC3EnrichedChiralSourceState z hzStrip) =
      canonicalCompletedC3NormalizedFullWronskianFunctionalState z hzStrip := by
  unfold canonicalCompletedC3EnrichedNormalizedFullWronskianReadout
    canonicalCompletedC3EnrichedChiralSourceState
    canonicalCompletedC3EnrichedTraceReadout
    canonicalCompletedC3EnrichedArchimedeanReadout
    canonicalCompletedC3RealifiedComplexScale
    canonicalCompletedC3NormalizedFullWronskianFunctionalState
    canonicalCompletedC3FullWronskianFunctionalState
  change
    WithLp.toLp 2
        (((canonicalC3ChartFactorHeight z)⁻¹ *
              nativeXiCompletionFactor z) •
            canonicalCompletedC3OnePointCompletedTraceProjection
              (canonicalCompletedC3CompletedOnePointState z hzStrip),
          (canonicalC3ChartFactorHeight z)⁻¹ •
            canonicalCompletedC3ArchimedeanChartOperatorState z) =
      (canonicalC3ChartFactorHeight z)⁻¹ •
        WithLp.toLp 2
          (nativeXiCompletionFactor z •
              canonicalCompletedC3OnePointCompletedTraceProjection
                (canonicalCompletedC3CompletedOnePointState z hzStrip),
            canonicalCompletedC3ArchimedeanChartOperatorState z)
  apply WithLp.ofLp_injective 2
  apply Prod.ext
  · exact mul_smul _ _ _
  · rfl

theorem canonicalCompletedC3EnrichedPositiveChiralReadout_sourceState
    (M : ℕ) (z : ℂ)
    (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip) :
    canonicalCompletedC3EnrichedPositiveChiralReadout z
        (canonicalCompletedC3EnrichedChiralSourceState z hzStrip) =
      canonicalCompletedC3FullWronskianPositivePolarization
        (canonicalCompletedC3NormalizedFullWronskianOperatorState M z) := by
  rw [canonicalCompletedC3EnrichedPositiveChiralReadout,
    ContinuousLinearMap.comp_apply,
    canonicalCompletedC3EnrichedNormalizedFullWronskianReadout_sourceState]
  change canonicalCompletedC3FullWronskianPositiveProjectionMap
      (canonicalCompletedC3NormalizedFullWronskianFunctionalState z hzStrip) = _
  rw [canonicalCompletedC3FullWronskianPositiveProjectionMap_apply]
  apply congrArg canonicalCompletedC3FullWronskianPositivePolarization
  unfold canonicalCompletedC3NormalizedFullWronskianFunctionalState
    canonicalCompletedC3NormalizedFullWronskianOperatorState
  exact congrArg
    ((canonicalC3ChartFactorHeight z)⁻¹ • ·)
    (canonicalCompletedC3FullWronskianOperatorState_eq_functionalState
      M hzStrip).symm

theorem canonicalCompletedC3EnrichedNegativeChiralReadout_sourceState
    (M : ℕ) (z : ℂ)
    (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip) :
    canonicalCompletedC3EnrichedNegativeChiralReadout z
        (canonicalCompletedC3EnrichedChiralSourceState z hzStrip) =
      canonicalCompletedC3FullWronskianNegativePolarization
        (canonicalCompletedC3NormalizedFullWronskianOperatorState M z) := by
  rw [canonicalCompletedC3EnrichedNegativeChiralReadout,
    ContinuousLinearMap.comp_apply,
    canonicalCompletedC3EnrichedNormalizedFullWronskianReadout_sourceState]
  change canonicalCompletedC3FullWronskianNegativeProjectionMap
      (canonicalCompletedC3NormalizedFullWronskianFunctionalState z hzStrip) = _
  rw [canonicalCompletedC3FullWronskianNegativeProjectionMap_apply]
  apply congrArg canonicalCompletedC3FullWronskianNegativePolarization
  unfold canonicalCompletedC3NormalizedFullWronskianFunctionalState
    canonicalCompletedC3NormalizedFullWronskianOperatorState
  exact congrArg
    ((canonicalC3ChartFactorHeight z)⁻¹ • ·)
    (canonicalCompletedC3FullWronskianOperatorState_eq_functionalState
      M hzStrip).symm

theorem canonicalCompletedC3EnrichedScaledAmbientReadout_sourceState
    (z : ℂ)
    (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip) :
    canonicalCompletedC3EnrichedScaledAmbientReadout z
        (canonicalCompletedC3EnrichedChiralSourceState z hzStrip) =
      (((Real.sqrt (2 * z.im) : ℝ) : ℂ) •
        canonicalCompletedC3AmbientResponseState z hzStrip.1) := by
  unfold canonicalCompletedC3EnrichedScaledAmbientReadout
  rw [ContinuousLinearMap.comp_apply,
    canonicalCompletedC3EnrichedDirectNaimarkReadout_sourceState]
  rfl

/-- Both sides of the final norm gate are now literal linear readouts of the
same enriched completed source. -/
theorem canonicalCompletedC3EnrichedCoisometricChiralReadout_sourceState
    (M : ℕ) (z : ℂ)
    (hzStrip : operatorHeightParameter z ∈ genuineCriticalStrip) :
    canonicalCompletedC3EnrichedCoisometricChiralReadout z
        (canonicalCompletedC3EnrichedChiralSourceState z hzStrip) =
      canonicalCompletedC3CoisometricChiralEnergyState M z hzStrip.1 := by
  apply WithLp.ofLp_injective 2
  apply Prod.ext
  · exact canonicalCompletedC3EnrichedScaledAmbientReadout_sourceState
      z hzStrip
  · exact canonicalCompletedC3EnrichedNegativeChiralReadout_sourceState
      M z hzStrip

/-! ## Global factorization audit -/

/-- An unrestricted source carrying only a direct Naimark coordinate. -/
def canonicalCompletedC3EnrichedDirectOnlySource
    (u : CarryGammaComplexNaimark) :
    CanonicalCompletedC3EnrichedChiralSourceCarrier :=
  WithLp.toLp 2 (u, 0)

@[simp] theorem canonicalCompletedC3EnrichedDirectNaimarkReadout_directOnly
    (u : CarryGammaComplexNaimark) :
    canonicalCompletedC3EnrichedDirectNaimarkReadout
        (canonicalCompletedC3EnrichedDirectOnlySource u) = u :=
  rfl

@[simp] theorem canonicalCompletedC3EnrichedTraceReadout_directOnly
    (u : CarryGammaComplexNaimark) :
    canonicalCompletedC3EnrichedTraceReadout
        (canonicalCompletedC3EnrichedDirectOnlySource u) = 0 := by
  unfold canonicalCompletedC3EnrichedTraceReadout
    canonicalCompletedC3EnrichedDirectOnlySource
  simp [CanonicalCompletedC3AllCutoffOnePointHilbert.completedCompanion,
    CanonicalCompletedC3AllCutoffOnePointHilbert.completedValue,
    CanonicalCompletedC3AllCutoffOnePointHilbert.valueHead,
    CanonicalCompletedC3AllCutoffOnePointHilbert.logJetHead,
    CanonicalCompletedC3AllCutoffOnePointHilbert.valueTail,
    CanonicalCompletedC3AllCutoffOnePointHilbert.logJetTail]

@[simp] theorem canonicalCompletedC3EnrichedArchimedeanReadout_directOnly
    (u : CarryGammaComplexNaimark) :
    canonicalCompletedC3EnrichedArchimedeanReadout
        (canonicalCompletedC3EnrichedDirectOnlySource u) = 0 :=
  rfl

@[simp] theorem canonicalCompletedC3EnrichedNormalizedFullWronskianReadout_directOnly
    (z : ℂ) (u : CarryGammaComplexNaimark) :
    canonicalCompletedC3EnrichedNormalizedFullWronskianReadout z
        (canonicalCompletedC3EnrichedDirectOnlySource u) = 0 := by
  unfold canonicalCompletedC3EnrichedNormalizedFullWronskianReadout
    canonicalCompletedC3RealifiedComplexScale
  simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.prod_apply,
    canonicalCompletedC3EnrichedTraceReadout_directOnly,
    canonicalCompletedC3EnrichedArchimedeanReadout_directOnly, map_zero]
  exact map_zero _

@[simp] theorem canonicalCompletedC3EnrichedPositiveChiralReadout_directOnly
    (z : ℂ) (u : CarryGammaComplexNaimark) :
    canonicalCompletedC3EnrichedPositiveChiralReadout z
        (canonicalCompletedC3EnrichedDirectOnlySource u) = 0 := by
  rw [canonicalCompletedC3EnrichedPositiveChiralReadout,
    ContinuousLinearMap.comp_apply,
    canonicalCompletedC3EnrichedNormalizedFullWronskianReadout_directOnly,
    map_zero]

theorem canonicalCompletedC3EnrichedCoisometricChiralReadout_directOnly_ne_zero
    (z : ℂ) (hzIm : 0 < z.im)
    (u : CarryGammaComplexNaimark) (hu : u ≠ 0) :
    canonicalCompletedC3EnrichedCoisometricChiralReadout z
        (canonicalCompletedC3EnrichedDirectOnlySource u) ≠ 0 := by
  intro hzero
  have hfst := congrArg WithLp.fst hzero
  change (((Real.sqrt (2 * z.im) : ℝ) : ℂ) •
      u) = 0 at hfst
  have hsqrtReal : Real.sqrt (2 * z.im) ≠ 0 := by
    positivity
  have hsqrt : (((Real.sqrt (2 * z.im) : ℝ) : ℂ)) ≠ 0 := by
    exact_mod_cast hsqrtReal
  exact (smul_ne_zero hsqrt hu) hfst

/-- There is no global linear transformation from the positive Wronskian
readout to the enlarged coisometric/chiral readout.  The trace projection has
a concrete direct-Naimark kernel direction which the enlarged readout retains.
-/
theorem no_global_enrichedPositive_to_coisometricChiral_factorization
    (z : ℂ) (hzIm : 0 < z.im)
    (u : CarryGammaComplexNaimark) (hu : u ≠ 0) :
    ¬ ∃ T :
        CanonicalCompletedC3FullWronskianOperatorCarrier →L[ℝ]
          CanonicalCompletedC3CoisometricChiralEnergyCarrier,
      canonicalCompletedC3EnrichedCoisometricChiralReadout z =
        T.comp (canonicalCompletedC3EnrichedPositiveChiralReadout z) := by
  rintro ⟨T, hfactor⟩
  have happ := congrArg
    (fun f : CanonicalCompletedC3EnrichedChiralSourceCarrier →L[ℝ]
        CanonicalCompletedC3CoisometricChiralEnergyCarrier =>
      f (canonicalCompletedC3EnrichedDirectOnlySource u)) hfactor
  rw [ContinuousLinearMap.comp_apply,
    canonicalCompletedC3EnrichedPositiveChiralReadout_directOnly,
    map_zero] at happ
  exact
    (canonicalCompletedC3EnrichedCoisometricChiralReadout_directOnly_ne_zero
      z hzIm u hu) happ

end

end CarrySelfAdjointOperator
