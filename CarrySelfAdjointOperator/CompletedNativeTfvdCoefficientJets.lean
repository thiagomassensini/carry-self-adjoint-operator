import CarrySelfAdjointOperator.CompletedC3DirichletGradientBracketSource
import Mathlib.Tactic

/-!
# Finite all-order TFVD coefficient jets

The finite C3 source is generated by the complete vector of Dirichlet-slope
coefficients, not by a fixed-camera incidence.  This module names those
coefficient jets before transport and records the exact commuting squares for
the finite TFVD synthesis, weighted bracket source, causal Green response, and
boundary return.

All statements are vector-valued.  No Gram identity, zero condition, or
spectral hypothesis is used.
-/

open scoped BigOperators lp ENNReal NNReal

namespace CarrySelfAdjointOperator

open CPFormal.Analytic.Cp

noncomputable section

/-- Coefficient state on the centered real-height line.  Although the
forward-difference samples are real, retaining a complex argument lets the
existing canonical jet operator be used without a second interface. -/
def canonicalCompletedC3DirichletGradientCoefficientRealAxisState
    (base cutoff : ℕ) (z : ℂ) :
    Fin (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1) → ℂ :=
  canonicalCompletedC3DirichletGradientSlopeCoefficients base cutoff
    (operatorHeightParameter z)

/-- Finite all-order parity jet before any source, Green, or boundary
transport. -/
def canonicalCompletedC3DirichletGradientCoefficientParityJet
    (base cutoff k : ℕ) :
    (ℕ ⊕ ℕ) →
      (Fin (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1) → ℂ) :=
  completedGreenForwardDifferenceParityJet
    (canonicalCompletedC3DirichletGradientCoefficientRealAxisState base cutoff) k

/-- Normalized forward differences commute with every complex-linear map. -/
theorem completedGreenForwardDifferenceJet_linearMap
    {E F : Type*} [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    (T : E →ₗ[ℂ] F) (state : ℂ → E) (h : ℂ) (order : ℕ) :
    completedGreenForwardDifferenceJet (fun z ↦ T (state z)) h order =
      T (completedGreenForwardDifferenceJet state h order) := by
  rw [completedGreenForwardDifferenceJet,
    completedGreenForwardDifferenceJet,
    completedGreenForwardDifference_iter_linearMap T h state order]
  exact (T.map_smul _ _).symm

/-- Parity packaging preserves the same linear commuting square. -/
theorem completedGreenForwardDifferenceParityJet_linearMap
    {E F : Type*} [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    (T : E →ₗ[ℂ] F) (state : ℂ → E) (k : ℕ) (i : ℕ ⊕ ℕ) :
    completedGreenForwardDifferenceParityJet (fun z ↦ T (state z)) k i =
      T (completedGreenForwardDifferenceParityJet state k i) := by
  cases i <;>
    exact completedGreenForwardDifferenceJet_linearMap T state
      (canonicalGreenJetStep k) _

/-- The finite TFVD synthesis is injective by exact coordinate evaluation. -/
theorem finiteSlopeCoefficientSynthesisLinearMap_injective (N : ℕ) :
    Function.Injective (finiteSlopeCoefficientSynthesisLinearMap N) := by
  intro a b hab
  funext i
  have hi := congrArg (fun x : CarryVerticalL2 ↦ x i.val) hab
  simpa [finiteSlopeCoefficientSynthesisLinearMap_apply,
    finiteSlopeCoefficientState_apply_of_lt a i.isLt,
    finiteSlopeCoefficientState_apply_of_lt b i.isLt] using hi

/-- Boundary-return channel generated by a finite slope coefficient vector. -/
def finiteWeightedSlopeBoundaryReturnLinearMap
    (q : ℝ) (hq0 : 0 ≤ q) (hq1 : q < 1) (N : ℕ) :
    (Fin N → ℂ) →ₗ[ℂ] CarryVerticalL2 :=
  (carryWeightedVerticalReturn q hq0 hq1).toLinearMap.comp
    ((carryWeightedVerticalTrace q).toLinearMap.comp
      (finiteSlopeCoefficientSynthesisLinearMap N))

@[simp] theorem finiteWeightedSlopeBoundaryReturnLinearMap_apply
    (q : ℝ) (hq0 : 0 ≤ q) (hq1 : q < 1)
    {N : ℕ} (coeff : Fin N → ℂ) :
    finiteWeightedSlopeBoundaryReturnLinearMap q hq0 hq1 N coeff =
      carryWeightedVerticalReturn q hq0 hq1
        (carryWeightedVerticalTrace q (finiteSlopeCoefficientState coeff)) :=
  rfl

/-- Exact finite TFVD factorization on every coefficient vector.  The boundary
return remains an explicit summand. -/
theorem finiteWeightedSlopeGreenResponse_add_boundaryReturn
    (q : ℝ) (hqpos : 0 < q) (hq1 : q < 1)
    (N : ℕ) (coeff : Fin N → ℂ) :
    finiteWeightedSlopeGreenResponseLinearMap q N coeff +
        finiteWeightedSlopeBoundaryReturnLinearMap q hqpos.le hq1 N coeff =
      finiteSlopeCoefficientSynthesisLinearMap N coeff := by
  change carryVerticalL2WeightedGreen q
          (carryWeightedVerticalCenteredBracket q
            (finiteSlopeCoefficientState coeff)) +
        carryWeightedVerticalReturn q hqpos.le hq1
          (carryWeightedVerticalTrace q (finiteSlopeCoefficientState coeff)) =
      finiteSlopeCoefficientState coeff
  ext n
  exact carryWeightedVerticalTfvd_apply q hqpos hq1
    (finiteSlopeCoefficientState coeff) n

/-- Every finite TFVD prefix parity jet is exactly the synthesis of its
coefficient parity jet. -/
theorem canonicalCompletedC3DirichletGradientPrefix_parityJet_eq_synthesis
    (base cutoff k : ℕ) (i : ℕ ⊕ ℕ) :
    completedGreenForwardDifferenceParityJet
        (fun z ↦ canonicalCompletedC3DirichletGradientPrefixState
          (operatorHeightParameter z)
          (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1))
        k i =
      finiteSlopeCoefficientSynthesisLinearMap
          (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1)
        (canonicalCompletedC3DirichletGradientCoefficientParityJet
          base cutoff k i) := by
  have hstate :
      (fun z ↦ canonicalCompletedC3DirichletGradientPrefixState
        (operatorHeightParameter z)
        (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1)) =
      fun z ↦ finiteSlopeCoefficientSynthesisLinearMap
          (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1)
        (canonicalCompletedC3DirichletGradientCoefficientRealAxisState
          base cutoff z) := by
    funext z
    exact (finiteSlopeCoefficientState_canonicalDirichletGradientCoefficients
      base cutoff (operatorHeightParameter z)).symm
  rw [hstate]
  exact completedGreenForwardDifferenceParityJet_linearMap
    (finiteSlopeCoefficientSynthesisLinearMap
      (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1))
    (canonicalCompletedC3DirichletGradientCoefficientRealAxisState base cutoff)
    k i

/-- Every finite source parity jet is the fixed reverse-triangular source map
of the coefficient parity jet. -/
theorem canonicalCompletedC3DirichletGradientBracketSource_parityJet_eq_map
    (base cutoff k : ℕ) (i : ℕ ⊕ ℕ) :
    completedGreenForwardDifferenceParityJet
        (fun z ↦ canonicalCompletedC3DirichletGradientBracketSource
          base cutoff (operatorHeightParameter z)) k i =
      finiteWeightedSlopeSourceLinearMap
          (canonicalBR2CarryAmplitudeRatio base)
          (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1)
        (canonicalCompletedC3DirichletGradientCoefficientParityJet
          base cutoff k i) := by
  have hstate :
      (fun z ↦ canonicalCompletedC3DirichletGradientBracketSource
        base cutoff (operatorHeightParameter z)) =
      fun z ↦ finiteWeightedSlopeSourceLinearMap
          (canonicalBR2CarryAmplitudeRatio base)
          (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1)
        (canonicalCompletedC3DirichletGradientCoefficientRealAxisState
          base cutoff z) := by
    funext z
    exact canonicalCompletedC3DirichletGradientBracketSource_eq_sourceLinearMap
      base cutoff (operatorHeightParameter z)
  rw [hstate]
  exact completedGreenForwardDifferenceParityJet_linearMap
    (finiteWeightedSlopeSourceLinearMap
      (canonicalBR2CarryAmplitudeRatio base)
      (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1))
    (canonicalCompletedC3DirichletGradientCoefficientRealAxisState base cutoff)
    k i

/-- Every finite causal Green-response parity jet is the same injective
response map applied to the coefficient parity jet. -/
theorem canonicalCompletedC3DirichletGradientGreenResponse_parityJet_eq_map
    (base cutoff k : ℕ) (i : ℕ ⊕ ℕ) :
    completedGreenForwardDifferenceParityJet
        (fun z ↦ canonicalCompletedC3DirichletGradientBracketGreenResponse
          base cutoff (operatorHeightParameter z)) k i =
      finiteWeightedSlopeGreenResponseLinearMap
          (canonicalBR2CarryAmplitudeRatio base)
          (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1)
        (canonicalCompletedC3DirichletGradientCoefficientParityJet
          base cutoff k i) := by
  have hstate :
      (fun z ↦ canonicalCompletedC3DirichletGradientBracketGreenResponse
        base cutoff (operatorHeightParameter z)) =
      fun z ↦ finiteWeightedSlopeGreenResponseLinearMap
          (canonicalBR2CarryAmplitudeRatio base)
          (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1)
        (canonicalCompletedC3DirichletGradientCoefficientRealAxisState
          base cutoff z) := by
    funext z
    exact
      canonicalCompletedC3DirichletGradientBracketGreenResponse_eq_responseLinearMap
        base cutoff (operatorHeightParameter z)
  rw [hstate]
  exact completedGreenForwardDifferenceParityJet_linearMap
    (finiteWeightedSlopeGreenResponseLinearMap
      (canonicalBR2CarryAmplitudeRatio base)
      (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1))
    (canonicalCompletedC3DirichletGradientCoefficientRealAxisState base cutoff)
    k i

/-- Channel-complete finite jet identity.  Response and boundary are
differenced separately and recombine exactly into the TFVD prefix jet. -/
theorem canonicalCompletedC3DirichletGradient_response_add_boundary_parityJet
    {base : ℕ} (hbase : FiniteNativeCarryOperator.Camera.IsSupported base)
    (cutoff k : ℕ) (i : ℕ ⊕ ℕ) :
    let N := NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1
    completedGreenForwardDifferenceParityJet
        (fun z ↦ canonicalCompletedC3DirichletGradientBracketGreenResponse
          base cutoff (operatorHeightParameter z)) k i +
      finiteWeightedSlopeBoundaryReturnLinearMap
          (canonicalBR2CarryAmplitudeRatio base)
          (canonicalBR2CarryAmplitudeRatio_pos hbase).le
          (canonicalBR2CarryAmplitudeRatio_lt_one hbase) N
        (canonicalCompletedC3DirichletGradientCoefficientParityJet
          base cutoff k i) =
      completedGreenForwardDifferenceParityJet
        (fun z ↦ canonicalCompletedC3DirichletGradientPrefixState
          (operatorHeightParameter z) N) k i := by
  dsimp only
  rw [canonicalCompletedC3DirichletGradientGreenResponse_parityJet_eq_map,
    canonicalCompletedC3DirichletGradientPrefix_parityJet_eq_synthesis]
  exact finiteWeightedSlopeGreenResponse_add_boundaryReturn
    (canonicalBR2CarryAmplitudeRatio base)
    (canonicalBR2CarryAmplitudeRatio_pos hbase)
    (canonicalBR2CarryAmplitudeRatio_lt_one hbase)
    (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1)
    (canonicalCompletedC3DirichletGradientCoefficientParityJet
      base cutoff k i)

/-! ## The coefficient-level Vandermonde family -/

/-- Critical-line amplitude at the positive integer `m`. -/
def nativeCriticalDirichletAmplitude (m : ℕ) : ℂ :=
  natDirichletTerm (1 / 2 : ℂ) m

/-- Consecutive slope of the odd logarithmic power `2 * order + 1`.
This is the common coordinate family read by the odd ordinary jets and by the
even log-jet channel, up to nonzero order-dependent scalars. -/
def nativeOddLogPowerSlopeJet (order : ℕ) : ℕ → ℂ :=
  fun n ↦
    nativeCriticalDirichletAmplitude (n + 2) *
        (Real.log ((n + 2 : ℕ) : ℝ) : ℂ) ^ (2 * order + 1) -
      nativeCriticalDirichletAmplitude (n + 1) *
        (Real.log ((n + 1 : ℕ) : ℝ) : ℂ) ^ (2 * order + 1)

/-- Telescoping the slope ledger recovers one weighted logarithmic spectral
coordinate.  The lower endpoint vanishes because `log 1 = 0` and the power is
strictly positive. -/
theorem sum_nativeOddLogPowerSlopeJet
    (order horizon : ℕ) :
    ∑ n ∈ Finset.range horizon, nativeOddLogPowerSlopeJet order n =
      nativeCriticalDirichletAmplitude (horizon + 1) *
        (Real.log ((horizon + 1 : ℕ) : ℝ) : ℂ) ^ (2 * order + 1) := by
  let value : ℕ → ℂ := fun m ↦
    nativeCriticalDirichletAmplitude (m + 1) *
      (Real.log ((m + 1 : ℕ) : ℝ) : ℂ) ^ (2 * order + 1)
  have htelescope := Finset.sum_range_sub value horizon
  change (∑ n ∈ Finset.range horizon, (value (n + 1) - value n)) = _
  rw [htelescope]
  simp [value]

/-- The positive squared logarithmic frequencies used by every finite
Vandermonde readout are pairwise distinct. -/
theorem nativePositiveLogSquaredFrequency_injective (N : ℕ) :
    Function.Injective
      (fun j : Fin N ↦
        ((Real.log ((j.val + 2 : ℕ) : ℝ) ^ 2 : ℝ) : ℂ)) := by
  intro i j hij
  apply Fin.ext
  have hsquare :
      Real.log ((i.val + 2 : ℕ) : ℝ) ^ 2 =
        Real.log ((j.val + 2 : ℕ) : ℝ) ^ 2 :=
    Complex.ofReal_injective hij
  have hiLog : 0 ≤ Real.log ((i.val + 2 : ℕ) : ℝ) := by
    exact (Real.log_pos (by exact_mod_cast (show 1 < i.val + 2 by omega))).le
  have hjLog : 0 ≤ Real.log ((j.val + 2 : ℕ) : ℝ) := by
    exact (Real.log_pos (by exact_mod_cast (show 1 < j.val + 2 by omega))).le
  have hlog :
      Real.log ((i.val + 2 : ℕ) : ℝ) =
        Real.log ((j.val + 2 : ℕ) : ℝ) :=
    (sq_eq_sq₀ hiLog hjLog).mp hsquare
  have hcast : ((i.val + 2 : ℕ) : ℝ) = ((j.val + 2 : ℕ) : ℝ) := by
    exact Real.log_injOn_pos
      (show 0 < ((i.val + 2 : ℕ) : ℝ) by positivity)
      (show 0 < ((j.val + 2 : ℕ) : ℝ) by positivity) hlog
  have hnat : i.val + 2 = j.val + 2 := by
    exact_mod_cast hcast
  omega

/-- The first `N` odd-log slope vectors are complex-linearly independent.
The proof uses only finite coordinate sums and the Vandermonde determinant. -/
theorem nativeOddLogPowerSlopeJet_prefix_linearIndependent (N : ℕ) :
    LinearIndependent ℂ
      (fun i : Fin N ↦ nativeOddLogPowerSlopeJet i.val) := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro coeff hsum i
  let frequency : Fin N → ℂ := fun j ↦
    ((Real.log ((j.val + 2 : ℕ) : ℝ) ^ 2 : ℝ) : ℂ)
  have hcoordinate (n : ℕ) :
      ∑ r : Fin N, coeff r * nativeOddLogPowerSlopeJet r.val n = 0 := by
    have h := congrArg (fun state : ℕ → ℂ ↦ state n) hsum
    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
      Pi.zero_apply] using h
  have hcumulative (j : Fin N) :
      ∑ r : Fin N,
          coeff r *
            (nativeCriticalDirichletAmplitude (j.val + 2) *
              (Real.log ((j.val + 2 : ℕ) : ℝ) : ℂ) ^
                (2 * r.val + 1)) = 0 := by
    calc
      _ = ∑ n ∈ Finset.range (j.val + 1),
          ∑ r : Fin N, coeff r * nativeOddLogPowerSlopeJet r.val n := by
            rw [Finset.sum_comm]
            apply Finset.sum_congr rfl
            intro r hr
            rw [← Finset.mul_sum, sum_nativeOddLogPowerSlopeJet]
      _ = 0 := by
            apply Finset.sum_eq_zero
            intro n hn
            exact hcoordinate n
  have hvandermonde (j : Fin N) :
      ∑ r : Fin N, coeff r * frequency j ^ r.val = 0 := by
    let amplitude := nativeCriticalDirichletAmplitude (j.val + 2)
    let logFrequency : ℂ := (Real.log ((j.val + 2 : ℕ) : ℝ) : ℂ)
    have hamp : amplitude ≠ 0 := by
      unfold amplitude nativeCriticalDirichletAmplitude natDirichletTerm
        dirichletTerm
      simpa [show (j.val + 2 : ℕ) = (j.val + 1) + 1 by omega] using
        Complex.natCast_add_one_cpow_ne_zero (j.val + 1) (-(1 / 2 : ℂ))
    have hlog : logFrequency ≠ 0 := by
      apply Complex.ofReal_ne_zero.mpr
      apply (Real.log_pos ?_).ne'
      exact_mod_cast (show 1 < j.val + 2 by omega)
    have hfactor :
        amplitude * logFrequency *
            (∑ r : Fin N, coeff r * frequency j ^ r.val) =
          ∑ r : Fin N,
            coeff r *
              (nativeCriticalDirichletAmplitude (j.val + 2) *
                (Real.log ((j.val + 2 : ℕ) : ℝ) : ℂ) ^
                  (2 * r.val + 1)) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro r hr
      dsimp only [frequency, amplitude, logFrequency]
      push_cast
      rw [← pow_mul, pow_add]
      ring
    have hzero : amplitude * logFrequency *
        (∑ r : Fin N, coeff r * frequency j ^ r.val) = 0 := by
      rw [hfactor]
      exact hcumulative j
    exact (mul_eq_zero.mp hzero).resolve_left (mul_ne_zero hamp hlog)
  have hcoeff : coeff = 0 :=
    Matrix.eq_zero_of_forall_index_sum_mul_pow_eq_zero
      (nativePositiveLogSquaredFrequency_injective N) hvandermonde
  exact congrFun hcoeff i

/-- Global coefficient independence follows from the exact finite
Vandermonde readout of every initial prefix, not from convergence of cutoff
vectors. -/
theorem nativeOddLogPowerSlopeJet_linearIndependent :
    LinearIndependent ℂ nativeOddLogPowerSlopeJet := by
  rw [linearIndependent_iff_finset_linearIndependent]
  intro indices
  obtain ⟨N, hN⟩ := Finset.exists_nat_subset_range indices
  let embed : indices → Fin N := fun i ↦
    ⟨i.val, Finset.mem_range.mp (hN i.property)⟩
  have hembed : Function.Injective embed := by
    intro i j hij
    apply Subtype.ext
    exact congrArg Fin.val hij
  exact (nativeOddLogPowerSlopeJet_prefix_linearIndependent N).comp embed hembed

/-! ## Exact coefficient limits from the logarithmic orbit -/

/-- Iterated forward differences of one exponential orbit are exact powers of
its one-step multiplier. -/
theorem completedGreenForwardDifference_iter_exp_const_mul
    (c h : ℂ) (order : ℕ) :
    (completedGreenForwardDifference h)^[order]
        (fun z : ℂ ↦ Complex.exp (c * z)) =
      fun z ↦ (Complex.exp (c * h) - 1) ^ order * Complex.exp (c * z) := by
  induction order with
  | zero => simp
  | succ order ih =>
      rw [Function.iterate_succ_apply', ih]
      funext z
      simp only [completedGreenForwardDifference]
      rw [mul_add, Complex.exp_add]
      ring

/-- The canonical normalized forward-difference jet of one exponential orbit
converges to its Taylor coefficient. -/
theorem completedGreenForwardDifferenceJet_exp_const_mul_tendsto
    (c : ℂ) (order : ℕ) :
    Filter.Tendsto
      (fun k ↦ completedGreenForwardDifferenceJet
        (fun z : ℂ ↦ Complex.exp (c * z)) (canonicalGreenJetStep k) order)
      Filter.atTop
      (nhds (c ^ order / (order.factorial : ℂ))) := by
  have hratio : Filter.Tendsto
      (fun k ↦ (Complex.exp (c * canonicalGreenJetStep k) - 1) /
        canonicalGreenJetStep k)
      Filter.atTop (nhds c) := by
    by_cases hc : c = 0
    · subst c
      simp
    · have hcstepWithin : Filter.Tendsto
          (fun k ↦ c * canonicalGreenJetStep k) Filter.atTop
          (nhdsWithin 0 ({0}ᶜ : Set ℂ)) := by
        rw [tendsto_nhdsWithin_iff]
        refine ⟨by simpa using
          canonicalGreenJetStep_tendsto_zero.const_mul c, ?_⟩
        filter_upwards with k
        exact Set.mem_compl_singleton_iff.mpr
          (mul_ne_zero hc
            (inv_ne_zero (by exact_mod_cast Nat.succ_ne_zero k)))
      have hslope := (Complex.hasDerivAt_exp 0).tendsto_slope_zero.comp
        hcstepWithin
      have hscaled := hslope.const_mul c
      have hscaled' : Filter.Tendsto
          (fun k ↦ c * ((c * canonicalGreenJetStep k)⁻¹ *
            (Complex.exp (c * canonicalGreenJetStep k) - 1)))
          Filter.atTop (nhds c) := by
        simpa [Function.comp_def, smul_eq_mul] using hscaled
      convert hscaled' using 1
      funext k
      have hstep : canonicalGreenJetStep k ≠ 0 := by
        exact inv_ne_zero (by exact_mod_cast Nat.succ_ne_zero k)
      field_simp [hc, hstep]
  have hlimit := (hratio.pow order).div_const (order.factorial : ℂ)
  apply hlimit.congr'
  filter_upwards with k
  have hstep : canonicalGreenJetStep k ≠ 0 := by
    exact inv_ne_zero (by exact_mod_cast Nat.succ_ne_zero k)
  rw [completedGreenForwardDifferenceJet,
    completedGreenForwardDifference_iter_exp_const_mul]
  simp only [Complex.exp_zero, mul_zero, smul_eq_mul]
  rw [div_pow]
  field_simp [hstep, order.factorial_ne_zero]

/-- A positive Dirichlet atom on the centered line is exactly the orbit of
its critical amplitude under the logarithmic frequency `-I log m`. -/
theorem natDirichletTerm_operatorHeightParameter_eq_logOrbit
    {m : ℕ} (hm : 0 < m) (z : ℂ) :
    natDirichletTerm (operatorHeightParameter z) m =
      nativeCriticalDirichletAmplitude m *
        Complex.exp ((-Complex.I * (Real.log (m : ℝ) : ℂ)) * z) := by
  have hmC : (m : ℂ) ≠ 0 := by exact_mod_cast hm.ne'
  have hlog : Complex.log (m : ℂ) = (Real.log (m : ℝ) : ℂ) := by
    exact (Complex.ofReal_log (by positivity)).symm
  simp only [nativeCriticalDirichletAmplitude, natDirichletTerm,
    dirichletTerm, operatorHeightParameter]
  push_cast
  rw [Complex.cpow_def_of_ne_zero hmC,
    Complex.cpow_def_of_ne_zero hmC, ← Complex.exp_add]
  congr 1
  ring

/-- Exact scalar Taylor coefficient of every positive Dirichlet atom, obtained
from the self-adjoint logarithmic orbit rather than from a zero table. -/
theorem completedGreenForwardDifferenceJet_natDirichletTerm_tendsto
    {m : ℕ} (hm : 0 < m) (order : ℕ) :
    Filter.Tendsto
      (fun k ↦ completedGreenForwardDifferenceJet
        (fun z ↦ natDirichletTerm (operatorHeightParameter z) m)
        (canonicalGreenJetStep k) order)
      Filter.atTop
      (nhds (nativeCriticalDirichletAmplitude m *
        (-Complex.I * (Real.log (m : ℝ) : ℂ)) ^ order /
          (order.factorial : ℂ))) := by
  have hstate :
      (fun z ↦ natDirichletTerm (operatorHeightParameter z) m) =
        fun z ↦ nativeCriticalDirichletAmplitude m *
          Complex.exp ((-Complex.I * (Real.log (m : ℝ) : ℂ)) * z) := by
    funext z
    exact natDirichletTerm_operatorHeightParameter_eq_logOrbit hm z
  rw [hstate]
  have hlimit := (completedGreenForwardDifferenceJet_exp_const_mul_tendsto
    (-Complex.I * (Real.log (m : ℝ) : ℂ)) order).const_mul
      (nativeCriticalDirichletAmplitude m)
  convert hlimit using 1
  · funext k
    change completedGreenForwardDifferenceJet
        (fun z ↦ (LinearMap.mulLeft ℂ (nativeCriticalDirichletAmplitude m))
          (Complex.exp ((-Complex.I * (Real.log (m : ℝ) : ℂ)) * z)))
        (canonicalGreenJetStep k) order = _
    rw [completedGreenForwardDifferenceJet_linearMap]
    exact LinearMap.mulLeft_apply ℂ _ _
  · ring

/-- Normalized forward differences preserve subtraction exactly. -/
theorem completedGreenForwardDifferenceJet_sub
    {E : Type*} [AddCommGroup E] [Module ℂ E]
    (left right : ℂ → E) (h : ℂ) (order : ℕ) :
    completedGreenForwardDifferenceJet (fun z ↦ left z - right z) h order =
      completedGreenForwardDifferenceJet left h order -
        completedGreenForwardDifferenceJet right h order := by
  unfold completedGreenForwardDifferenceJet
  have hiter :
      (completedGreenForwardDifference h)^[order]
          (fun z ↦ left z - right z) =
        fun z ↦
          (completedGreenForwardDifference h)^[order] left z -
            (completedGreenForwardDifference h)^[order] right z := by
    induction order with
    | zero => rfl
    | succ order ih =>
        rw [Function.iterate_succ_apply', Function.iterate_succ_apply',
          Function.iterate_succ_apply', ih]
        funext z
        simp only [completedGreenForwardDifference]
        abel
  rw [hiter]
  module

/-- Coordinate evaluation commutes with normalized forward differences. -/
theorem completedGreenForwardDifferenceJet_apply
    {ι : Type*} (state : ℂ → (ι → ℂ))
    (h : ℂ) (order : ℕ) (i : ι) :
    completedGreenForwardDifferenceJet state h order i =
      completedGreenForwardDifferenceJet (fun z ↦ state z i) h order := by
  exact (completedGreenForwardDifferenceJet_linearMap
    (LinearMap.proj i) state h order).symm

/-- Exact Taylor coefficient of one ordinary Dirichlet slope coordinate. -/
def nativeDirichletSlopeTaylorCoefficient (order n : ℕ) : ℂ :=
  nativeCriticalDirichletAmplitude (n + 2) *
        (-Complex.I * (Real.log ((n + 2 : ℕ) : ℝ) : ℂ)) ^ order /
      (order.factorial : ℂ) -
    nativeCriticalDirichletAmplitude (n + 1) *
        (-Complex.I * (Real.log ((n + 1 : ℕ) : ℝ) : ℂ)) ^ order /
      (order.factorial : ℂ)

/-- Every finite coefficient jet converges coordinatewise to the exact
logarithmic-orbit Taylor coefficient.  This is a finite coordinate readout,
not a claim that cutoff-wise linear independence survives a vector limit. -/
theorem canonicalCompletedC3DirichletGradientCoefficientParityJet_apply_tendsto
    (base cutoff : ℕ)
    (i : Fin (NativeCarrySpectralWeyl.Limits.finiteCameraWindow base cutoff + 1))
    (parityOrder : ℕ ⊕ ℕ) :
    Filter.Tendsto
      (fun k ↦ canonicalCompletedC3DirichletGradientCoefficientParityJet
        base cutoff k parityOrder i)
      Filter.atTop
      (nhds (nativeDirichletSlopeTaylorCoefficient
        (completedGreenParityOrder parityOrder) i.val)) := by
  let order := completedGreenParityOrder parityOrder
  have hleft := completedGreenForwardDifferenceJet_natDirichletTerm_tendsto
    (m := i.val + 2) (by omega) order
  have hright := completedGreenForwardDifferenceJet_natDirichletTerm_tendsto
    (m := i.val + 1) (by omega) order
  have hsub := hleft.sub hright
  cases parityOrder with
  | inl n =>
      simp only [canonicalCompletedC3DirichletGradientCoefficientParityJet,
        completedGreenForwardDifferenceParityJet, completedGreenParityOrder]
      simp_rw [completedGreenForwardDifferenceJet_apply]
      simp only [
        canonicalCompletedC3DirichletGradientCoefficientRealAxisState,
        canonicalCompletedC3DirichletGradientSlopeCoefficients,
        positiveDirichletGradient]
      change Filter.Tendsto
        (fun k ↦ completedGreenForwardDifferenceJet
          (fun z ↦ natDirichletTerm (operatorHeightParameter z) (i.val + 2) -
            natDirichletTerm (operatorHeightParameter z) (i.val + 1))
          (canonicalGreenJetStep k) (2 * n))
        Filter.atTop
        (nhds (nativeDirichletSlopeTaylorCoefficient (2 * n) i.val))
      apply hsub.congr'
      filter_upwards with k
      exact (completedGreenForwardDifferenceJet_sub
        (fun z ↦ natDirichletTerm (operatorHeightParameter z) (i.val + 2))
        (fun z ↦ natDirichletTerm (operatorHeightParameter z) (i.val + 1))
        (canonicalGreenJetStep k) (2 * n)).symm
  | inr n =>
      simp only [canonicalCompletedC3DirichletGradientCoefficientParityJet,
        completedGreenForwardDifferenceParityJet, completedGreenParityOrder]
      simp_rw [completedGreenForwardDifferenceJet_apply]
      simp only [
        canonicalCompletedC3DirichletGradientCoefficientRealAxisState,
        canonicalCompletedC3DirichletGradientSlopeCoefficients,
        positiveDirichletGradient]
      change Filter.Tendsto
        (fun k ↦ completedGreenForwardDifferenceJet
          (fun z ↦ natDirichletTerm (operatorHeightParameter z) (i.val + 2) -
            natDirichletTerm (operatorHeightParameter z) (i.val + 1))
          (canonicalGreenJetStep k) (2 * n + 1))
        Filter.atTop
        (nhds (nativeDirichletSlopeTaylorCoefficient (2 * n + 1) i.val))
      apply hsub.congr'
      filter_upwards with k
      exact (completedGreenForwardDifferenceJet_sub
        (fun z ↦ natDirichletTerm (operatorHeightParameter z) (i.val + 2))
        (fun z ↦ natDirichletTerm (operatorHeightParameter z) (i.val + 1))
        (canonicalGreenJetStep k) (2 * n + 1)).symm

end

end CarrySelfAdjointOperator
