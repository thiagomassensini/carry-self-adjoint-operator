import CarrySelfAdjointOperator.GreenJetJacobiFiniteCompression
import CarrySelfAdjointOperator.RealLinearPMapAdjointSquare
import Mathlib.Tactic

/-!
# The closed Green factor and its maximal-adjoint square

The algebraic identity `J₀ = C₀ B₀` uses the forced reverse shift `C₀` only
as a formal adjoint.  This file passes that identity through graph closure and
the maximal real adjoint:

* `C₀` is contained in the maximal adjoint of `B = closure(B₀)`;
* the maximal composition `B* B` is defined on its natural domain;
* `J₀` is literally contained in `B* B`;
* every canonical finite Jacobi section is the exact compression of `B* B`;
  and
* a concrete sufficient zero-kernel gate is recovery of `e₀` from the
  completed shifted tail `span {e₁, e₂, ...}`.

The general closed-graph theorem imported below proves that this maximal
square is positive and self-adjoint after Hilbert completion.  Thus the
infinite Jacobi operator is internal to the completed Green factor rather than
an externally chosen extension.
-/

open scoped InnerProductSpace LinearPMap RealInnerProductSpace

namespace CarrySelfAdjointOperator

noncomputable section

@[reducible] private def coherentGreenJetEvenInnerProductSpace
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (jet : (ℕ ⊕ ℕ) → E) :
    InnerProductSpace ℝ (greenJetEvenHilbertSubspace jet) :=
  { (inferInstance :
      InnerProductSpace ℝ (greenJetEvenHilbertSubspace jet)) with
    toNormedSpace := inferInstance }

@[reducible] private def coherentGreenJetOddInnerProductSpace
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (jet : (ℕ ⊕ ℕ) → E) :
    InnerProductSpace ℝ (greenJetOddHilbertSubspace jet) :=
  { (inferInstance :
      InnerProductSpace ℝ (greenJetOddHilbertSubspace jet)) with
    toNormedSpace := inferInstance }

/-! ## The algebraic and closed-factor kernel gates -/

/-- The algebraic Green factor is injective.  This is a genuine all-core
statement forced by linear independence of the odd jets. -/
theorem greenJetEnergyFactorCore_ker_eq_bot
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {jet : (ℕ ⊕ ℕ) → E}
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    LinearMap.ker (greenJetEnergyFactorCore heven).toFun = ⊥ := by
  apply LinearMap.ker_eq_bot_of_injective
  exact (greenJetEvenOperatorCoreBasis heven).injective_constr_of_linearIndependent
    (greenJetOddSectorJet_linearIndependent hodd)

/-- The shifted even tail generated by `e₁, e₂, ...`.  Its possible failure
to be dense is the Hilbert-space form of spectral mass at zero. -/
def greenJetEvenShiftedTailCore
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (jet : (ℕ ⊕ ℕ) → E) :
    Submodule ℝ (greenJetEvenHilbertSubspace jet) :=
  Submodule.span ℝ
    (Set.range (fun n : ℕ => greenJetEvenSectorJet jet (n + 1)))

/-- The range of the algebraic reverse shift `C₀ oₙ = e_(n+1)` is exactly the
shifted even tail. -/
theorem greenJetEnergyFormalAdjointCore_range_eq_shiftedTail
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {jet : (ℕ ⊕ ℕ) → E}
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    LinearMap.range (greenJetEnergyFormalAdjointCore hodd).toFun =
      greenJetEvenShiftedTailCore jet := by
  exact (greenJetOddOperatorCoreBasis hodd).constr_range ℝ

/-- The reverse shift is algebraically injective because the shifted even jets
remain linearly independent. -/
theorem greenJetEnergyFormalAdjointCore_ker_eq_bot
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {jet : (ℕ ⊕ ℕ) → E}
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    LinearMap.ker (greenJetEnergyFormalAdjointCore hodd).toFun = ⊥ := by
  apply LinearMap.ker_eq_bot_of_injective
  apply (greenJetOddOperatorCoreBasis hodd).injective_constr_of_linearIndependent
  exact (greenJetEvenSectorJet_linearIndependent heven).comp
    (fun n : ℕ => n + 1) (fun _ _ h => Nat.add_right_cancel h)

/-- Since the full even algebraic core is dense, the shifted tail is dense
exactly when its one omitted generator `e₀` is recovered in completion. -/
theorem greenJetEvenShiftedTailCore_dense_iff_head_mem
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (jet : (ℕ ⊕ ℕ) → E) :
    Dense (greenJetEvenShiftedTailCore jet :
        Set (greenJetEvenHilbertSubspace jet)) ↔
      greenJetEvenSectorJet jet 0 ∈
        (greenJetEvenShiftedTailCore jet).topologicalClosure := by
  constructor
  · intro hDense
    have htop :=
      Submodule.dense_iff_topologicalClosure_eq_top.mp hDense
    rw [htop]
    exact Submodule.mem_top
  · intro hhead
    apply Submodule.dense_iff_topologicalClosure_eq_top.mpr
    apply top_unique
    have hcoreLe : greenJetEvenOperatorCore jet ≤
        (greenJetEvenShiftedTailCore jet).topologicalClosure := by
      rw [greenJetEvenOperatorCore]
      apply Submodule.span_le.2
      rintro _ ⟨n, rfl⟩
      cases n with
      | zero => exact hhead
      | succ n =>
          apply (greenJetEvenShiftedTailCore jet).le_topologicalClosure
          apply Submodule.subset_span
          exact ⟨n, by simp⟩
    have hclosureLe :=
      (greenJetEvenOperatorCore jet).topologicalClosure_minimal hcoreLe
        (greenJetEvenShiftedTailCore jet).isClosed_topologicalClosure
    have hcoreTop :
        (greenJetEvenOperatorCore jet).topologicalClosure = ⊤ :=
      Submodule.dense_iff_topologicalClosure_eq_top.mp
        (greenJetEvenOperatorCore_dense jet)
    simpa [hcoreTop] using hclosureLe

/-- Passing algebraic injectivity through graph closure is exactly the
closability of the algebraic inverse.  This isolates the zero-spectral-mass
gate without introducing an extension parameter. -/
theorem closedGreenJetEnergyFactor_ker_eq_bot_iff_inverseCore_isClosable
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    LinearMap.ker
        (closedGreenJetEnergyFactor hrep heven hodd).toFun = ⊥ ↔
      (greenJetEnergyFactorCore heven).inverse.IsClosable := by
  have hB₀ker :
      LinearMap.ker (greenJetEnergyFactorCore heven).toFun = ⊥ :=
    greenJetEnergyFactorCore_ker_eq_bot heven hodd
  have hB₀closable : (greenJetEnergyFactorCore heven).IsClosable :=
    greenJetEnergyFactorCore_isClosable hrep heven hodd
  change LinearMap.ker
      (greenJetEnergyFactorCore heven).closure.toFun = ⊥ ↔
    (greenJetEnergyFactorCore heven).inverse.IsClosable
  exact ((greenJetEnergyFactorCore heven).inverse_isClosable_iff
    hB₀ker hB₀closable).symm

/-- Dense range of the algebraic reverse shift forces the graph closure of the
Green factor to have trivial kernel. -/
theorem greenJetEnergyFactorCore_closure_ker_eq_bot_of_reverseShift_denseRange
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n)))
    (hrange : Dense
      (LinearMap.range (greenJetEnergyFormalAdjointCore hodd).toFun :
        Set (greenJetEvenHilbertSubspace jet))) :
    LinearMap.ker
      (greenJetEnergyFactorCore heven).closure.toFun = ⊥ := by
  letI : InnerProductSpace ℝ (greenJetEvenHilbertSubspace jet) :=
    coherentGreenJetEvenInnerProductSpace jet
  letI : InnerProductSpace ℝ (greenJetOddHilbertSubspace jet) :=
    coherentGreenJetOddInnerProductSpace jet
  let B₀ := greenJetEnergyFactorCore heven
  let C₀ := greenJetEnergyFormalAdjointCore hodd
  have hB₀closable : B₀.IsClosable :=
    greenJetEnergyFactorCore_isClosable hrep heven hodd
  have hformal :
      ∀ (x : B₀.domain) (y : C₀.domain),
        ⟪B₀ x, (y : greenJetOddHilbertSubspace jet)⟫_ℝ =
          ⟪(x : greenJetEvenHilbertSubspace jet), C₀ y⟫_ℝ :=
    greenJetEnergyFactorCore_formalAdjointIdentity hrep heven hodd
  have hrange' : Dense (LinearMap.range C₀.toFun :
      Set (greenJetEvenHilbertSubspace jet)) := hrange
  change LinearMap.ker B₀.closure.toFun = ⊥
  exact LinearPMap.closure_ker_eq_bot_of_denseRange_formalAdjoint
    (E := greenJetEvenHilbertSubspace jet)
    (F := greenJetOddHilbertSubspace jet)
    B₀ C₀ hB₀closable hformal hrange'

/-- The one head-in-tail completion identity forces the graph closure of the
Green core factor to have trivial kernel.  The reverse-shift range is exactly
the shifted tail. -/
theorem greenJetEnergyFactorCore_closure_ker_eq_bot_of_head_mem_shiftedTail
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n)))
    (hhead : greenJetEvenSectorJet jet 0 ∈
      (greenJetEvenShiftedTailCore jet).topologicalClosure) :
    LinearMap.ker
      (greenJetEnergyFactorCore heven).closure.toFun = ⊥ := by
  apply greenJetEnergyFactorCore_closure_ker_eq_bot_of_reverseShift_denseRange
    hrep heven hodd
  rw [greenJetEnergyFormalAdjointCore_range_eq_shiftedTail hodd]
  exact (greenJetEvenShiftedTailCore_dense_iff_head_mem jet).2 hhead

/-- Canonical closed-factor form of the head-in-tail kernel theorem. -/
theorem closedGreenJetEnergyFactor_ker_eq_bot_of_head_mem_shiftedTail
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n)))
    (hhead : greenJetEvenSectorJet jet 0 ∈
      (greenJetEvenShiftedTailCore jet).topologicalClosure) :
    LinearMap.ker
      (closedGreenJetEnergyFactor hrep heven hodd).toFun = ⊥ :=
  greenJetEnergyFactorCore_closure_ker_eq_bot_of_head_mem_shiftedTail
    hrep heven hodd hhead

/-- Equivalently, the head-in-tail identity proves closability of the
algebraic inverse of `B₀`. -/
theorem greenJetEnergyFactorCore_inverse_isClosable_of_head_mem_shiftedTail
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n)))
    (hhead : greenJetEvenSectorJet jet 0 ∈
      (greenJetEvenShiftedTailCore jet).topologicalClosure) :
    (greenJetEnergyFactorCore heven).inverse.IsClosable :=
  (closedGreenJetEnergyFactor_ker_eq_bot_iff_inverseCore_isClosable
    hrep heven hodd).1
      (closedGreenJetEnergyFactor_ker_eq_bot_of_head_mem_shiftedTail
        hrep heven hodd hhead)

/-- The canonical closed Green factor has dense domain. -/
theorem closedGreenJetEnergyFactor_dense_domain
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    Dense ((closedGreenJetEnergyFactor hrep heven hodd).domain :
      Set (greenJetEvenHilbertSubspace jet)) := by
  exact (greenJetEnergyFactorCore_dense_domain heven).mono
    (greenJetEnergyFactorCore_le_closed hrep heven hodd).1

/-- Maximal real adjoint of the canonical closed Green factor. -/
def closedGreenJetEnergyRealAdjoint
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (_hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (_hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    greenJetOddHilbertSubspace jet →ₗ.[ℝ]
      greenJetEvenHilbertSubspace jet := by
  letI : InnerProductSpace ℝ (greenJetEvenHilbertSubspace jet) :=
    coherentGreenJetEvenInnerProductSpace jet
  letI : InnerProductSpace ℝ (greenJetOddHilbertSubspace jet) :=
    coherentGreenJetOddInnerProductSpace jet
  exact (greenJetEnergyFactorCore heven).closure.realAdjoint
    ((greenJetEnergyFactorCore heven).closure_dense_domain
      (greenJetEnergyFactorCore_dense_domain heven))

/-- The forced algebraic reverse shift is contained in the maximal adjoint of
the canonical closed Green energy factor. -/
theorem greenJetEnergyFormalAdjointCore_le_closedRealAdjoint
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    greenJetEnergyFormalAdjointCore hodd ≤
      closedGreenJetEnergyRealAdjoint hrep heven hodd := by
  letI : InnerProductSpace ℝ (greenJetEvenHilbertSubspace jet) :=
    coherentGreenJetEvenInnerProductSpace jet
  letI : InnerProductSpace ℝ (greenJetOddHilbertSubspace jet) :=
    coherentGreenJetOddInnerProductSpace jet
  simpa only [closedGreenJetEnergyFactor,
    closedGreenJetEnergyRealAdjoint] using
    LinearPMap.le_realAdjoint_closure_of_formalAdjoint
      (greenJetEnergyFactorCore heven)
      (greenJetEnergyFormalAdjointCore hodd)
      (greenJetEnergyFactorCore_dense_domain heven)
      (greenJetEnergyFactorCore_isClosable hrep heven hodd)
      (greenJetEnergyFactorCore_formalAdjointIdentity hrep heven hodd)

/-- Canonical maximal-adjoint square of the closed Green energy factor. -/
def closedGreenJetEnergyAdjointSquare
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (_hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (_hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    greenJetEvenHilbertSubspace jet →ₗ.[ℝ]
      greenJetEvenHilbertSubspace jet := by
  letI : InnerProductSpace ℝ (greenJetEvenHilbertSubspace jet) :=
    coherentGreenJetEvenInnerProductSpace jet
  letI : InnerProductSpace ℝ (greenJetOddHilbertSubspace jet) :=
    coherentGreenJetOddInnerProductSpace jet
  exact (greenJetEnergyFactorCore heven).closure.realAdjointSquare
    ((greenJetEnergyFactorCore heven).closure_dense_domain
      (greenJetEnergyFactorCore_dense_domain heven))

private def closedGreenJetEnergyCoreDomainVector
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n)))
    (x : greenJetEvenOperatorCore jet) :
    (closedGreenJetEnergyFactor hrep heven hodd).domain :=
  Submodule.inclusion
    (greenJetEnergyFactorCore_le_closed hrep heven hodd).1 x

private theorem closedGreenJetEnergyFactor_core_apply
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n)))
    (x : greenJetEvenOperatorCore jet) :
    closedGreenJetEnergyFactor hrep heven hodd
        (closedGreenJetEnergyCoreDomainVector hrep heven hodd x) =
      greenJetEnergyFactorCore heven x := by
  exact (LinearPMap.apply_comp_inclusion
    (greenJetEnergyFactorCore_le_closed hrep heven hodd) x).symm

/-- Every algebraic even Green vector belongs canonically to the domain of
the maximal square of the closed factor. -/
def greenJetEvenCoreInClosedAdjointSquareDomain
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n)))
    (x : greenJetEvenOperatorCore jet) :
    (closedGreenJetEnergyAdjointSquare hrep heven hodd).domain := by
  letI : InnerProductSpace ℝ (greenJetEvenHilbertSubspace jet) :=
    coherentGreenJetEvenInnerProductSpace jet
  letI : InnerProductSpace ℝ (greenJetOddHilbertSubspace jet) :=
    coherentGreenJetOddInnerProductSpace jet
  let B := closedGreenJetEnergyFactor hrep heven hodd
  let A := closedGreenJetEnergyRealAdjoint hrep heven hodd
  let C := greenJetEnergyFormalAdjointCore hodd
  let xc : B.domain :=
    closedGreenJetEnergyCoreDomainVector hrep heven hodd x
  let yc : C.domain := greenJetEnergyFactorToFormalAdjointDomain heven x
  have hCle : C ≤ A :=
    greenJetEnergyFormalAdjointCore_le_closedRealAdjoint
      hrep heven hodd
  have hyAdj : (yc : greenJetOddHilbertSubspace jet) ∈ A.domain :=
    hCle.1 yc.property
  have hBxy : B xc = (yc : greenJetOddHilbertSubspace jet) := by
    rw [closedGreenJetEnergyFactor_core_apply]
    exact (greenJetEnergyFactorToFormalAdjointDomain_coe heven x).symm
  have hBxAdj : B xc ∈ A.domain := by
    rw [hBxy]
    exact hyAdj
  exact LinearPMap.realMaximalCompDomainMk A B xc hBxAdj

/-- On the algebraic Green core, the maximal-adjoint square acts exactly as
the already constructed Jacobi shift. -/
theorem closedGreenJetEnergyAdjointSquare_apply_core
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n)))
    (x : greenJetEvenOperatorCore jet) :
    closedGreenJetEnergyAdjointSquare hrep heven hodd
        (greenJetEvenCoreInClosedAdjointSquareDomain
          hrep heven hodd x) =
      greenJetJacobiCoreMap heven x := by
  letI : InnerProductSpace ℝ (greenJetEvenHilbertSubspace jet) :=
    coherentGreenJetEvenInnerProductSpace jet
  letI : InnerProductSpace ℝ (greenJetOddHilbertSubspace jet) :=
    coherentGreenJetOddInnerProductSpace jet
  let B := closedGreenJetEnergyFactor hrep heven hodd
  let A := closedGreenJetEnergyRealAdjoint hrep heven hodd
  let C := greenJetEnergyFormalAdjointCore hodd
  let xc : B.domain :=
    closedGreenJetEnergyCoreDomainVector hrep heven hodd x
  let yc : C.domain := greenJetEnergyFactorToFormalAdjointDomain heven x
  have hCle : C ≤ A :=
    greenJetEnergyFormalAdjointCore_le_closedRealAdjoint
      hrep heven hodd
  have hCaction := LinearPMap.apply_comp_inclusion hCle yc
  have hBxy : B xc = (yc : greenJetOddHilbertSubspace jet) := by
    rw [closedGreenJetEnergyFactor_core_apply]
    exact (greenJetEnergyFactorToFormalAdjointDomain_coe heven x).symm
  change A _ = greenJetJacobiCoreMap heven x
  calc
    A _ = C yc := by
      rw [hCaction]
      apply congrArg A
      apply Subtype.ext
      change B xc = (yc : greenJetOddHilbertSubspace jet)
      exact hBxy
    _ = greenJetJacobiCoreMap heven x := by
      change greenJetFormalAdjointSquareCore heven hodd x =
        greenJetJacobiCore heven x
      exact greenJetFormalAdjointSquareCore_apply heven hodd x

/-- Exact operator inclusion `J₀ ≤ B* B`.  This is the maximal-adjoint
upgrade of the former formal factorization `J₀ = C₀ B₀`. -/
theorem greenJetJacobiCore_le_closedEnergyAdjointSquare
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    greenJetJacobiCore heven ≤
      closedGreenJetEnergyAdjointSquare hrep heven hodd := by
  constructor
  · intro x hx
    exact (greenJetEvenCoreInClosedAdjointSquareDomain
      hrep heven hodd ⟨x, hx⟩).property
  · intro x y hxy
    let xc : greenJetEvenOperatorCore jet := ⟨x, x.property⟩
    have hy : y = greenJetEvenCoreInClosedAdjointSquareDomain
        hrep heven hodd xc := by
      apply Subtype.ext
      exact hxy.symm
    rw [hy]
    simpa [greenJetJacobiCore, xc] using
      (closedGreenJetEnergyAdjointSquare_apply_core
        hrep heven hodd xc).symm

/-! ## Exact finite compressions of the maximal square -/

/-- A canonical LDL-whitened finite vector, now retained in the natural domain
of the maximal-adjoint square. -/
def canonicalGreenJetEvenAdjointSquareDomainVector
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n)))
    (N : ℕ) (i : Fin N) :
    (closedGreenJetEnergyAdjointSquare hrep heven hodd).domain :=
  greenJetEvenCoreInClosedAdjointSquareDomain hrep heven hodd
    (canonicalGreenJetEvenJacobiCoreVector hrep heven N i)

/-- The maximal square retains the exact Jacobi action on every canonical
finite vector. -/
theorem closedGreenJetEnergyAdjointSquare_canonicalFiniteVector
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n)))
    (N : ℕ) (i : Fin N) :
    closedGreenJetEnergyAdjointSquare hrep heven hodd
        (canonicalGreenJetEvenAdjointSquareDomainVector
          hrep heven hodd N i) =
      greenJetJacobiCoreMap heven
        (canonicalGreenJetEvenJacobiCoreVector hrep heven N i) :=
  closedGreenJetEnergyAdjointSquare_apply_core hrep heven hodd
    (canonicalGreenJetEvenJacobiCoreVector hrep heven N i)

/-- Every canonical finite Jacobi section is literally the corresponding
compression of the single maximal-adjoint square. -/
theorem closedGreenJetEnergyAdjointSquare_finiteCompression_eq_canonicalSection
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n)))
    (N : ℕ) :
    (fun i j : Fin N =>
      ⟪closedGreenJetEnergyAdjointSquare hrep heven hodd
          (canonicalGreenJetEvenAdjointSquareDomainVector
            hrep heven hodd N i),
        (canonicalGreenJetEvenAdjointSquareDomainVector
          hrep heven hodd N j : greenJetEvenHilbertSubspace jet)⟫_ℝ) =
      canonicalFiniteJacobiSection moments N
        (canonicalGreenJetHankelGramCertificate hrep heven N) := by
  ext i j
  rw [closedGreenJetEnergyAdjointSquare_canonicalFiniteVector]
  have hcompression := congrArg
    (fun A : Matrix (Fin N) (Fin N) ℝ => A i j)
    (greenJetJacobiCore_finiteCompression_eq_canonicalFiniteJacobiSection
      hrep heven N)
  have hcoe :
      (canonicalGreenJetEvenAdjointSquareDomainVector
          hrep heven hodd N j : greenJetEvenHilbertSubspace jet) =
        (canonicalGreenJetEvenJacobiCoreVector hrep heven N j :
          greenJetEvenHilbertSubspace jet) := by
    rfl
  rw [hcoe]
  exact hcompression

/-! ## Self-adjointness of the maximal square -/

/-- The natural domain of the closed Green maximal-adjoint square is dense
when the ambient Green realization is complete. -/
theorem closedGreenJetEnergyAdjointSquare_dense_domain
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [CompleteSpace E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    Dense ((closedGreenJetEnergyAdjointSquare hrep heven hodd).domain :
      Set (greenJetEvenHilbertSubspace jet)) := by
  letI : InnerProductSpace ℝ (greenJetEvenHilbertSubspace jet) :=
    coherentGreenJetEvenInnerProductSpace jet
  letI : InnerProductSpace ℝ (greenJetOddHilbertSubspace jet) :=
    coherentGreenJetOddInnerProductSpace jet
  letI : CompleteSpace
      (CanonicalGreenJetSignedHeightHilbertSpace jet) := inferInstance
  letI : CompleteSpace (greenJetEvenHilbertSubspace jet) :=
    (greenJetEvenHilbertSubspace_isClosed jet).completeSpace_coe
  letI : CompleteSpace (greenJetOddHilbertSubspace jet) :=
    (greenJetOddHilbertSubspace_isClosed jet).completeSpace_coe
  let B := (greenJetEnergyFactorCore heven).closure
  let hB : Dense (B.domain : Set (greenJetEvenHilbertSubspace jet)) :=
    (greenJetEnergyFactorCore heven).closure_dense_domain
      (greenJetEnergyFactorCore_dense_domain heven)
  have hBclosed : B.IsClosed :=
    (greenJetEnergyFactorCore_isClosable
      hrep heven hodd).closure_isClosed
  simpa [closedGreenJetEnergyAdjointSquare, B, hB] using
    B.realAdjointSquare_dense_domain hB hBclosed

/-- Maximal real adjoint of the closed Green square, with the canonical
density proof selected internally. -/
def closedGreenJetEnergyAdjointSquareRealAdjoint
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [CompleteSpace E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    greenJetEvenHilbertSubspace jet →ₗ.[ℝ]
      greenJetEvenHilbertSubspace jet := by
  letI : InnerProductSpace ℝ (greenJetEvenHilbertSubspace jet) :=
    coherentGreenJetEvenInnerProductSpace jet
  letI : InnerProductSpace ℝ (greenJetOddHilbertSubspace jet) :=
    coherentGreenJetOddInnerProductSpace jet
  letI : CompleteSpace
      (CanonicalGreenJetSignedHeightHilbertSpace jet) := inferInstance
  letI : CompleteSpace (greenJetEvenHilbertSubspace jet) :=
    (greenJetEvenHilbertSubspace_isClosed jet).completeSpace_coe
  letI : CompleteSpace (greenJetOddHilbertSubspace jet) :=
    (greenJetOddHilbertSubspace_isClosed jet).completeSpace_coe
  let B := (greenJetEnergyFactorCore heven).closure
  let hB : Dense (B.domain : Set (greenJetEvenHilbertSubspace jet)) :=
    (greenJetEnergyFactorCore heven).closure_dense_domain
      (greenJetEnergyFactorCore_dense_domain heven)
  let A := B.realAdjointSquare hB
  let hA : Dense (A.domain : Set (greenJetEvenHilbertSubspace jet)) :=
    B.realAdjointSquare_dense_domain hB
      ((greenJetEnergyFactorCore_isClosable
        hrep heven hodd).closure_isClosed)
  exact A.realAdjoint hA

/-- The canonical closed Green square is self-adjoint: it is literally equal
to its maximal real adjoint. -/
theorem closedGreenJetEnergyAdjointSquare_isMaximalRealSelfAdjoint
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [CompleteSpace E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    closedGreenJetEnergyAdjointSquareRealAdjoint hrep heven hodd =
      closedGreenJetEnergyAdjointSquare hrep heven hodd := by
  letI : InnerProductSpace ℝ (greenJetEvenHilbertSubspace jet) :=
    coherentGreenJetEvenInnerProductSpace jet
  letI : InnerProductSpace ℝ (greenJetOddHilbertSubspace jet) :=
    coherentGreenJetOddInnerProductSpace jet
  letI : CompleteSpace
      (CanonicalGreenJetSignedHeightHilbertSpace jet) := inferInstance
  letI : CompleteSpace (greenJetEvenHilbertSubspace jet) :=
    (greenJetEvenHilbertSubspace_isClosed jet).completeSpace_coe
  letI : CompleteSpace (greenJetOddHilbertSubspace jet) :=
    (greenJetOddHilbertSubspace_isClosed jet).completeSpace_coe
  let B := (greenJetEnergyFactorCore heven).closure
  let hB : Dense (B.domain : Set (greenJetEvenHilbertSubspace jet)) :=
    (greenJetEnergyFactorCore heven).closure_dense_domain
      (greenJetEnergyFactorCore_dense_domain heven)
  have hBclosed : B.IsClosed :=
    (greenJetEnergyFactorCore_isClosable
      hrep heven hodd).closure_isClosed
  simpa [closedGreenJetEnergyAdjointSquareRealAdjoint,
    closedGreenJetEnergyAdjointSquare, B, hB] using
      B.realAdjoint_realAdjointSquare_eq hB hBclosed

/-- In particular, the canonical Green maximal-adjoint square is closed. -/
theorem closedGreenJetEnergyAdjointSquare_isClosed
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [CompleteSpace E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    (closedGreenJetEnergyAdjointSquare hrep heven hodd).IsClosed := by
  rw [← closedGreenJetEnergyAdjointSquare_isMaximalRealSelfAdjoint
    hrep heven hodd]
  letI : InnerProductSpace ℝ (greenJetEvenHilbertSubspace jet) :=
    coherentGreenJetEvenInnerProductSpace jet
  letI : InnerProductSpace ℝ (greenJetOddHilbertSubspace jet) :=
    coherentGreenJetOddInnerProductSpace jet
  letI : CompleteSpace
      (CanonicalGreenJetSignedHeightHilbertSpace jet) := inferInstance
  letI : CompleteSpace (greenJetEvenHilbertSubspace jet) :=
    (greenJetEvenHilbertSubspace_isClosed jet).completeSpace_coe
  letI : CompleteSpace (greenJetOddHilbertSubspace jet) :=
    (greenJetOddHilbertSubspace_isClosed jet).completeSpace_coe
  let B := (greenJetEnergyFactorCore heven).closure
  let hB : Dense (B.domain : Set (greenJetEvenHilbertSubspace jet)) :=
    (greenJetEnergyFactorCore heven).closure_dense_domain
      (greenJetEnergyFactorCore_dense_domain heven)
  let A := B.realAdjointSquare hB
  let hA : Dense (A.domain : Set (greenJetEvenHilbertSubspace jet)) :=
    B.realAdjointSquare_dense_domain hB
      ((greenJetEnergyFactorCore_isClosable
        hrep heven hodd).closure_isClosed)
  simpa [closedGreenJetEnergyAdjointSquareRealAdjoint, B, hB, A, hA] using
    A.realAdjoint_isClosed hA

/-- Positivity of the canonical Green maximal-adjoint square. -/
theorem closedGreenJetEnergyAdjointSquare_inner_nonneg
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n)))
    (x : (closedGreenJetEnergyAdjointSquare
      hrep heven hodd).domain) :
    0 ≤ ⟪closedGreenJetEnergyAdjointSquare hrep heven hodd x,
      (x : greenJetEvenHilbertSubspace jet)⟫_ℝ := by
  letI : InnerProductSpace ℝ (greenJetEvenHilbertSubspace jet) :=
    coherentGreenJetEvenInnerProductSpace jet
  letI : InnerProductSpace ℝ (greenJetOddHilbertSubspace jet) :=
    coherentGreenJetOddInnerProductSpace jet
  let B := (greenJetEnergyFactorCore heven).closure
  let hB : Dense (B.domain : Set (greenJetEvenHilbertSubspace jet)) :=
    (greenJetEnergyFactorCore heven).closure_dense_domain
      (greenJetEnergyFactorCore_dense_domain heven)
  simpa [closedGreenJetEnergyAdjointSquare, B, hB] using
    B.realAdjointSquare_inner_nonneg hB x

/-! ## The exact zero-spectral-mass gate -/

/-- The Green maximal square has trivial kernel exactly when its closed energy
factor does.  This is the operator identity `ker (B* B) = ker B`. -/
theorem closedGreenJetEnergyAdjointSquare_ker_eq_bot_iff
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    LinearMap.ker
        (closedGreenJetEnergyAdjointSquare hrep heven hodd).toFun = ⊥ ↔
      LinearMap.ker
        (closedGreenJetEnergyFactor hrep heven hodd).toFun = ⊥ := by
  letI : InnerProductSpace ℝ (greenJetEvenHilbertSubspace jet) :=
    coherentGreenJetEvenInnerProductSpace jet
  letI : InnerProductSpace ℝ (greenJetOddHilbertSubspace jet) :=
    coherentGreenJetOddInnerProductSpace jet
  let hB : Dense
      ((greenJetEnergyFactorCore heven).closure.domain :
        Set (greenJetEvenHilbertSubspace jet)) :=
    (greenJetEnergyFactorCore heven).closure_dense_domain
      (greenJetEnergyFactorCore_dense_domain heven)
  change LinearMap.ker
      ((greenJetEnergyFactorCore heven).closure.realAdjointSquare hB).toFun =
        ⊥ ↔
    LinearMap.ker (greenJetEnergyFactorCore heven).closure.toFun = ⊥
  exact LinearPMap.realAdjointSquare_ker_eq_bot_iff
    (greenJetEnergyFactorCore heven).closure hB

/-- For the canonical Green construction, absence of spectral mass at zero is
exactly closability of the algebraic inverse of `B₀`. -/
theorem closedGreenJetEnergyAdjointSquare_ker_eq_bot_iff_inverseCore_isClosable
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    LinearMap.ker
        (closedGreenJetEnergyAdjointSquare hrep heven hodd).toFun = ⊥ ↔
      (greenJetEnergyFactorCore heven).inverse.IsClosable :=
  (closedGreenJetEnergyAdjointSquare_ker_eq_bot_iff
    hrep heven hodd).trans
      (closedGreenJetEnergyFactor_ker_eq_bot_iff_inverseCore_isClosable
        hrep heven hodd)

/-- The completed head-in-tail identity is sufficient to remove the zero
kernel of the positive self-adjoint Green square. -/
theorem closedGreenJetEnergyAdjointSquare_ker_eq_bot_of_head_mem_shiftedTail
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n)))
    (hhead : greenJetEvenSectorJet jet 0 ∈
      (greenJetEvenShiftedTailCore jet).topologicalClosure) :
    LinearMap.ker
        (closedGreenJetEnergyAdjointSquare hrep heven hodd).toFun = ⊥ :=
  (closedGreenJetEnergyAdjointSquare_ker_eq_bot_iff
    hrep heven hodd).2
      (closedGreenJetEnergyFactor_ker_eq_bot_of_head_mem_shiftedTail
        hrep heven hodd hhead)

/-! ## Automatic promotion of an arbitrary ambient realization -/

/-- Fully canonical positive operator obtained after completing an arbitrary
ambient Green-jet realization. -/
def canonicalCompletedGreenJetEnergyAdjointSquare
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    greenJetEvenHilbertSubspace (completedGreenJet jet) →ₗ.[ℝ]
      greenJetEvenHilbertSubspace (completedGreenJet jet) :=
  closedGreenJetEnergyAdjointSquare
    (completedGreenJet_gramRepresentation hrep)
    (completedGreenJet_even_linearIndependent heven)
    (completedGreenJet_odd_linearIndependent hodd)

/-- Maximal real adjoint of the automatically completed Green square. -/
def canonicalCompletedGreenJetEnergyAdjointSquareRealAdjoint
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    greenJetEvenHilbertSubspace (completedGreenJet jet) →ₗ.[ℝ]
      greenJetEvenHilbertSubspace (completedGreenJet jet) :=
  closedGreenJetEnergyAdjointSquareRealAdjoint
    (completedGreenJet_gramRepresentation hrep)
    (completedGreenJet_even_linearIndependent heven)
    (completedGreenJet_odd_linearIndependent hodd)

/-- Unconditional self-adjointness after canonical ambient completion. -/
theorem canonicalCompletedGreenJetEnergyAdjointSquare_isMaximalRealSelfAdjoint
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    canonicalCompletedGreenJetEnergyAdjointSquareRealAdjoint
        hrep heven hodd =
      canonicalCompletedGreenJetEnergyAdjointSquare hrep heven hodd :=
  closedGreenJetEnergyAdjointSquare_isMaximalRealSelfAdjoint
    (completedGreenJet_gramRepresentation hrep)
    (completedGreenJet_even_linearIndependent heven)
    (completedGreenJet_odd_linearIndependent hodd)

/-- The automatically completed Green square is closed. -/
theorem canonicalCompletedGreenJetEnergyAdjointSquare_isClosed
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    (canonicalCompletedGreenJetEnergyAdjointSquare
      hrep heven hodd).IsClosed :=
  closedGreenJetEnergyAdjointSquare_isClosed
    (completedGreenJet_gramRepresentation hrep)
    (completedGreenJet_even_linearIndependent heven)
    (completedGreenJet_odd_linearIndependent hodd)

/-- Zero-spectral-mass gate for the automatically completed realization.  It
is reduced to the single literal statement that the completed head jet lies
in the closure of its shifted even tail. -/
theorem canonicalCompletedGreenJetEnergyAdjointSquare_ker_eq_bot_of_head_mem_tail
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n)))
    (hhead : greenJetEvenSectorJet (completedGreenJet jet) 0 ∈
      (greenJetEvenShiftedTailCore
        (completedGreenJet jet)).topologicalClosure) :
    LinearMap.ker
      (canonicalCompletedGreenJetEnergyAdjointSquare
        hrep heven hodd).toFun = ⊥ :=
  closedGreenJetEnergyAdjointSquare_ker_eq_bot_of_head_mem_shiftedTail
    (completedGreenJet_gramRepresentation hrep)
    (completedGreenJet_even_linearIndependent heven)
    (completedGreenJet_odd_linearIndependent hodd)
    hhead

/-- The completed algebraic Jacobi core is contained in the canonical
positive self-adjoint Green square. -/
theorem canonicalCompletedGreenJetJacobiCore_le_energyAdjointSquare
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {moments : ℕ → ℝ} {jet : (ℕ ⊕ ℕ) → E}
    (hrep : IsGreenWronskianMomentKernelGramRepresentation moments jet)
    (heven : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inl n)))
    (hodd : LinearIndependent ℝ (fun n : ℕ => jet (Sum.inr n))) :
    let hrep' := completedGreenJet_gramRepresentation hrep
    let heven' := completedGreenJet_even_linearIndependent heven
    let hodd' := completedGreenJet_odd_linearIndependent hodd
    greenJetJacobiCore heven' ≤
      closedGreenJetEnergyAdjointSquare hrep' heven' hodd' := by
  exact greenJetJacobiCore_le_closedEnergyAdjointSquare
    (completedGreenJet_gramRepresentation hrep)
    (completedGreenJet_even_linearIndependent heven)
    (completedGreenJet_odd_linearIndependent hodd)

end

