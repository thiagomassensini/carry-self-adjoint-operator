import CarrySelfAdjointOperator.CompletedNativeAnalyticMomentGrowth
import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
import Mathlib.Tactic

/-!
# Triangular transport behind the completed-native logarithmic moments

The original native self-adjoint laboratory did not start from a spectral
measure.  It first formed the completed even characteristic

`Phi(u) = sum phi_n u^n`

and then recovered the logarithmic moments by power-series division

`q(u) Phi(u) = -Phi'(u)`.

This file packages that already-formalized scalar recurrence as one finite
lower-triangular matrix equation.  The transport is defined only from the
completed characteristic coefficients.  Its diagonal is the nonzero center
coefficient `phi_0`, so every finite transport is invertible.

No positivity, zero-set, Green-kernel, Hankel, or spectral hypothesis is used.
-/

open scoped BigOperators Matrix

namespace CarrySelfAdjointOperator

noncomputable section

/-- Lower-triangular Toeplitz transport generated by the completed even
characteristic coefficients.  Row `i` encodes convolution through order `i`.-/
def completedNativeLogDerivativeTriangularMatrix (N : ℕ) :
    Matrix (Fin N) (Fin N) ℂ :=
  fun i j =>
    if j.val ≤ i.val then
      completedNativeEvenCharacteristicCoefficient (i.val - j.val)
    else 0

/-- Finite prefix of the canonical completed-native logarithmic moments. -/
def completedNativeLogDerivativeMomentVector (N : ℕ) : Fin N → ℂ :=
  fun i => (canonicalCompletedNativeLogDerivativeMoment i.val : ℂ)

/-- Right-hand side of `q Phi = -Phi'` in coefficient coordinates. -/
def completedNativeLogDerivativeSourceVector (N : ℕ) : Fin N → ℂ :=
  fun i => -(((i.val + 1 : ℕ) : ℂ) *
    completedNativeEvenCharacteristicCoefficient (i.val + 1))

@[simp] theorem completedNativeLogDerivativeTriangularMatrix_diagonal
    (N : ℕ) (i : Fin N) :
    completedNativeLogDerivativeTriangularMatrix N i i =
      completedNativeEvenCharacteristicCoefficient 0 := by
  simp [completedNativeLogDerivativeTriangularMatrix]

/-- Entries strictly above the diagonal vanish. -/
theorem completedNativeLogDerivativeTriangularMatrix_above_diagonal
    (N : ℕ) {i j : Fin N} (hij : i.val < j.val) :
    completedNativeLogDerivativeTriangularMatrix N i j = 0 := by
  simp [completedNativeLogDerivativeTriangularMatrix, Nat.not_le.mpr hij]

/-- The matrix form of the exact recurrence used by the original Python
`logarithmic_moments` loop. -/
theorem completedNativeLogDerivativeTriangularMatrix_mulVec_moments
    (N : ℕ) :
    (completedNativeLogDerivativeTriangularMatrix N).mulVec
        (completedNativeLogDerivativeMomentVector N) =
      completedNativeLogDerivativeSourceVector N := by
  funext i
  let f : ℕ → ℂ := fun j =>
    if hj : j ≤ i.val then
      completedNativeEvenCharacteristicCoefficient (i.val - j) *
        (canonicalCompletedNativeLogDerivativeMoment j : ℂ)
    else 0
  change (∑ j : Fin N,
      completedNativeLogDerivativeTriangularMatrix N i j *
        completedNativeLogDerivativeMomentVector N j) = _
  rw [Fin.sum_univ_eq_sum_range]
  have hrewrite :
      (∑ j ∈ Finset.range N,
          completedNativeLogDerivativeTriangularMatrix N i
              ⟨j, Finset.mem_range.mp ‹j ∈ Finset.range N›⟩ *
            completedNativeLogDerivativeMomentVector N
              ⟨j, Finset.mem_range.mp ‹j ∈ Finset.range N›⟩) =
        ∑ j ∈ Finset.range N, f j := by
    apply Finset.sum_congr rfl
    intro j hj
    simp [f, completedNativeLogDerivativeTriangularMatrix,
      completedNativeLogDerivativeMomentVector]
  rw [hrewrite]
  have hsubset : Finset.range (i.val + 1) ⊆ Finset.range N := by
    exact Finset.range_mono (by omega)
  have htrim :
      (∑ j ∈ Finset.range (i.val + 1), f j) =
        ∑ j ∈ Finset.range N, f j := by
    apply Finset.sum_subset hsubset
    intro j hjN hjSmall
    have hgt : i.val < j := by
      have hnot : ¬ j < i.val + 1 := by
        simpa only [Finset.mem_range] using hjSmall
      omega
    simp [f, Nat.not_le.mpr hgt]
  rw [← htrim]
  have hprefix :
      (∑ j ∈ Finset.range (i.val + 1), f j) =
        ∑ j ∈ Finset.range (i.val + 1),
          (canonicalCompletedNativeLogDerivativeMoment j : ℂ) *
            completedNativeEvenCharacteristicCoefficient (i.val - j) := by
    apply Finset.sum_congr rfl
    intro j hj
    have hji : j ≤ i.val := by
      exact Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
    simp [f, hji, mul_comm]
  rw [hprefix]
  exact completedNativeLogDerivativeMoment_fullConvolution
    canonicalCompletedNativeLogDerivativeMoment_isMomentSequence i.val

/-- The triangular transport has the expected determinant: one copy of the
nonzero center coefficient on each diagonal entry. -/
theorem completedNativeLogDerivativeTriangularMatrix_det (N : ℕ) :
    (completedNativeLogDerivativeTriangularMatrix N).det =
      ∏ _i : Fin N, completedNativeEvenCharacteristicCoefficient 0 := by
  have ht :
      (completedNativeLogDerivativeTriangularMatrix N).BlockTriangular
        OrderDual.toDual := by
    intro i j hij
    exact completedNativeLogDerivativeTriangularMatrix_above_diagonal N hij
  rw [Matrix.det_of_lowerTriangular _ ht]
  apply Finset.prod_congr rfl
  intro i hi
  exact completedNativeLogDerivativeTriangularMatrix_diagonal N i

/-- Every finite native logarithmic-derivative transport is nonsingular. -/
theorem completedNativeLogDerivativeTriangularMatrix_det_ne_zero (N : ℕ) :
    (completedNativeLogDerivativeTriangularMatrix N).det ≠ 0 := by
  rw [completedNativeLogDerivativeTriangularMatrix_det]
  exact Finset.prod_ne_zero_iff.mpr fun i _ =>
    completedNativeEvenCharacteristicCoefficient_zero_ne_zero

/-- Hence the finite series-division transport is a bijective change of
coordinates.  This is an algebraic statement; no metric preservation is
claimed here. -/
theorem completedNativeLogDerivativeTriangularMatrix_mulVec_bijective
    (N : ℕ) :
    Function.Bijective
      (completedNativeLogDerivativeTriangularMatrix N).mulVec := by
  have hu : IsUnit (completedNativeLogDerivativeTriangularMatrix N) :=
    (Matrix.isUnit_iff_isUnit_det _).mpr
      (isUnit_iff_ne_zero.mpr
        (completedNativeLogDerivativeTriangularMatrix_det_ne_zero N))
  exact ⟨Matrix.mulVec_injective_iff_isUnit.mpr hu,
    Matrix.mulVec_surjective_iff_isUnit.mpr hu⟩

end

end CarrySelfAdjointOperator
