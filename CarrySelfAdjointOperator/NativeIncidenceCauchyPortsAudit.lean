-- Finite canaries 2,4,6 are instances of the SAME source theorem.
example : ∀ᶠ k : ℕ in Filter.atTop,
    MaterialChiralCanary.sourceCoordinatePair 1 k (WithLp.toLp 2 (fun _ => (1 : ℂ))) ≠
      canonicalCompletedNativeRadialProjectiveChiralState k 0 :=
  sourcePair_constant_eventually_ne_seed (by decide)
