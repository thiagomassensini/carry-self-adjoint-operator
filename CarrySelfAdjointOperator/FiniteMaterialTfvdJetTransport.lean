import CarrySelfAdjointOperator.FiniteMaterialCameraGreenTransport

/-! Independent all-order TFVD coefficients are generated by taking material
slopes AFTER clocking native Dirichlet samples, with the existing phase and
factorial. This gradient channel has an l2 limit, unlike the raw critical
nodal state. The seed loss of the gradient map is stated explicitly. -/

noncomputable section
open scoped BigOperators Topology
namespace CarrySelfAdjointOperator.MaterialCameraJets
open CPFormal.Analytic.Cp FiniteClockJets
open NativeCarryC3Crosswalk

/-- Consecutive physical edges; material sample, edge and clock order remain distinct. -/
def finiteMaterialGradient (N : ℕ) :
    FiniteRealSpectralHilbert (N+1) →ₗ[ℂ] FiniteRealSpectralHilbert N where
  toFun x := WithLp.toLp 2 (fun n => x n.succ - x n.castSucc)
  map_add' x y := by ext n; simp; ring
  map_smul' a x := by ext n; simp [mul_sub]

/-- Canonical temporal Taylor slope with its (-i)^r / r! normalization intact. -/
def finiteMaterialTaylorGradient (N r : ℕ) : FiniteRealSpectralHilbert N :=
  ((-Complex.I)^r / (r.factorial : ℂ)) •
    finiteMaterialGradient N (materialJet r (finiteDirichletSamples (N+1) (1/2)))

/-- Equality with the independently defined native slope coefficient at every edge. -/
theorem finiteMaterialTaylorGradient_apply (N r : ℕ) (n : Fin N) :
    finiteMaterialTaylorGradient N r n = nativeDirichletSlopeTaylorCoefficient r n.val := by
  rw [nativeDirichletSlopeTaylorCoefficient_eq_logPowerSlope]
  simp [finiteMaterialTaylorGradient, finiteMaterialGradient,
    materialJet_dirichletSamples_apply, Nat.add_assoc]

/-- Full finite vertical TFVD vector produced by the physical material action. -/
def materialTfvdTaylorPrefix (N r : ℕ) : CarryVerticalL2 :=
  finiteSlopeCoefficientState (fun n : Fin N => finiteMaterialTaylorGradient N r n)

/-- Exact vector crosswalk, before any camera readout, real part or inner product. -/
theorem materialTfvdTaylorPrefix_eq_canonical (N r : ℕ) :
    materialTfvdTaylorPrefix N r =
      canonicalCompletedNativeTfvdTaylorCoefficientNatPrefixState r N := by
  unfold materialTfvdTaylorPrefix canonicalCompletedNativeTfvdTaylorCoefficientNatPrefixState
  congr 1
  funext n
  exact finiteMaterialTaylorGradient_apply N r n

/-- Every fixed order converges in the existing vertical l2 metric. -/
theorem materialTfvdTaylorPrefix_tendsto (r : ℕ) :
    Filter.Tendsto (fun N => materialTfvdTaylorPrefix N r) Filter.atTop
      (nhds (canonicalCompletedNativeTfvdTaylorCoefficientState r)) := by
  simp_rw [materialTfvdTaylorPrefix_eq_canonical]
  exact canonicalCompletedNativeTfvdTaylorCoefficientNatPrefixState_tendsto r

/-- Ordinary and logarithmic channels together, with the canonical order-shift factor. -/
def materialTfvdEnrichedTaylorPrefix (N r : ℕ) :
    CanonicalCompletedNativeTfvdEnrichedTaylorCarrier :=
  WithLp.toLp 2 (materialTfvdTaylorPrefix N r,
    (Complex.I * (r+1 : ℕ)) • materialTfvdTaylorPrefix N (r+1))

/-- Both raw TFVD channels converge simultaneously as one vector. -/
theorem materialTfvdEnrichedTaylorPrefix_tendsto (r : ℕ) :
    Filter.Tendsto (fun N => materialTfvdEnrichedTaylorPrefix N r) Filter.atTop
      (nhds (canonicalCompletedNativeTfvdEnrichedTaylorRawJet r)) := by
  have h := (materialTfvdTaylorPrefix_tendsto r).prodMk_nhds
    ((materialTfvdTaylorPrefix_tendsto (r+1)).const_smul (Complex.I * (r+1 : ℕ)))
  exact ((WithLp.prodContinuousLinearEquiv 2 ℂ CarryVerticalL2 CarryVerticalL2).symm.continuous.tendsto
    (canonicalCompletedNativeTfvdTaylorCoefficientState r,
      (Complex.I * (r+1 : ℕ)) • canonicalCompletedNativeTfvdTaylorCoefficientState (r+1))).comp h

/-- The gradient forgets a real channel: the constant material state is invisible. -/
theorem finiteMaterialGradient_not_injective (N : ℕ) :
    ¬ Function.Injective (finiteMaterialGradient N) := by
  intro h
  let x : FiniteRealSpectralHilbert (N+1) := WithLp.toLp 2 (fun _ => (1 : ℂ))
  have hz : finiteMaterialGradient N x = 0 := by ext n; simp [finiteMaterialGradient, x]
  have he := h (hz.trans (map_zero _).symm)
  have hc := congrArg (fun z : FiniteRealSpectralHilbert (N+1) => z 0) he
  norm_num [x] at hc

/-- The minimal lossless observation retains the physical seed as well as every edge. -/
theorem finiteMaterial_seed_gradient_injective (N : ℕ) :
    Function.Injective (fun x : FiniteRealSpectralHilbert (N+1) =>
      (x 0, finiteMaterialGradient N x)) := by
  intro x y h
  have hs := congrArg Prod.fst h
  have hg := congrArg Prod.snd h
  have hi : ∀ k (hk : k < N+1), x ⟨k,hk⟩ = y ⟨k,hk⟩ := by
    intro k
    induction k with
    | zero => intro hk; exact hs
    | succ k ih =>
      intro hk
      have hkN : k < N := by omega
      have he := congrArg (fun z : FiniteRealSpectralHilbert N => z ⟨k,hkN⟩) hg
      change x ⟨k+1,hk⟩ - x ⟨k,by omega⟩ =
        y ⟨k+1,hk⟩ - y ⟨k,by omega⟩ at he
      rw [ih (by omega)] at he
      exact sub_left_injective he
  ext n
  exact hi n.val n.isLt

end CarrySelfAdjointOperator.MaterialCameraJets
